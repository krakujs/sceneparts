{
  "id": "flat-vector/broom",
  "type": "prop",
  "style": "flat-vector",
  "name": "Broom",
  "summary": "Upright broom with a long wooden handle and a straw head; for cleaning and sweeping scenes.",
  "tags": [
    "broom",
    "sweep",
    "sweeping",
    "cleaning",
    "housework",
    "straw",
    "household"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a flat-vector person at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "straw bristle colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "sweep"
      ],
      "note": "sweep = tilts back and forth from the floor, as if sweeping"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E9D3A9",
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
