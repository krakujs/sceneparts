{
  "id": "flat-vector/harmonica",
  "type": "prop",
  "style": "flat-vector",
  "name": "Harmonica",
  "summary": "Metal-covered harmonica with a row of holes and a coloured comb; a small blues or folk instrument prop.",
  "tags": ["harmonica", "mouth organ", "harp", "blues", "folk", "instrument", "reed"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the bottom edge rests on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; hero size: at s = 1 about 560 px wide and 190 px tall"},
    {"name": "color", "type": "colour", "default": "#E8503F", "note": "plastic comb colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole harmonica"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#E8503F", "anim": "bob"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
