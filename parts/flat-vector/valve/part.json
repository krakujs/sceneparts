{
  "id": "flat-vector/valve",
  "type": "prop",
  "style": "flat-vector",
  "name": "Pipe Valve",
  "summary": "Red handwheel valve on a pipe section; the wheel can spin. For plant, water and industrial scenes.",
  "tags": ["valve", "pipe valve", "wheel valve", "shut off", "pipe", "plumbing", "industrial"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "floor line: the valve base stands on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 430 px wide and 570 px tall (hero size); use about 0.3–0.4 next to a person"},
    {"name": "color", "type": "colour", "default": "#E8503F", "note": "handwheel colour"},
    {"name": "color2", "type": "colour", "default": "#9AA3B5", "note": "pipe and body colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "spin", "bob", "wobble", "pop"], "note": "spin = the handwheel turns"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "anim": "spin"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
