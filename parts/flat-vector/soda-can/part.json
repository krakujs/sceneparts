{
  "id": "flat-vector/soda-can",
  "type": "prop",
  "style": "flat-vector",
  "name": "Soda can",
  "summary": "Plain flat soda can with a colour band and a ring pull, with no lettering; for picnic and drink scenes.",
  "tags": [
    "soda",
    "soda can",
    "can",
    "fizzy drink",
    "drink",
    "tin can",
    "beverage"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "can colour"
    },
    {
      "name": "label",
      "type": "colour",
      "default": "#FFC83D",
      "note": "plain band colour, no text"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E8503F"
  },
  "uses": [
    "flat-vector/drink",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
