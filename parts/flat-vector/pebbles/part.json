{
  "id": "flat-vector/pebbles",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Pebbles",
  "summary": "Low scatter of small smooth stones in varied greys. For beaches, stream beds and garden paths.",
  "tags": [
    "pebbles",
    "stones",
    "pebble",
    "gravel",
    "grey stones",
    "beach",
    "stream bed"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the part stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 540 px wide and 130 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "main stone tone"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#DDE2EA",
      "note": "light stone tone"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop"
      ],
      "note": "pop = grows into place"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
