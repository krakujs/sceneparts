{
  "id": "flat-vector/wood-pile",
  "type": "prop",
  "style": "flat-vector",
  "name": "Wood pile",
  "summary": "Neat stack of firewood with cut ends showing; for winter, cabin, fireplace and woodshed scenes.",
  "tags": ["wood pile", "firewood", "woodpile", "logs", "stack", "winter", "cabin"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the stack stands on y"},
    {"name": "s", "type": "number", "default": 1, "note": "room scale: at s = 1 about 640 px wide and 250 px tall; use about 0.5 next to a person"},
    {"name": "color", "type": "colour", "default": "#E9D3A9", "note": "cut-end wood colour"},
    {"name": "color2", "type": "colour", "default": "#8A5A3C", "note": "bark colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole pile"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
