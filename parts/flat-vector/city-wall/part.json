{
  "id": "flat-vector/city-wall",
  "type": "scenery",
  "style": "flat-vector",
  "name": "City Wall",
  "summary": "Long crenellated stone city wall with two towers and a central gatehouse with a wooden gate. For fortified town scenes.",
  "tags": [
    "city wall",
    "wall",
    "fortification",
    "stone wall",
    "gatehouse",
    "medieval",
    "ramparts"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 1000 px wide and 500 px tall at s = 1 (one wall segment)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "Stone colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "Gate and door colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the arrow-slit windows glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}