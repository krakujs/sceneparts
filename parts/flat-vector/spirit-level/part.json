{
  "id": "flat-vector/spirit-level",
  "type": "prop",
  "style": "flat-vector",
  "name": "Spirit level",
  "summary": "Long spirit level lying on the floor with green bubble vials; for building, DIY and checking flat or straight scenes.",
  "tags": [
    "spirit level",
    "level",
    "bubble level",
    "builder",
    "diy",
    "carpentry",
    "measure"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 480 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#4BB46A",
      "note": "bubble colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "tilt",
        "bubble",
        "pop"
      ],
      "note": "tilt = the level rocks and the bubbles run to the high end; bubble = bubbles drift in place; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "tilt"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
