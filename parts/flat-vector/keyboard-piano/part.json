{
  "id": "flat-vector/keyboard-piano",
  "type": "prop",
  "style": "flat-vector",
  "name": "Keyboard Piano",
  "summary": "Electronic keyboard piano on an X-stand with keys, LCD and knobs; for music practice and band scenes.",
  "tags": [
    "keyboard",
    "keyboard piano",
    "piano",
    "electric piano",
    "music",
    "stand",
    "keys"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the stand feet rest on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 600 px wide and 360 px tall (room-sized prop)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3A4157",
      "note": "chassis colour"
    },
    {
      "name": "accent",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "front panel trim colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "play"
      ],
      "note": "play = keys light up in turn and knobs turn"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#3A4157",
    "accent": "#FF8A3D",
    "anim": "play"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
