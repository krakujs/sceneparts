{
  "id": "flat-vector/deer",
  "type": "character",
  "style": "flat-vector",
  "name": "Deer",
  "summary": "Flat vector red-brown deer with antlers and a pale belly; for forest and woodland scenes.",
  "tags": [
    "deer",
    "stag",
    "animal",
    "forest",
    "woodland",
    "antlers",
    "wildlife"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "idle",
        "sit",
        "lie",
        "graze"
      ],
      "note": "idle = breathing + tail wag; graze = head down"
    },
    {
      "name": "mouth",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "smile",
        "open",
        "tongue"
      ]
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#A8643A",
      "note": "coat colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand"
  },
  "uses": [
    "flat-vector/quadruped",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
