{
  "id": "flat-vector/pyramid",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Pyramid",
  "summary": "Stone pyramid with block courses on a sandy base, a generic desert monument; anim lights moves a sun glint across it.",
  "tags": [
    "pyramid",
    "desert",
    "stone",
    "monument",
    "sand",
    "ancient",
    "tomb"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the sandy base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 960 px wide and 640 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "stone colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#E0A21F",
      "note": "sandy base colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = a sun glint slides across the faces"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}