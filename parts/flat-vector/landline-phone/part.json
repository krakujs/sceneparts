{
  "id": "flat-vector/landline-phone",
  "type": "prop",
  "style": "flat-vector",
  "name": "Landline phone",
  "summary": "Push-button desk phone with a corded handset; anim ring shakes it with ring lines. For office scenes.",
  "tags": [
    "landline",
    "landline phone",
    "desk phone",
    "telephone",
    "corded phone",
    "office phone",
    "phone"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the base rests on y (set to a desk top in a scene)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size: at s = 1 the phone is about 540 px wide and 220 px tall"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#5D6578",
      "note": "base colour"
    },
    {
      "name": "handset",
      "type": "colour",
      "default": "#3A4157",
      "note": "handset colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "ring"
      ],
      "note": "ring = the phone shakes with ring lines on both sides"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (cord moves to the right)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 0.8,
    "color": "#5D6578",
    "handset": "#3A4157",
    "anim": "ring"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
