{
  "id": "flat-vector/toilet",
  "type": "prop",
  "style": "flat-vector",
  "name": "Toilet",
  "summary": "Side-on toilet with a tall cistern and the seat lid standing up; for bathroom and plumbing scenes.",
  "tags": [
    "toilet",
    "loo",
    "wc",
    "lavatory",
    "bathroom",
    "cistern",
    "flush"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a flat-vector person at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "toilet colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "flush"
      ],
      "note": "flush = the water in the bowl swirls"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFFFFF"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
