{
  "id": "flat-vector/soap",
  "type": "prop",
  "style": "flat-vector",
  "name": "Soap",
  "summary": "Bar of soap on a white dish with bubbles; for handwashing and bath scenes.",
  "tags": [
    "soap",
    "bar of soap",
    "soap bar",
    "bubbles",
    "handwashing",
    "bathroom",
    "washing"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#A8D85A",
      "note": "bar colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "bubbles"
      ],
      "note": "bubbles = suds rise and fade above the bar"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#A8D85A"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
