{
  "id": "flat-vector/router",
  "type": "prop",
  "style": "flat-vector",
  "name": "Router",
  "summary": "Wifi router box with two antennas, vent slots and a row of status LEDs; anim blink flickers the LEDs.",
  "tags": [
    "router",
    "wifi router",
    "wifi",
    "internet",
    "modem",
    "network",
    "home network"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "bottom centre: the router stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the router is about 460 px wide and 400 px tall with antennas"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#DDE2EA",
      "note": "case colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "blink"
      ],
      "note": "blink = the status LEDs flicker at different rates"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "color": "#DDE2EA",
    "anim": "blink"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
