{
  "id": "flat-vector/blind-person-with-cane",
  "type": "character",
  "style": "flat-vector",
  "name": "Blind person with white cane",
  "summary": "Flat vector adult in sunglasses walking with a long white cane with a red tip; for visual impairment and accessibility.",
  "tags": [
    "blind",
    "visually impaired",
    "white cane",
    "accessibility",
    "sunglasses",
    "walking",
    "disability"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "neutral",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "dark",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "short",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "black",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "top",
      "type": "enum",
      "default": "tshirt",
      "values": [
        "tshirt",
        "shirt",
        "blazer",
        "coat",
        "hoodie",
        "sweater",
        "dress",
        "scrubs",
        "tank",
        "uniform",
        "jumpsuit"
      ]
    },
    {
      "name": "topColor",
      "type": "colour",
      "default": "#3D6FE0"
    },
    {
      "name": "shirtColor",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "shirt under a blazer or coat"
    },
    {
      "name": "bottom",
      "type": "enum",
      "default": "trousers",
      "values": [
        "trousers",
        "shorts",
        "skirt",
        "overalls"
      ]
    },
    {
      "name": "bottomColor",
      "type": "colour",
      "default": "#253058"
    },
    {
      "name": "shoes",
      "type": "enum",
      "default": "shoes",
      "values": [
        "shoes",
        "sneakers",
        "boots",
        "heels",
        "sandals"
      ]
    },
    {
      "name": "shoesColor",
      "type": "colour",
      "default": "#1F2433"
    },
    {
      "name": "hat",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "cap",
        "beanie",
        "hardhat",
        "chef",
        "beret",
        "brim",
        "fedora",
        "peaked",
        "helmet",
        "headscarf",
        "turban",
        "mortarboard",
        "bandana",
        "tophat",
        "scrubcap",
        "skullcap",
        "sailor"
      ]
    },
    {
      "name": "hatColor",
      "type": "colour",
      "default": "#E8503F",
      "note": "also colours goggles and headphones"
    },
    {
      "name": "extra",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "tie",
        "bowtie",
        "apron",
        "hivis",
        "lanyard",
        "stethoscope",
        "scarf",
        "badge",
        "backpack",
        "toolbelt",
        "sash"
      ]
    },
    {
      "name": "extraColor",
      "type": "colour",
      "default": "#E8503F"
    },
    {
      "name": "propColor",
      "type": "colour",
      "default": "#FF8A3D"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "skin": "dark"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
