    {"name": "color2", "type": "colour", "default": "#5D6578", "note": "hoop colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole barrel"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
