{
  "id": "flat-vector/post-office",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Post office",
  "summary": "Post office with an envelope icon sign and a red post box out front; anim lights glows the windows.",
  "tags": [
    "post",
    "post-office",
    "mail",
    "letters",
    "postbox",
    "envelope",
    "building",
    "town"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 820 px wide and 1060 px tall at s = 1 (post box to the right)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F7F1E3",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFC83D",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim lights = windows glow in turn"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
