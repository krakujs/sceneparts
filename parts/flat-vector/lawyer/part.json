{
  "id": "flat-vector/lawyer",
  "type": "character",
  "style": "flat-vector",
  "name": "Lawyer",
  "summary": "Flat vector lawyer in a dark suit and tie carrying a briefcase; for legal, contract and business explainers.",
  "tags": ["lawyer", "attorney", "legal", "law", "suit", "briefcase", "business", "person"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1560, "note": "feet" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~1000 px tall at 1" },
    { "name": "pose", "type": "enum", "default": "walk", "values": ["stand", "walk", "run", "wave", "point", "think", "cheer", "talk", "sit", "hold"] },
    { "name": "expression", "type": "enum", "default": "neutral", "values": ["smile", "neutral", "open", "surprised", "sad", "angry", "laugh"] },
    { "name": "skin", "type": "string", "default": "medium", "note": "light | fair | tan | medium | brown | dark, or a hex colour" },
    { "name": "hair", "type": "enum", "default": "side", "values": ["short", "buzz", "side", "spiky", "curly", "afro", "long", "ponytail", "bun", "bob", "braid", "none"] },
    { "name": "hairColor", "type": "string", "default": "black", "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex" },
    { "name": "accessory", "type": "enum", "default": "none", "values": ["none", "glasses", "sunglasses", "goggles", "mask", "beard", "moustache", "stubble", "headset", "headphones", "earrings"] },
    { "name": "seat", "type": "boolean", "default": true, "note": "draw a bench when pose is sit" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1560, "pose": "walk", "skin": "medium", "hair": "side", "hairColor": "black" },
  "uses": ["flat-vector/person", "flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
