{
  "id": "flat-vector/floppy-disk",
  "type": "prop",
  "style": "flat-vector",
  "name": "Floppy Disk",
  "summary": "3.5-inch floppy diskette with a metal shutter and a blank label; use for old computers, saving files or retro tech.",
  "tags": ["floppy disk", "floppy", "diskette", "save icon", "retro computer", "storage"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the disk's bottom edge rests on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; hero size, about 400 px wide at s = 1; about 0.3 in a hand"},
    {"name": "color", "type": "colour", "default": "#3D6FE0", "note": "disk colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion only"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#3D6FE0"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
