{
  "id": "flat-vector/virus",
  "type": "effect",
  "style": "flat-vector",
  "name": "Virus",
  "summary": "Round virus particle with clubbed crown spikes, green and purple; anim float or spin. For germ and illness explainers.",
  "tags": ["virus", "germ", "infection", "microbe", "illness", "covid", "science"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 900, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 460 px across" },
    { "name": "color", "type": "colour", "default": "#4BB46A", "note": "body colour" },
    { "name": "color2", "type": "colour", "default": "#7B5CD6", "note": "spike colour" },
    { "name": "anim", "type": "enum", "default": "none", "values": ["none", "float", "spin"], "note": "float = bobs up and down; spin = turns slowly" }
  ],
  "example": { "x": 540, "y": 900, "s": 1, "color": "#4BB46A", "color2": "#7B5CD6", "anim": "spin" },
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
