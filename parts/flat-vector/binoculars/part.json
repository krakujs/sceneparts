{
  "id": "flat-vector/binoculars",
  "type": "prop",
  "style": "flat-vector",
  "name": "Binoculars",
  "summary": "Pair of binoculars with a neck strap and focus wheel, shown at hero scale; for hiking, birdwatching and travel scenes.",
  "tags": ["binoculars", "birdwatching", "bird watching", "hiking", "outdoor", "optics", "travel"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom edge: the barrels stand on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 340 px wide and 470 px tall (hero size)"},
    {"name": "color", "type": "colour", "default": "#4A5268", "note": "barrel colour"},
    {"name": "accent", "type": "colour", "default": "#FFC83D", "note": "focus wheel colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop", "focus"], "note": "focus = the focus wheel turns"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#4A5268", "accent": "#FFC83D", "anim": "focus"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
