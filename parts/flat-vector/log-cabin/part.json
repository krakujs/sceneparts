{
  "id": "flat-vector/log-cabin",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Log Cabin",
  "summary": "Log cabin with stacked logs, a stone chimney and a covered porch. For forest, winter and countryside scenes.",
  "tags": [
    "log cabin",
    "cabin",
    "log house",
    "chimney",
    "forest",
    "countryside",
    "porch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 820 px wide and 850 px tall at s = 1 (chimney included)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "Log colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#5D6578",
      "note": "Roof colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the cabin windows glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}