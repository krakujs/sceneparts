{
  "id": "flat-vector/recycling-bin",
  "type": "prop",
  "style": "flat-vector",
  "name": "Recycling Bin",
  "summary": "Wheeled green recycling bin with a generic recycling-arrows symbol; for street and recycling scenes.",
  "tags": [
    "recycling bin",
    "recycling",
    "wheelie bin",
    "bin",
    "green bin",
    "waste",
    "rubbish"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a flat-vector person at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4BB46A",
      "note": "bin colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "tilt"
      ],
      "note": "tilt = rocks the bin slightly, as if being wheeled"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#4BB46A"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
