{
  "id": "flat-vector/teapot",
  "type": "prop",
  "style": "flat-vector",
  "name": "Teapot",
  "summary": "Flat round-bellied teapot with spout, handle, lid knob and steam from the spout; for tea and kitchen scenes.",
  "tags": [
    "teapot",
    "tea",
    "pot",
    "kitchen",
    "drink",
    "steam",
    "tea pot"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "pot colour"
    },
    {
      "name": "steam",
      "type": "boolean",
      "default": true,
      "note": "steam rising from the spout"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#1FA39A",
    "steam": true
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
