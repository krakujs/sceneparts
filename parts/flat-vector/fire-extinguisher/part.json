{
  "id": "flat-vector/fire-extinguisher",
  "type": "prop",
  "style": "flat-vector",
  "name": "Fire Extinguisher",
  "summary": "Red fire extinguisher with a hose, gauge and top handle; anim can spray. For safety and emergency scenes.",
  "tags": [
    "fire extinguisher",
    "extinguisher",
    "fire",
    "safety",
    "emergency",
    "spray",
    "red cylinder"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "cylinder colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "spray"
      ],
      "note": "spray = a jet of spray comes out of the nozzle"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E8503F"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
