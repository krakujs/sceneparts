{
  "id": "flat-vector/surfboard",
  "type": "prop",
  "style": "flat-vector",
  "name": "Surfboard",
  "summary": "Long pointed surfboard standing upright on its tail with a centre stripe and fin; use for beach and surf scenes.",
  "tags": ["surfboard", "surf", "surfing", "beach", "board", "ocean", "prop"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the tail rests on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; hero size: at s = 1 about 260 px wide and 760 px tall"},
    {"name": "color", "type": "colour", "default": "#2FB8C9", "note": "board colour"},
    {"name": "color2", "type": "colour", "default": "#FFFFFF", "note": "centre stripe colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "bob = rocks gently like it is on water"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror the board"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#2FB8C9", "color2": "#FFFFFF", "anim": "bob"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
