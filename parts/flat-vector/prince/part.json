{
  "id": "flat-vector/prince",
  "type": "character",
  "style": "flat-vector",
  "name": "Prince",
  "summary": "Flat vector young prince in a blue tunic, short red cape and small gold crown; for royal and fairy tale stories.",
  "tags": [
    "prince",
    "royal",
    "crown",
    "cape",
    "kingdom",
    "boy",
    "fairy tale",
    "child"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "wave",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "light",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "wave",
    "expression": "smile",
    "skin": "light"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
