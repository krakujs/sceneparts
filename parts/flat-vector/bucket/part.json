{
  "id": "flat-vector/bucket",
  "type": "prop",
  "style": "flat-vector",
  "name": "Bucket",
  "summary": "Plastic bucket with a wire handle and water inside; for cleaning, washing and garden scenes.",
  "tags": [
    "bucket",
    "pail",
    "water bucket",
    "cleaning",
    "washing",
    "plastic",
    "mop bucket"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "bucket colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "slosh"
      ],
      "note": "slosh = the water surface moves side to side"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#3D6FE0"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
