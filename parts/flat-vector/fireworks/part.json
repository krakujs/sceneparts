{
  "id": "flat-vector/fireworks",
  "type": "effect",
  "style": "flat-vector",
  "name": "Fireworks",
  "summary": "Three colourful firework bursts of radiating spark trails centred on x,y; use for night celebrations and New Year.",
  "tags": [
    "fireworks",
    "firework",
    "burst",
    "celebration",
    "new year",
    "sparks",
    "night sky"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y of the bursts"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 600 px wide and 560 px tall"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "first burst colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFC83D",
      "note": "second burst colour"
    },
    {
      "name": "color3",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "third burst colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "burst"
      ],
      "note": "burst = the bursts expand and fade, looping every 2 seconds, staggered"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "s": 1,
    "anim": "burst"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
