{
  "id": "flat-vector/candy-cane",
  "type": "prop",
  "style": "flat-vector",
  "name": "Candy cane",
  "summary": "Red-and-white striped candy cane with a hooked top, standing on its end; use for Christmas treats and decorations.",
  "tags": [
    "candy cane",
    "christmas candy",
    "peppermint",
    "stripes",
    "xmas",
    "sweet",
    "treat"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom of the stick sits on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 350 px wide and 560 px tall; use about 0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "stripe colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sway",
        "pop"
      ],
      "note": "sway = the cane rocks gently; pop = springs in once"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "sway"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
