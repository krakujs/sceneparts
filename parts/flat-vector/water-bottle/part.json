{
  "id": "flat-vector/water-bottle",
  "type": "prop",
  "style": "flat-vector",
  "name": "Water bottle",
  "summary": "Clear blue-tinted plastic water bottle with ridges, a blue cap and a plain label band; for gym and hydration scenes.",
  "tags": [
    "water bottle",
    "bottle",
    "plastic bottle",
    "water",
    "drink",
    "hydration",
    "gym"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#DDF1FA",
      "note": "bottle tint"
    },
    {
      "name": "lid",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "cap colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "lid": "#3D6FE0"
  },
  "uses": [
    "flat-vector/drink",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
