{
  "id": "flat-vector/first-aid-kit",
  "type": "prop",
  "style": "flat-vector",
  "name": "First Aid Kit",
  "summary": "First aid box with a carry handle and a white cross on a green panel. For health and safety scenes.",
  "tags": [
    "first aid",
    "first aid kit",
    "medical kit",
    "health",
    "safety",
    "injury",
    "medicine box"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "box colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#4BB46A",
      "note": "panel colour behind the cross"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "pulse"
      ],
      "note": "pulse = the cross gently grows and shrinks"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFFFFF",
    "color2": "#4BB46A"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
