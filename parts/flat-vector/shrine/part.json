{
  "id": "flat-vector/shrine",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Roadside Shrine",
  "summary": "Small roadside shrine with a tiled roof, a hanging lantern and a row of flowers. Good for quiet street or path scenes.",
  "tags": ["shrine", "roadside shrine", "small temple", "lantern", "flowers", "street", "path"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1600, "note": "floor line: the base stands on y"},
    {"name": "s", "type": "number", "default": 1, "note": "about 380 px wide and 370 px tall at s = 1 (street scale, about 0.5 of a person)"},
    {"name": "color", "type": "colour", "default": "#F4F1EA", "note": "wall colour"},
    {"name": "color2", "type": "colour", "default": "#5D6578", "note": "tiled roof colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "lights"], "note": "lights = the lantern flame flickers"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1600, "s": 1, "anim": "lights"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
