{
  "id": "flat-vector/python",
  "type": "character",
  "style": "flat-vector",
  "name": "Python",
  "summary": "Flat vector long thick brown-and-tan python with diamond blotches that slithers along the ground.",
  "tags": [
    "python",
    "snake",
    "serpent",
    "reptile",
    "pattern",
    "slither",
    "animal"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "ground under the body"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "slither",
      "values": [
        "stand",
        "walk",
        "slither",
        "idle",
        "raised"
      ],
      "note": "walk = legs swing; slither = wave travels; idle = breathing, blink, tongue; raised = head up"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#B08352",
      "note": "main colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "slither"
  },
  "uses": [
    "flat-vector/reptile",
    "flat-vector/style"
  ],
