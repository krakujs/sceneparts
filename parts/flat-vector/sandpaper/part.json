{
  "id": "flat-vector/sandpaper",
  "type": "prop",
  "style": "flat-vector",
  "name": "Sandpaper",
  "summary": "Sanding block resting on a sheet of sandpaper with grit dots; for sanding, painting prep and woodwork scenes.",
  "tags": [
    "sandpaper",
    "sanding block",
    "sander",
    "grit",
    "woodwork",
    "diy",
    "sanding"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 430 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "block colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "paper colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sand",
        "bob",
        "pop"
      ],
      "note": "sand = the block slides back and forth over the paper; bob = gentle lift; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "sand"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
