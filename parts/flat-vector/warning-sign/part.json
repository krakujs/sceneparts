{
  "id": "flat-vector/warning-sign",
  "type": "effect",
  "style": "flat-vector",
  "name": "Warning Sign",
  "summary": "Yellow rounded triangle with a dark exclamation mark: use for caution, danger or risk.",
  "tags": [
    "warning",
    "caution",
    "danger",
    "alert",
    "triangle",
    "risk",
    "sign"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 500 px wide at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "sign colour; a darker edge is added"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "wobble",
      "values": [
        "none",
        "wobble",
        "pulse"
      ],
      "note": "wobble = gentle rock, pulse = slight breathing"
    },
    {
      "name": "popIn",
      "type": "boolean",
      "default": true,
      "note": "springs in over the first 10 frames"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "anim": "wobble"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
