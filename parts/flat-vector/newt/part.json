{
  "id": "flat-vector/newt",
  "type": "character",
  "style": "flat-vector",
  "name": "Newt",
  "summary": "Flat vector small dark-olive newt with an orange belly, orange spots and a long finned tail; for pond scenes.",
  "tags": [
    "newt",
    "salamander",
    "amphibian",
    "pond",
    "orange",
    "spotted",
    "animal"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "ground under the body"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "slither",
        "idle",
        "raised"
      ],
      "note": "walk = legs swing; slither = wave travels; idle = breathing, blink, tongue; raised = head up"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4D5B2C",
      "note": "main colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand"
  },
  "uses": [
    "flat-vector/reptile",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
