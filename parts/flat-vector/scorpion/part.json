{
  "id": "flat-vector/scorpion",
  "type": "character",
  "style": "flat-vector",
  "name": "Scorpion",
  "summary": "Scorpion: friendly sand-brown scorpion with two pincers and a curled tail; for desert scenes, not scary.",
  "tags": [
    "scorpion",
    "desert",
    "arachnid",
    "sand",
    "pincers",
    "crawling"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet / bottom centre"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 300 px long at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#C8985E",
      "note": "body colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560
  },
  "uses": [
    "flat-vector/style"
  ],
