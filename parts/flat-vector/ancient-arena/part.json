{
  "id": "flat-vector/ancient-arena",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Ancient Arena",
  "summary": "Oval multi-tier stone arena with rows of arches and a broken top; for Roman-era and ancient games scenes.",
  "tags": [
    "arena",
    "colosseum",
    "amphitheatre",
    "ancient",
    "stone ruins",
    "arches",
    "roman"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 960 px wide and 510 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "Stone colour of the tiers"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "Cornice colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the torches in the lower arches light up one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}