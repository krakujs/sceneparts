{
  "id": "flat-vector/theater",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Theater",
  "summary": "Theatre facade with a lit marquee and a drama-mask icon; anim lights chases the marquee bulbs.",
  "tags": [
    "theater",
    "theatre",
    "stage",
    "drama",
    "marquee",
    "mask",
    "show",
    "building"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 880 px wide and 960 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F6E9EE",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#7B5CD6",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim lights = marquee bulbs chase on one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
