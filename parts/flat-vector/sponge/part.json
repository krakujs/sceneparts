{
  "id": "flat-vector/sponge",
  "type": "prop",
  "style": "flat-vector",
  "name": "Sponge",
  "summary": "Yellow kitchen sponge with a green scrub pad and suds; for washing-up and cleaning scenes.",
  "tags": [
    "sponge",
    "kitchen sponge",
    "washing up",
    "scrub",
    "cleaning",
    "suds",
    "kitchen"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "sponge colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#4BB46A",
      "note": "scrub pad colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "squish",
        "bubbles"
      ],
      "note": "squish = gently squashed; bubbles = suds rise and fade"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFC83D",
    "color2": "#4BB46A"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
