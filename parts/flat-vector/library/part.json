{
  "id": "flat-vector/library",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Library",
  "summary": "Columned library with wide windows and an open-book icon above the door; anim lights glows the windows.",
  "tags": [
    "library",
    "books",
    "reading",
    "books-building",
    "columns",
    "education",
    "building",
    "town"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 840 px wide and 1020 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#EFE9DC",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim lights = the two wide windows glow in turn"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
