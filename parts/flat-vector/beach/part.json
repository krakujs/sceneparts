{
  "id": "flat-vector/beach",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Beach",
  "summary": "Beach vignette: a sand strip, a sea band with a foamy wave edge and shells. anim flow moves the edge.",
  "tags": [
    "beach",
    "sea",
    "sand",
    "waves",
    "shells",
    "seaside",
    "shore"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the part stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 1000 px wide and 420 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4AA3D9",
      "note": "sea colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "sand colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "flow"
      ],
      "note": "flow = the water or ice moves"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "flow"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
