{
  "id": "flat-vector/sweater",
  "type": "prop",
  "style": "flat-vector",
  "name": "Sweater",
  "summary": "Knitted crew-neck sweater with ribbed cuffs and hem on a wooden hanger; sways. For fashion and wardrobe scenes.",
  "tags": [
    "sweater",
    "jumper",
    "knitwear",
    "pullover",
    "knit sweater",
    "jersey",
    "wool sweater",
    "clothes",
    "wardrobe"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom: the item rests on y (hem or tip)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 560 px wide and 690 px tall at s = 1 (hook included)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "knit colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "rib and trim colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sway"
      ],
      "note": "sway = the garment swings gently from the hook"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E8503F",
    "color2": "#FFFFFF",
    "anim": "sway"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
