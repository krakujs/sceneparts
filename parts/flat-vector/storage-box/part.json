{
  "id": "flat-vector/storage-box",
  "type": "prop",
  "style": "flat-vector",
  "name": "Storage Box",
  "summary": "Plain cardboard moving or storage box, closed or with the top flaps open; for moving-house and storage scenes.",
  "tags": [
    "cardboard box",
    "moving box",
    "storage box",
    "box",
    "packing",
    "moving house",
    "cardboard"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "variant",
      "type": "enum",
      "default": "closed",
      "values": [
        "closed",
        "open"
      ],
      "note": "closed = flaps shut and taped; open = top flaps raised, showing the inside"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#D9A66B",
      "note": "cardboard colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "variant": "closed",
    "color": "#D9A66B"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
