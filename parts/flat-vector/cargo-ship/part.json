{
  "id": "flat-vector/cargo-ship",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Cargo Ship",
  "summary": "Container ship with stacked colourful containers and a bridge tower at the back; for port and trade scenes.",
  "tags": [
    "cargo ship",
    "container ship",
    "freighter",
    "ship",
    "containers",
    "port",
    "trade",
    "shipping"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x at frame 0"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "waterline: the hull floats with its waterline on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "room scale: about 800 px wide and 430 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "bridge tower colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#253058",
      "note": "hull colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "drive",
        "bob",
        "pop"
      ],
      "note": "drive = the boat rocks on the waves and its oar, paddle, wake or propeller moves"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "horizontal speed in px per frame (negative = left; set flip too)"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror so it faces left"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 0.95,
    "anim": "drive"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
