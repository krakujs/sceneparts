{
  "id": "flat-vector/rowboat",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Rowboat",
  "summary": "Small wooden rowboat with two oars that row in anim drive; for lake, river and pond scenes.",
  "tags": [
    "rowboat",
    "row boat",
    "boat",
    "oars",
    "rowing",
    "lake",
    "river",
    "wooden boat"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x at frame 0"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "waterline: the hull floats with its waterline on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "room scale: about 560 px wide and 200 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "hull colour (wood)"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "oars and seats"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "drive",
        "bob",
        "pop"
      ],
      "note": "drive = the boat rocks on the waves and its oar, paddle, wake or propeller moves"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "horizontal speed in px per frame (negative = left; set flip too)"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror so it faces left"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "drive"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
