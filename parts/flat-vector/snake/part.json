{
  "id": "flat-vector/snake",
  "type": "character",
  "style": "flat-vector",
  "name": "Snake",
  "summary": "Flat vector green S-curved snake with a lighter belly and a flicking forked tongue; friendly, no legs.",
  "tags": ["snake","serpent","reptile","green","slither","tongue","animal"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1560, "note": "ground under the body" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "pose", "type": "enum", "default": "idle", "values": ["stand", "walk", "slither", "idle", "raised"], "note": "walk = legs swing; slither = wave travels; idle = breathing, blink, tongue; raised = head up" },
    { "name": "color", "type": "colour", "default": "#4FA66B", "note": "main colour" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1560, "pose": "idle" },
  "uses": [
    "flat-vector/reptile",
    "flat-vector/style"
  ],
