{
  "id": "flat-vector/countryside",
  "type": "background",
  "style": "flat-vector",
  "name": "Countryside",
  "summary": "Full-frame flat countryside background: rolling hills, patchwork fields, hedgerows, farmhouse, fence and dirt path.",
  "tags": ["countryside", "rural", "hills", "fields", "farm", "landscape", "background", "outdoor"],
  "params": [
    { "name": "time", "type": "enum", "default": "day", "values": ["day", "morning", "dusk", "night"], "note": "sky and landscape light" },
    { "name": "weather", "type": "enum", "default": "clear", "values": ["clear", "cloudy", "rain", "snow", "fog", "storm"], "note": "sky tint and animated weather" },
    { "name": "grass", "type": "colour", "default": "#4BB46A", "note": "grass colour of the near field" },
    { "name": "seed", "type": "number", "default": 3, "note": "varies hill shape, clouds and tree placement" },
    { "name": "anim", "type": "enum", "default": "drift", "values": ["drift", "none"], "note": "drift = clouds and trees move from p.f" }
  ],
  "example": { "time": "day", "weather": "clear", "grass": "#4BB46A", "seed": 3 },
  "uses": ["flat-vector/style", "flat-vector/backdrop"],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
