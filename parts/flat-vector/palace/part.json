{
  "id": "flat-vector/palace",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Palace",
  "summary": "Grand symmetrical palace with a central dome, wings, columns and steps. For royal and capital city scenes.",
  "tags": ["palace", "grand building", "dome", "columns", "royal", "mansion", "capital"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
