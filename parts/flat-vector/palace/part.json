    {"name": "color", "type": "colour", "default": "#F4F1EA", "note": "stone wall colour"},
    {"name": "color2", "type": "colour", "default": "#3D6FE0", "note": "dome and roof accent colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "pop", "lights"], "note": "lights = the windows glow one after another"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1600, "s": 1, "anim": "lights"},
