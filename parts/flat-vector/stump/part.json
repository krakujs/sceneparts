{
  "id": "flat-vector/stump",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Tree stump",
  "summary": "Cut tree stump with growth rings on its pale top and roots at the base; for clearings and woodland scenes.",
  "tags": [
    "tree stump",
    "stump",
    "cut tree",
    "growth rings",
    "logging",
    "forest floor",
    "woodland"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the stump and roots sit on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 420 px wide and 330 px tall at s = 1; use about 0.5 for a small stump"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "pale cut-top wood colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "bark colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop"
      ],
      "note": "pop = grows in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
