{
  "id": "flat-vector/crate",
  "type": "prop",
  "style": "flat-vector",
  "name": "Wooden crate",
  "summary": "Slatted wooden shipping crate with metal corner brackets; for warehouse, dock, cargo and storage scenes.",
  "tags": ["crate", "wooden crate", "box", "shipping", "cargo", "warehouse", "storage"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the crate stands on y"},
    {"name": "s", "type": "number", "default": 1, "note": "room scale: at s = 1 about 660 px wide and 600 px tall; use about 0.4 next to a person"},
    {"name": "color", "type": "colour", "default": "#E9D3A9", "note": "wood colour"},
    {"name": "color2", "type": "colour", "default": "#8A5A3C", "note": "cross-batten colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole crate"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
