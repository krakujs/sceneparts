{
  "id": "flat-vector/nails",
  "type": "prop",
  "style": "flat-vector",
  "name": "Nails",
  "summary": "Small loose pile of steel nails drawn large, flat-headed and pointed; for building, hardware and DIY scenes.",
  "tags": [
    "nails",
    "nail",
    "hardware",
    "pile of nails",
    "building",
    "diy",
    "carpentry"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 440 px across at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "steel colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "pop"
      ],
      "note": "pop = the nails drop in one after another; bob = gentle lift"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
