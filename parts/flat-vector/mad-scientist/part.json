{
  "id": "flat-vector/mad-scientist",
  "type": "character",
  "style": "flat-vector",
  "name": "Mad scientist",
  "summary": "Flat vector mad scientist in a lab coat with wild purple hair and a bubbling flask; for lab stories.",
  "tags": [
    "scientist",
    "mad",
    "lab",
    "flask",
    "experiment",
    "chemistry",
    "wild hair",
    "goggles"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "age",
      "type": "enum",
      "default": "adult",
      "values": [
        "adult",
        "teen",
        "child",
        "toddler",
        "elder"
      ],
      "note": "teen/child/toddler: smaller with a bigger head; elder: slight stoop"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "fair",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand",
    "skin": "fair"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
