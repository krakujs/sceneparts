{
  "id": "flat-vector/sparkler",
  "type": "prop",
  "style": "flat-vector",
  "name": "Sparkler",
  "summary": "Hand-held style sparkler: a thin stick with a star-burst of sparks at its tip; use for celebrations and night scenes.",
  "tags": [
    "sparkler",
    "sparklers",
    "sparks",
    "celebration",
    "firework",
    "night",
    "sparkle"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom of the stick sits on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 300 px wide and 580 px tall; use about 0.5 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "spark colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "flicker"
      ],
      "note": "flicker = the rays pulse in length and tiny sparks fall from the tip"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "flicker"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
