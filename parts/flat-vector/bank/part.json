{
  "id": "flat-vector/bank",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Bank",
  "summary": "Classical bank with columns, a pediment and a gold coin icon; anim pop scales it in.",
  "tags": [
    "bank",
    "money",
    "finance",
    "coin",
    "columns",
    "pediment",
    "building",
    "city"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 880 px wide and 800 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F2EADB",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#2A50AE",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim is pop only (no window glow): the bank scales in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "example": {
      "x": 540,
      "y": 1600,
      "s": 1,
      "anim": "pop"
    }
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
