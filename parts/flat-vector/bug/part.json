{
  "id": "flat-vector/bug",
  "type": "character",
  "style": "flat-vector",
  "name": "Flat bug",
  "summary": "Flat bug generator: bees, butterflies, ladybugs, spiders, ants, flies, moths; side or top view; crawl, fly or hover.",
  "tags": ["insect", "bug", "bee", "butterfly", "spider", "ladybug", "generator"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1560, "note": "feet / bottom centre" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; sizes below are px at s = 1 (bee ~220 px long)" },
    { "name": "pose", "type": "enum", "default": "stand", "values": ["stand", "crawl", "fly", "hover", "idle"], "note": "crawl = legs alternate from f; fly = wings beat fast, body lifted alt; hover = fly in place with a small bob" },
    { "name": "view", "type": "enum", "default": "side", "values": ["side", "top"], "note": "top = seen from above, lying on the ground (butterflies, ladybugs, spiders)" },
    { "name": "alt", "type": "number", "default": 140, "note": "px the body is lifted when flying (hover uses 30%)" },
    { "name": "head", "type": "number", "default": 28, "note": "head radius" },
    { "name": "thorax", "type": "number", "default": 42, "note": "thorax size" },
    { "name": "abdomen", "type": "number", "default": 100, "note": "abdomen length (round: diameter)" },
    { "name": "abdomenH", "type": "number", "note": "abdomen half-height (default 0.9 x thorax)" },
    { "name": "abdomenShape", "type": "enum", "default": "oval", "values": ["oval", "round", "long", "pointed"], "note": "long = thin (dragonfly, mosquito); pointed = wasp" },
    { "name": "waist", "type": "boolean", "default": false, "note": "thin waist between thorax and abdomen (ant, wasp)" },
    { "name": "legs", "type": "number", "default": 6, "note": "6 or 8" },
    { "name": "legLen", "type": "number", "default": 46, "note": "visible leg length px" },
    { "name": "legW", "type": "number", "default": 9, "note": "leg thickness" },
    { "name": "legColor", "type": "colour", "default": "#1F2433" },
    { "name": "color", "type": "colour", "default": "#FFC83D", "note": "main colour (abdomen)" },
    { "name": "color2", "type": "colour", "default": "#1F2433", "note": "second colour: stripes, spots, dark parts" },
    { "name": "thoraxColor", "type": "colour", "note": "default = color" },
    { "name": "headColor", "type": "colour", "note": "default = color" },
    { "name": "pattern", "type": "enum", "default": "none", "values": ["none", "stripes", "spots", "dots-edge"], "note": "on the abdomen" },
    { "name": "patternColor", "type": "colour", "default": "#1F2433" },
    { "name": "wings", "type": "enum", "default": "none", "values": ["none", "clear", "long", "butterfly", "moth", "shell", "grasshopper"], "note": "clear = bee/fly; long = dragonfly; shell = ladybug elytra (opens to fly); grasshopper = folded along the back" },
    { "name": "wingSpan", "type": "number", "default": 150, "note": "wing length px (butterfly: ~150 gives a ~300 px span)" },
    { "name": "wingColor", "type": "colour", "default": "#E6F6FF", "note": "clear wings are white with a light-blue tint" },
    { "name": "wingColor2", "type": "colour", "default": "#1F2433", "note": "butterfly border colour" },
    { "name": "wingSpots", "type": "boolean", "default": false, "note": "white dots on butterfly wings" },
    { "name": "antennae", "type": "enum", "default": "thin", "values": ["none", "thin", "clubbed", "feathery", "elbow"], "note": "clubbed = butterfly; feathery = moth; elbow = ant" },
    { "name": "antennaLen", "type": "number", "note": "antenna length px (default 1.5 x thorax)" },
    { "name": "antennaColor", "type": "colour", "note": "default = color2" },
    { "name": "eyes", "type": "enum", "default": "dots", "values": ["dots", "big", "none"], "note": "big = fly compound eyes" },
    { "name": "stinger", "type": "boolean", "default": false, "note": "bee stinger at the abdomen tip" },
    { "name": "proboscis", "type": "boolean", "default": false, "note": "mosquito proboscis" },
    { "name": "pincers", "type": "enum", "default": "none", "values": ["none", "jaws"], "note": "small jaws at the front of the head" },
    { "name": "glow", "type": "boolean", "default": false, "note": "firefly abdomen glows, pulsing from f" },
    { "name": "hindLegs", "type": "enum", "default": "normal", "values": ["normal", "jumper"], "note": "jumper = big folded hind legs (grasshopper)" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "crawl",
    "pattern": "spots",
    "wings": "shell",
    "legs": 6
  },
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
