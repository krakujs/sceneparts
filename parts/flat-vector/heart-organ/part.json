{
  "id": "flat-vector/heart-organ",
  "type": "prop",
  "style": "flat-vector",
  "name": "Anatomical heart",
  "summary": "Friendly anatomical heart with red vessels and a blue vein; anim beat pumps it. For health lessons.",
  "tags": ["heart", "anatomy", "organ", "cardiology", "biology", "health", "heartbeat"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 900, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 500 px across" },
    { "name": "color", "type": "colour", "default": "#E8503F", "note": "heart colour" },
    { "name": "color2", "type": "colour", "default": "#3D6FE0", "note": "blue vein colour" },
    { "name": "anim", "type": "enum", "default": "none", "values": ["none", "beat"], "note": "beat = a quick double pump every 40 frames" }
  ],
  "example": { "x": 540, "y": 900, "s": 1, "color": "#E8503F", "color2": "#3D6FE0", "anim": "beat" },
  "uses": ["flat-vector/style"],
