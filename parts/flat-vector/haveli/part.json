{
  "id": "flat-vector/haveli",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Haveli",
  "summary": "Ornate Rajasthani haveli facade with jharokha balconies, arched windows and carved trim. For heritage and palace scenes.",
  "tags": [
    "haveli",
    "rajasthan",
    "mansion",
    "jharokha",
    "heritage",
    "palace",
    "india"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 900 px wide and 1030 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E9C58F",
      "note": "Facade colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#B53A2E",
      "note": "Trim and roof colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the arched windows glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}