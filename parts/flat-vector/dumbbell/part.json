    {"name": "color2", "type": "colour", "default": "#9AA3B5", "note": "handle colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "bob = gentle up and down"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror the dumbbell"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#3D6FE0", "color2": "#9AA3B5", "anim": "none"},
