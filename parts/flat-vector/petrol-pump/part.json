    {"name": "s", "type": "number", "default": 1, "note": "about 900 px tall at s = 1"},
    {"name": "color", "type": "colour", "default": "#FF8A3D", "note": "pump body colour"},
    {"name": "color2", "type": "colour", "default": "#5D6578", "note": "plinth, keypad and nozzle colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "pop"], "note": "bob = gentle lift"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror (the hose then hangs on the left)"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1},
