{
  "id": "flat-vector/petrol-pump",
  "type": "prop",
  "style": "flat-vector",
  "name": "Petrol Pump",
  "summary": "Fuel dispenser with a display, keypad, hose and nozzle, with no brand. For petrol station and road trip scenes.",
