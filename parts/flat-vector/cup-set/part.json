{
  "id": "flat-vector/cup-set",
  "type": "prop",
  "style": "flat-vector",
  "name": "Cup Set",
  "summary": "Set of three matching empty cups on saucers in a row, a tea set without a teapot; for tea and kitchen scenes.",
  "tags": [
    "cup set",
    "cups",
    "saucers",
    "tea set",
    "crockery",
    "tableware",
    "tea"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "cup colour (saucers are white)"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#1FA39A"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
