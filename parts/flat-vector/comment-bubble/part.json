{
  "id": "flat-vector/comment-bubble",
  "type": "effect",
  "style": "flat-vector",
  "name": "Comment Bubble",
  "summary": "Flat rounded chat bubble with three text lines, for comments, replies and chat.",
  "tags": ["comment", "reply", "chat", "bubble", "message", "talk", "sticker"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; about 460 px wide at s = 1" },
    { "name": "color", "type": "colour", "default": "#1FA39A", "note": "bubble colour; one darker shade is added for depth" },
    { "name": "anim", "type": "enum", "default": "pop", "values": ["none", "pop", "bob"], "note": "idle motion from p.f" },
    { "name": "popIn", "type": "boolean", "default": true, "note": "springs in over the first 10 frames" },
    { "name": "flip", "type": "boolean", "default": false, "note": "mirror left-right" }
  ],
  "example": { "x": 540, "y": 960, "anim": "pop" },
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
