{
  "id": "flat-vector/stilt-house",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Stilt House",
  "summary": "Wooden house on stilts over water with a deck and a ladder. For lagoon, lake and village-on-water scenes.",
  "tags": [
    "stilt house",
    "stilts",
    "house on water",
    "lagoon",
    "wooden house",
    "ladder",
    "lake"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 700 px wide (deck) and 800 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#A97A55",
      "note": "Wall colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#B53A2E",
      "note": "Roof colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the house windows glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}