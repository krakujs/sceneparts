{
  "id": "flat-vector/chainsaw",
  "type": "prop",
  "style": "flat-vector",
  "name": "Chainsaw",
  "summary": "Orange chainsaw lying on the floor with a black handle and guide bar; tool only, for forestry and logging scenes.",
  "tags": [
    "chainsaw",
    "chain saw",
    "forestry",
    "logging",
    "lumber",
    "tool",
    "woodcutting"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 480 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "guide bar colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "buzz",
        "chain",
        "pop"
      ],
      "note": "buzz = the body vibrates; chain = chain teeth run round the bar; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "chain"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
