{
  "id": "flat-vector/letter",
  "type": "prop",
  "style": "flat-vector",
  "name": "Letter",
  "summary": "Handwritten-look letter sheet with grey wavy lines and a slight curl; anim float drifts it gently. For letters.",
  "tags": [
    "letter",
    "handwritten",
    "note",
    "sheet",
    "correspondence",
    "paper",
    "message"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the sheet rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size at s = 1 (about 600 px tall); use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "paper colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "colour of the handwriting lines"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "float",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "float = drifts up and down with a small tilt"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFFFFF",
    "color2": "#9AA3B5",
    "anim": "float"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
