{
  "id": "flat-vector/chimpanzee",
  "type": "character",
  "style": "flat-vector",
  "name": "Chimpanzee",
  "summary": "Flat vector dark brown-black chimpanzee with a pale tan face, big ears and long arms; stands or walks on knuckles.",
  "tags": [
    "chimpanzee",
    "chimp",
    "ape",
    "primate",
    "animal",
    "jungle",
    "mammal"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet (bottom centre)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 570 px tall standing at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "knuckle",
      "values": [
        "knuckle",
        "stand"
      ],
      "note": "stand = upright with a slight sway; knuckle = walking on knuckles, limbs swing from p.f"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "knuckle"
  },
  "uses": [
    "flat-vector/style",
    "flat-vector/quadruped"
  ],
