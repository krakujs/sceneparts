{
  "id": "flat-vector/hot-air-balloon",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Hot Air Balloon",
  "summary": "Striped hot air balloon on a wicker basket with a burner flame, in front view; for sky, travel and festival scenes.",
  "tags": [
    "hot air balloon",
    "balloon",
    "sky",
    "travel",
    "flying",
    "adventure",
    "festival",
    "air"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x at frame 0"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1500,
      "note": "bottom of the basket stands on y; the balloon floats above it"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale: about 540 px wide and 880 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "envelope stripe colour A"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFC83D",
      "note": "envelope stripe colour B"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "fly",
        "bob",
        "pop"
      ],
      "note": "fly = gentle sway and bob with a flickering burner flame"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "drift in px per frame (negative = left)"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror the balloon"
    }
  ],
  "example": {
    "x": 540,
    "y": 1500,
    "s": 1,
    "anim": "fly"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
