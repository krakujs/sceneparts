{
  "id": "flat-vector/honey-jar",
  "type": "prop",
  "style": "flat-vector",
  "name": "Honey jar",
  "summary": "Round flat jar of golden honey with a cloth cover tied with string and a wooden dipper; for pantry scenes.",
  "tags": [
    "honey",
    "honey jar",
    "jar",
    "pantry",
    "breakfast",
    "food",
    "kitchen"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "liquid",
      "type": "colour",
      "default": "#E8A317",
      "note": "honey colour"
    },
    {
      "name": "level",
      "type": "number",
      "default": 0.82,
      "min": 0,
      "max": 1,
      "note": "honey fill, 0 to 1 of the height"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "liquid": "#E8A317"
  },
  "uses": [
    "flat-vector/drink",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
