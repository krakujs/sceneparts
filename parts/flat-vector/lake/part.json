{
  "id": "flat-vector/lake",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Lake",
  "summary": "Wide oval lake with reeds on the near shore and a far shore of trees. anim flow makes it shimmer.",
  "tags": [
    "lake",
    "water",
    "reeds",
    "shore",
    "trees",
    "shimmer",
    "calm water"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the part stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 1000 px wide and 420 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4AA3D9",
      "note": "water colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#348A4F",
      "note": "tree colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "flow"
      ],
      "note": "flow = the water or ice moves"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "flow"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
