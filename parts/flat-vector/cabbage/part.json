{
  "id": "flat-vector/cabbage",
  "type": "prop",
  "style": "flat-vector",
  "name": "Flat cabbage",
  "summary": "Flat round green cabbage with layered pale leaves and veins, for vegetable and cooking scenes.",
  "tags": [
    "food",
    "vegetable",
    "cabbage",
    "green",
    "leafy",
    "cooking"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (~350 px wide); use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#6DB35F",
      "note": "outer leaf colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "bob = gentle up and down, wobble = rock on its base, pop = scale in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#6DB35F",
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
