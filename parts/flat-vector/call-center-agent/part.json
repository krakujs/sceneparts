{
  "id": "flat-vector/call-center-agent",
  "type": "character",
  "style": "flat-vector",
  "name": "Call Center Agent",
  "summary": "Flat vector call center agent in a teal shirt with headset; for customer service and support explainers.",
  "tags": [
    "call center",
    "customer service",
    "headset",
    "support",
    "agent",
    "helpline",
    "profession"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "talk",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "tan",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "ponytail",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "brown",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "bottom",
      "type": "enum",
      "default": "trousers",
      "values": [
        "trousers",
        "shorts",
        "skirt",
        "overalls"
      ]
    },
    {
      "name": "bottomColor",
      "type": "colour",
      "default": "#253058"
    },
    {
      "name": "shoes",
      "type": "enum",
      "default": "shoes",
      "values": [
        "shoes",
        "sneakers",
        "boots",
        "heels",
        "sandals"
      ]
    },
    {
      "name": "shoesColor",
      "type": "colour",
      "default": "#1F2433"
    },
    {
      "name": "hat",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "cap",
        "beanie",
        "hardhat",
        "chef",
        "beret",
        "brim",
        "fedora",
        "peaked",
        "helmet",
        "headscarf",
        "turban",
        "mortarboard",
        "bandana",
        "tophat",
        "scrubcap",
        "skullcap",
        "sailor"
      ]
    },
    {
      "name": "hatColor",
      "type": "colour",
      "default": "#E8503F",
      "note": "also colours goggles and headphones"
    },
    {
      "name": "extra",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "tie",
        "bowtie",
        "apron",
        "hivis",
        "lanyard",
        "stethoscope",
        "scarf",
        "badge",
        "backpack",
        "toolbelt",
        "sash"
      ]
    },
    {
      "name": "extraColor",
      "type": "colour",
      "default": "#E8503F"
    },
    {
      "name": "prop",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "phone",
        "tablet",
        "laptop",
        "clipboard",
        "book",
        "mug",
        "briefcase",
        "bag",
        "toolbox",
        "wrench",
        "hammer",
        "mic",
        "camera",
        "box",
        "paper",
        "pen",
        "broom",
        "umbrella",
        "tray",
        "pointer"
      ]
    },
    {
      "name": "propColor",
      "type": "colour",
      "default": "#FF8A3D"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "talk",
    "skin": "tan",
    "hair": "ponytail",
    "hairColor": "brown"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
