{
  "id": "flat-vector/puffin",
  "type": "character",
  "style": "flat-vector",
  "name": "Puffin",
  "summary": "Flat vector upright puffin, black and white, with a big striped orange triangular beak; for seabird and cliff scenes.",
  "tags": [
    "puffin",
    "seabird",
    "sea bird",
    "orange beak",
    "cliff",
    "bird"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet on the ground (perch line / water line for perch and swim)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "hop",
        "peck",
        "perch",
        "fly",
        "glide",
        "swim",
        "idle"
      ],
      "note": "perch = sitting, legs tucked; fly = wings flap, lifted by alt; swim = floating, no legs; idle = breathing + head turn"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1F2433",
      "note": "body and head colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame drift"
    },
    {
      "name": "alt",
      "type": "number",
      "default": 120,
      "note": "fly height px above y"
    },
    {
      "name": "wingspan",
      "type": "number",
      "default": 150,
      "note": "wing span px (fly and glide)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand"
  },
  "uses": [
    "flat-vector/bird",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
