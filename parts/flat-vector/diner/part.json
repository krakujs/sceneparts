{
  "id": "flat-vector/diner",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Diner",
  "summary": "Roadside American diner with chrome trim, wide windows, a striped awning and a blank roof sign; anim lights flashes it.",
  "tags": [
    "diner",
    "roadside",
    "cafe",
    "restaurant",
    "american",
    "chrome",
    "sign",
    "street"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the diner stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 880 px wide and 830 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F6E7C8",
      "note": "wall colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#E8503F",
      "note": "roof, awning and sign colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "lights = the sign board and windows glow on and off"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
