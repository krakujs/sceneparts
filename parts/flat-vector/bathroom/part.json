{
  "id": "flat-vector/bathroom",
  "type": "background",
  "style": "flat-vector",
  "name": "Bathroom",
  "summary": "Full-frame flat bathroom background: tiled walls, bathtub with shower curtain, sink with mirror, toilet and towels.",
  "tags": ["bathroom", "toilet", "bathtub", "shower", "tiles", "interior", "background", "washroom"],
  "params": [
    { "name": "time", "type": "enum", "default": "day", "values": ["day", "morning", "dusk", "night"], "note": "tints the tiles and fittings for the time of day" },
    { "name": "tile", "type": "colour", "default": "#D7F1EE", "note": "wall tile colour" },
    { "name": "curtain", "type": "colour", "default": "#8EC5E8", "note": "shower curtain colour" },
    { "name": "anim", "type": "enum", "default": "drift", "values": ["drift", "none"], "note": "drift = the plant sways from p.f" }
  ],
  "example": { "time": "day" },
  "uses": ["flat-vector/style", "flat-vector/backdrop"],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
