{
  "id": "flat-vector/viking",
  "type": "character",
  "style": "flat-vector",
  "name": "Viking",
  "summary": "Flat vector viking with a horn-free round helmet, braided beard, fur cloak and round wooden shield; for northern sagas.",
  "tags": [
    "viking",
    "norse",
    "helmet",
    "beard",
    "fur",
    "shield",
    "history",
    "warrior"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "age",
      "type": "enum",
      "default": "adult",
      "values": [
        "adult",
        "teen",
        "child",
        "toddler",
        "elder"
      ],
      "note": "teen/child/toddler: smaller with a bigger head; elder: slight stoop"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "fair",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand",
    "expression": "smile",
    "skin": "fair"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
