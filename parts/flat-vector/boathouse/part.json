{
  "id": "flat-vector/boathouse",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Boathouse",
  "summary": "Boathouse on the water with a big door and a rowboat outside. For lake, river and harbour scenes.",
  "tags": [
    "boathouse",
    "boat house",
    "lake",
    "river",
    "rowboat",
    "boat",
    "harbour"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 1000 px wide with the water, and 660 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "Wall colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#3A4157",
      "note": "Roof colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the lanterns beside the door glow in turn"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}