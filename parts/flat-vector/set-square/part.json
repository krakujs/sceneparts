{
  "id": "flat-vector/set-square",
  "type": "prop",
  "style": "flat-vector",
  "name": "Set square",
  "summary": "Clear tinted plastic right-angled set square with a cut-out and edge ticks; for drawing and maths.",
  "tags": [
    "set square",
    "triangle ruler",
    "drafting",
    "maths",
    "geometry",
    "drawing",
    "school"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom edge rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "at s = 1 about 360 px wide and 360 px tall"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8EC5E8",
      "note": "plastic tint"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "pop = scales in with a small overshoot"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#8EC5E8",
    "anim": "pop"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
