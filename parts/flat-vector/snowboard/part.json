{
  "id": "flat-vector/snowboard",
  "type": "prop",
  "style": "flat-vector",
  "name": "Snowboard",
  "summary": "Snowboard standing upright on its tail with bindings and a simple stripe graphic; use for winter sports scenes.",
  "tags": ["snowboard", "snowboarding", "winter", "ski", "board", "sport", "prop"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the tail rests on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; hero size: at s = 1 about 180 px wide and 760 px tall"},
    {"name": "color", "type": "colour", "default": "#3D6FE0", "note": "board colour"},
    {"name": "color2", "type": "colour", "default": "#FFC83D", "note": "stripe colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "bob = gentle up and down"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror the board"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#3D6FE0", "color2": "#FFC83D", "anim": "bob"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
