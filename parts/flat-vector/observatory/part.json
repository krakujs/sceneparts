{
  "id": "flat-vector/observatory",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Observatory",
  "summary": "Observatory with a domed roof, an open slit and a telescope poking out. For astronomy and night-sky scenes.",
  "tags": [
    "observatory",
    "telescope",
    "dome",
    "astronomy",
    "stars",
    "science",
    "night sky"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 640 px wide and 760 px tall at s = 1 (telescope included)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F4F1EA",
      "note": "Wall colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#1FA39A",
      "note": "Dome colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the window glows one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}