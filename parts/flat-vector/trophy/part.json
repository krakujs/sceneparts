{
  "id": "flat-vector/trophy",
  "type": "prop",
  "style": "flat-vector",
  "name": "Trophy",
  "summary": "Gold cup trophy with two handles on a stepped base; use when a winner is crowned or a prize is awarded.",
  "tags": ["trophy", "cup", "award", "winner", "champion", "prize", "prop"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the base rests on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; hero size: at s = 1 about 500 px wide and 640 px tall"},
    {"name": "color", "type": "colour", "default": "#FFC83D", "note": "gold colour of the cup"},
    {"name": "color2", "type": "colour", "default": "#253058", "note": "base colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "pop = scales in with a small overshoot"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror the trophy"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#FFC83D", "color2": "#253058", "anim": "pop"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
