    {"name": "s", "type": "number", "default": 1, "note": "scale; about 480 px long at 1"},
    {"name": "color", "type": "colour", "default": "#FF8A3D", "note": "body colour"},
    {"name": "beam", "type": "colour", "default": "#FFE066", "note": "glow and bolt colour"},
    {"name": "anim", "type": "enum", "default": "fire", "values": ["fire", "none"], "note": "fire = a bolt every 90 frames"},
    {"name": "flip", "type": "boolean", "default": false, "note": "point the barrel left"}
  ],
  "example": {"x": 540, "y": 1400, "anim": "fire"},
