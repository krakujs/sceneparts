{
  "id": "flat-vector/laser-gun",
  "type": "prop",
  "style": "flat-vector",
  "name": "Laser gun",
  "summary": "Chunky retro ray gun with brass rings and a glowing tip; anim fire shoots a bolt with a muzzle flash.",
  "tags": ["laser gun", "ray gun", "blaster", "retro", "weapon", "sci-fi", "space", "fire"],
  "params": [
