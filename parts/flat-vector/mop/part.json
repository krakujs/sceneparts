{
  "id": "flat-vector/mop",
  "type": "prop",
  "style": "flat-vector",
  "name": "Mop",
  "summary": "Mop with a stringy cotton head on a long grey handle; for mopping floors and cleaning scenes.",
  "tags": [
    "mop",
    "floor mop",
    "mopping",
    "cleaning",
    "housework",
    "strings",
    "household"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a flat-vector person at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "strand colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "swish"
      ],
      "note": "swish = rocks side to side from the floor, as if mopping"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFC83D"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
