{
  "id": "flat-vector/cutting-board",
  "type": "prop",
  "style": "flat-vector",
  "name": "Cutting Board",
  "summary": "Wooden chopping board with a handle hole, optionally with chopped carrot, pepper and cucumber; for kitchen scenes.",
  "tags": [
    "cutting board",
    "chopping board",
    "wooden board",
    "kitchen",
    "vegetables",
    "chopping",
    "cooking"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "food",
      "type": "boolean",
      "default": false,
      "note": "true = a few chopped vegetable pieces on top"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#C98B55",
      "note": "wood colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "food": true,
    "color": "#C98B55"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
