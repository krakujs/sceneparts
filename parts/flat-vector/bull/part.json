{
  "id": "flat-vector/bull",
  "type": "character",
  "style": "flat-vector",
  "name": "Bull",
  "summary": "Flat vector dark brown muscular bull with curved horns and a big shoulder; for farm and strong-animal scenes.",
  "tags": [
    "bull",
    "cow",
    "farm",
    "cattle",
    "animal",
    "strong",
    "horns"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "idle",
        "sit",
        "lie",
        "graze"
      ],
      "note": "idle = breathing + tail wag; graze = head down"
    },
    {
      "name": "mouth",
      "type": "enum",
      "default": "smile",
      "values": [
        "none",
        "smile",
        "open",
        "tongue"
      ]
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4A2E1E",
      "note": "coat colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand"
  },
  "uses": [
    "flat-vector/quadruped",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
