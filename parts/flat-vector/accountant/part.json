{
  "id": "flat-vector/accountant",
  "type": "character",
  "style": "flat-vector",
  "name": "Accountant",
  "summary": "Flat vector accountant in a shirt and glasses holding a calculator; for finance and tax explainers.",
  "tags": [
    "accountant",
    "accounting",
    "finance",
    "tax",
    "bookkeeper",
    "calculator",
    "numbers",
    "glasses"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "hold",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "neutral",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "dark",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "curly",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "black",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "shirtColor",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "shirt under a blazer or coat"
    },
    {
      "name": "hatColor",
      "type": "colour",
      "default": "#E8503F",
      "note": "also colours goggles and headphones"
    },
    {
      "name": "propColor",
      "type": "colour",
      "default": "#FF8A3D"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "hold",
    "skin": "dark",
    "hair": "curly",
    "hairColor": "black"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
