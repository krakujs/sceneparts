{
  "id": "flat-vector/pepper",
  "type": "prop",
  "style": "flat-vector",
  "name": "Pepper",
  "summary": "Bell pepper with a thick green stem; red by default, or yellow or green. For vegetable, salad and cooking scenes.",
  "tags": [
    "pepper",
    "bell pepper",
    "capsicum",
    "vegetable",
    "food"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (~350 px wide); use about 0.2-0.3 next to a person"
    },
    {
      "name": "color",
      "type": "enum",
      "default": "red",
      "values": [
        "red",
        "yellow",
        "green"
      ],
      "note": "bell pepper colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "bounce",
        "roll",
        "pop"
      ],
      "note": "bob = gentle up and down, wobble = rock on its base, bounce = drop in, roll = roll in from the left, pop = scale in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "red"
  },
  "uses": [
    "flat-vector/fruit",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
