{
  "id": "flat-vector/kettle",
  "type": "prop",
  "style": "flat-vector",
  "name": "Kettle",
  "summary": "Flat stovetop or electric kettle with an arched handle, spout and water window; for kitchen and tea scenes.",
  "tags": [
    "kettle",
    "electric kettle",
    "stovetop kettle",
    "boiling water",
    "kitchen",
    "appliance",
    "tea"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "variant",
      "type": "enum",
      "default": "stovetop",
      "values": [
        "stovetop",
        "electric"
      ],
      "note": "stovetop = arched handle and spout; electric = cordless base and window"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "kettle colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "variant": "stovetop",
    "color": "#E8503F"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
