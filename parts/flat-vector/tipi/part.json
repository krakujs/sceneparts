    {"name": "color", "type": "colour", "default": "#E9D3A9", "note": "canvas colour"},
    {"name": "color2", "type": "colour", "default": "#E8503F", "note": "geometric band colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "pop", "lights"], "note": "lights = a fire glows in the opening"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
