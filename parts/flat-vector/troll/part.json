{
  "id": "flat-vector/troll",
  "type": "character",
  "style": "flat-vector",
  "name": "Troll",
  "summary": "Flat vector big grey-green troll with a bulbous nose, underbite, mossy hair and a log club; for fairy-tale bridges.",
  "tags": [
    "troll",
    "monster",
    "fairy tale",
    "mossy",
    "club",
    "giant",
    "bridge",
    "grumpy"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#7F9A7A",
      "note": "Body colour (grey-green)"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
