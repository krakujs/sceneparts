{
  "id": "flat-vector/sand-bag",
  "type": "prop",
  "style": "flat-vector",
  "name": "Sandbags",
  "summary": "Pyramid stack of tied sandbags; for flood defence, bunkers, construction and beach scenes.",
  "tags": ["sandbags", "sandbag", "sand bag", "flood", "barrier", "bunker", "sand"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the stack rests on y"},
    {"name": "s", "type": "number", "default": 1, "note": "room scale: at s = 1 about 560 px wide and 320 px tall; use about 0.5 next to a person"},
    {"name": "color", "type": "colour", "default": "#E9D3A9", "note": "sack colour"},
    {"name": "color2", "type": "colour", "default": "#D4B885", "note": "colour of the alternate sacks"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole stack"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
