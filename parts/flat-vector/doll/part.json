{
  "id": "flat-vector/doll",
  "type": "prop",
  "style": "flat-vector",
  "name": "Doll",
  "summary": "Generic rag doll with yarn hair, pigtails and a simple dress, front view; for nursery, toy and play scenes.",
  "tags": ["doll", "rag doll", "toy", "yarn hair", "dolly", "kids toy", "plaything"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the shoes rest on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"},
    {"name": "color", "type": "colour", "default": "#F27BA6", "note": "dress colour"},
    {"name": "color2", "type": "colour", "default": "#FFC83D", "note": "yarn hair colour"},
    {"name": "skin", "type": "enum", "default": "light", "values": ["light", "fair", "tan", "medium", "brown", "dark"], "note": "skin tone"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion only; driven by the frame"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#F27BA6", "color2": "#FFC83D", "skin": "light"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
