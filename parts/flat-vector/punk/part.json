{
  "id": "flat-vector/punk",
  "type": "character",
  "style": "flat-vector",
  "name": "Punk",
  "summary": "Flat vector punk with a coloured mohawk and studded jacket; for music, rebellion and subculture explainers.",
  "tags": [
    "punk",
    "mohawk",
    "studded jacket",
    "ripped jeans",
    "subculture",
    "rebel",
    "alternative",
    "person"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "neutral",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "tan",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "pink",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "accessory",
      "type": "enum",
      "default": "earrings",
      "values": [
        "none",
        "glasses",
        "sunglasses",
        "goggles",
        "mask",
        "beard",
        "moustache",
        "stubble",
        "headset",
        "headphones",
        "earrings"
      ]
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand",
    "skin": "tan",
    "hairColor": "pink"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
