{
  "id": "flat-vector/grandfather",
  "type": "character",
  "style": "flat-vector",
  "name": "Grandfather",
  "summary": "Flat vector grandfather with a warm smile, shirt, braces and waistcoat, holding a mug; for family and generations.",
  "tags": [
    "grandfather",
    "grandpa",
    "grandad",
    "elder",
    "senior",
    "family",
    "mug"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "brown",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "short",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "white",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "topColor",
      "type": "colour",
      "default": "#8EC5E8"
    },
    {
      "name": "bottom",
      "type": "enum",
      "default": "trousers",
      "values": [
        "trousers",
        "shorts",
        "skirt",
        "overalls"
      ]
    },
    {
      "name": "bottomColor",
      "type": "colour",
      "default": "#8A5A3C"
    },
    {
      "name": "shoesColor",
      "type": "colour",
      "default": "#1F2433"
    },
