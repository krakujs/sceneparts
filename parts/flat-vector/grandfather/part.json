        "tablet",
        "laptop",
        "clipboard",
        "book",
        "mug",
        "briefcase",
        "bag",
        "toolbox",
        "wrench",
        "hammer",
        "mic",
        "camera",
        "box",
        "paper",
        "pen",
        "broom",
        "umbrella",
        "tray",
        "pointer"
      ]
    },
    {
      "name": "propColor",
      "type": "colour",
      "default": "#3D6FE0"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
