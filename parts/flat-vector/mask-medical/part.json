{
  "id": "flat-vector/mask-medical",
  "type": "prop",
  "style": "flat-vector",
  "name": "Medical face mask",
  "summary": "Pleated light-blue surgical face mask with ear loops, front view; for health, hygiene and clinic scenes.",
  "tags": [
    "face mask",
    "surgical mask",
    "medical mask",
    "mask",
    "health",
    "hygiene",
    "clinic"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the base rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: at s = 1 about 400 px wide and 320 px tall; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8EC5E8",
      "note": "mask colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "pop = scales in with a small overshoot"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#8EC5E8",
    "anim": "bob"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
