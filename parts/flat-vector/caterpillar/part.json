{
  "id": "flat-vector/caterpillar",
  "type": "character",
  "style": "flat-vector",
  "name": "Caterpillar",
  "summary": "Caterpillar: green segmented caterpillar with tiny legs and a friendly face; inches along the ground.",
  "tags": [
    "caterpillar",
    "worm",
    "segmented",
    "garden",
    "green",
    "crawling"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet / bottom centre"
    },
    {
      "name": "s",
      "type": "number",
