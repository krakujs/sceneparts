{
  "id": "flat-vector/veterinarian",
  "type": "character",
  "style": "flat-vector",
  "name": "Veterinarian",
  "summary": "Flat vector veterinarian in teal scrubs with a stethoscope, cradling a small puppy; for animal-care explainers.",
  "tags": [
    "veterinarian",
    "vet",
    "animal",
    "pet",
    "dog",
    "puppy",
    "animal doctor",
    "profession",
    "person"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "hold",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "medium",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "ponytail",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "auburn",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "shirtColor",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "shirt under a blazer or coat"
    },
    {
      "name": "hat",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "cap",
        "beanie",
        "hardhat",
        "chef",
        "beret",
        "brim",
        "fedora",
        "peaked",
        "helmet",
        "headscarf",
        "turban",
        "mortarboard",
        "bandana",
        "tophat",
        "scrubcap",
        "skullcap",
        "sailor"
      ]
    },
    {
      "name": "hatColor",
      "type": "colour",
      "default": "#E8503F",
      "note": "also colours goggles and headphones"
    },
    {
      "name": "accessory",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "glasses",
        "sunglasses",
        "goggles",
        "mask",
        "beard",
        "moustache",
        "stubble",
        "headset",
        "headphones",
        "earrings"
      ]
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "hold",
    "skin": "medium",
    "hair": "ponytail",
    "hairColor": "auburn"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
