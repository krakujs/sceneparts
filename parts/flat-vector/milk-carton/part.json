{
  "id": "flat-vector/milk-carton",
  "type": "prop",
  "style": "flat-vector",
  "name": "Milk carton",
  "summary": "White flat milk carton with a plain blue band and a drop shape, no text; for breakfast and dairy scenes.",
  "tags": [
    "milk",
    "milk carton",
    "carton",
    "dairy",
    "breakfast",
    "drink",
    "gable top"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "carton colour"
    },
    {
      "name": "label",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "band colour, no text"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFFFFF"
  },
  "uses": [
    "flat-vector/drink",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
