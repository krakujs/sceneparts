{
  "id": "flat-vector/podium",
  "type": "prop",
  "style": "flat-vector",
  "name": "Podium",
  "summary": "Three-step winners' podium with the numbers 1, 2 and 3 on the steps; use for ceremonies, results and victory scenes.",
  "tags": [
    "podium",
    "winners podium",
    "ceremony",
    "first place",
    "winner",
    "results",
    "prop"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the steps stand on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "room scale: 1 m is about 560 px; the podium is about 800 px wide and 1 m tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "first place step colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#C9CED8",
      "note": "second place step colour"
    },
    {
      "name": "color3",
      "type": "colour",
      "default": "#C98A5A",
      "note": "third place step colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "rise",
        "bob",
        "pop"
      ],
      "note": "rise = the three steps grow up from the floor in turn"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (the numbers stay readable)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FFC83D",
    "color2": "#C9CED8",
    "color3": "#C98A5A",
    "anim": "bob"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
