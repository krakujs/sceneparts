{
  "id": "flat-vector/popsicle",
  "type": "prop",
  "style": "flat-vector",
  "name": "Popsicle",
  "summary": "Flat ice lolly on a wooden stick, two-tone, with an optional bite out of the top; for summer treat scenes.",
  "tags": [
    "popsicle",
    "ice lolly",
    "ice pop",
    "lolly",
    "summer",
    "treat",
    "dessert"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF6F91",
      "note": "top colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#1FA39A",
      "note": "bottom colour"
    },
    {
      "name": "bite",
      "type": "boolean",
      "default": false,
      "note": "a bite taken out of the top right"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FF6F91",
    "color2": "#1FA39A",
    "bite": false
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
