{
  "id": "flat-vector/electric-scooter",
  "type": "prop",
  "style": "flat-vector",
  "name": "Electric Scooter",
  "summary": "Kick-style electric scooter with deck, stem, handlebar and small wheels, facing right; for commute and city scenes.",
  "tags": ["electric scooter", "e-scooter", "kick scooter", "scooter", "commute", "city", "transport"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "ground line: the wheels touch y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 470 px wide and 360 px tall (hero size)"},
    {"name": "color", "type": "colour", "default": "#1FA39A", "note": "deck and fender colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop", "roll"], "note": "roll = wheel spokes turn"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror (flip makes it face left)"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1, "color": "#1FA39A", "anim": "roll"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
