{
  "id": "flat-vector/art-studio",
  "type": "background",
  "style": "flat-vector",
  "name": "Art studio",
  "summary": "Full-frame flat art studio: easels with canvases, a big skylight window, paint pots, brushes jar and floor splatters.",
  "tags": ["art studio", "painting", "easel", "canvas", "paint", "artist", "studio", "background"],
  "params": [
    { "name": "time", "type": "enum", "default": "day", "values": ["day", "morning", "dusk", "night"], "note": "light through the big skylight window and room tint" },
    { "name": "weather", "type": "enum", "default": "clear", "values": ["clear", "cloudy", "rain", "snow", "fog", "storm"], "note": "seen through the big window" },
    { "name": "wall", "type": "colour", "default": "#F4F1EA", "note": "wall colour" },
    { "name": "floor", "type": "colour", "default": "#D9C29A", "note": "floor colour" },
    { "name": "anim", "type": "enum", "default": "drift", "values": ["drift", "none"], "note": "drift = weather and the trees outside move from p.f" }
  ],
  "example": { "time": "day", "weather": "clear" },
  "uses": ["flat-vector/style", "flat-vector/backdrop"],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
