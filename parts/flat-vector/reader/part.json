{
  "id": "flat-vector/reader",
  "type": "character",
  "style": "flat-vector",
  "name": "Reader",
  "summary": "Flat vector reader sitting on a bench with glasses, reading an open book; for reading, study and library explainers.",
  "tags": [
    "reader",
    "reading",
    "book",
    "sitting",
    "library",
    "glasses",
    "study",
    "person"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "neutral",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "fair",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "short",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "grey",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "expression": "neutral",
    "skin": "fair",
    "hair": "short",
    "hairColor": "grey"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
