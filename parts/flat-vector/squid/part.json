{
  "id": "flat-vector/squid",
  "type": "character",
  "style": "flat-vector",
  "name": "Squid",
  "summary": "Flat vector pink squid with fins, big eyes, eight short arms and two long trailing tentacles; y is body centre.",
  "tags": [
    "squid",
    "sea",
    "ocean",
    "tentacles",
    "marine",
    "cephalopod",
    "pink"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "body centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1000,
      "note": "body centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "swim",
      "values": [
        "swim",
        "idle"
      ],
      "note": "swim = gentle motion from p.f; idle = slow hover"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F7A8C4",
      "note": "body colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1000,
    "pose": "swim"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
