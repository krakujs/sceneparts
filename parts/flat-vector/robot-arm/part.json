{
  "id": "flat-vector/robot-arm",
  "type": "prop",
  "style": "flat-vector",
  "name": "Robot arm",
  "summary": "Industrial robot arm on a base with a two-finger gripper; anim swing moves its joints. For factory scenes.",
  "tags": [
    "robot arm",
    "robot",
    "industrial robot",
    "factory",
    "automation",
    "gripper",
    "machine"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "bottom centre: the base rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; room-scale machine: at s = 1 it is about 870 px tall and 500 px wide"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "arm colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "swing"
      ],
      "note": "swing = shoulder, elbow and wrist move and the gripper opens and closes"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "color": "#FF8A3D",
    "anim": "swing"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
