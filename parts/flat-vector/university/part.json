{
  "id": "flat-vector/university",
  "type": "scenery",
  "style": "flat-vector",
  "name": "University",
  "summary": "Classical university hall with columns, a pediment, wide steps and a clock cupola; anim lights glows its windows.",
  "tags": [
    "university",
    "college",
    "campus",
    "hall",
    "columns",
    "pediment",
    "education",
    "building"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 880 px wide and 1000 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F2EADB",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim lights = flank windows glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "example": {
      "x": 540,
      "y": 1600,
      "s": 1,
      "anim": "lights"
    }
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
