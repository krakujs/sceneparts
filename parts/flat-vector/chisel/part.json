{
  "id": "flat-vector/chisel",
  "type": "prop",
  "style": "flat-vector",
  "name": "Chisel",
  "summary": "Wood chisel lying on the floor with a chunky handle, steel ferrule and tapered blade; for woodwork scenes.",
  "tags": [
    "chisel",
    "wood chisel",
    "woodwork",
    "carpentry",
    "tool",
    "joinery",
    "blade"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 470 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "handle colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "blade colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "tap",
        "wobble",
        "pop"
      ],
      "note": "tap = the chisel bounces as if struck; wobble = slight rock; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "tap"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
