{
  "id": "flat-vector/cryo-pod",
  "type": "prop",
  "style": "flat-vector",
  "name": "Cryo pod",
  "summary": "Upright capsule with a frosted glass front, mist and status lights; empty or with a sleeping silhouette.",
  "tags": ["cryo pod", "cryogenic", "sleep pod", "capsule", "sci-fi", "lab", "hibernation"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "floor centre under the base"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; ~900 px tall at 1"},
    {"name": "occupant", "type": "enum", "default": "empty", "values": ["empty", "sleeper"], "note": "sleeper = a sleeping silhouette inside"},
    {"name": "glass", "type": "colour", "default": "#8EC5E8", "note": "tint of the frosted glass"},
    {"name": "anim", "type": "enum", "default": "mist", "values": ["mist", "none"], "note": "mist = cold vapour rises and the lights blink"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "occupant": "sleeper", "anim": "mist"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
