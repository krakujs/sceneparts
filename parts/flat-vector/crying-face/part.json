{
  "id": "flat-vector/crying-face",
  "type": "effect",
  "style": "flat-vector",
  "name": "Crying Face",
  "summary": "Flat sticker sobbing face with streams of tears; reaction for videos and comments.",
  "tags": [
    "crying",
    "sob",
    "tears",
    "upset",
    "heartbroken",
    "face",
    "reaction",
    "emotion"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; face is about 360 px wide at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "face colour (one darker crescent is added automatically)"
    },
    {
      "name": "extra",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "hearts",
        "zzz",
        "steam",
        "sparkles",
        "orbit",
        "burst",
        "snow",
        "heat",
        "confetti",
        "question",
        "bubble",
        "kiss-heart"
      ],
      "note": "floating effect around the face, animated from p.f"
    },
    {
      "name": "accessory",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "shades",
        "nerd",
        "party-hat",
        "thermometer",
        "mask",
        "hand-chin",
        "finger",
        "ice-cap",
        "napkin"
      ],
      "note": "thing worn or held"
    },
    {
      "name": "blush",
      "type": "boolean",
      "default": false,
      "note": "pink cheeks"
    },
    {
      "name": "sweat",
      "type": "boolean",
      "default": false,
      "note": "sweat drop sliding down the forehead"
    },
    {
      "name": "look",
      "type": "enum",
      "default": "center",
      "values": [
        "center",
        "left",
        "right",
        "up",
        "down"
      ],
      "note": "pupil direction for dot, open and wide eyes"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "tremble",
      "values": [
        "none",
        "bob",
        "bounce",
        "shake",
        "wobble",
        "pulse",
        "tremble",
        "spin",
        "nod"
      ],
      "note": "idle motion from p.f"
    },
    {
      "name": "popIn",
      "type": "boolean",
      "default": true,
      "note": "springs in over the first 10 frames"
    },
    {
      "name": "blink",
      "type": "boolean",
      "default": true,
      "note": "blinks every 96 frames"
    },
    {
      "name": "border",
      "type": "boolean",
      "default": true,
      "note": "white die-cut sticker edge around the face"
    },
    {
      "name": "rotate",
      "type": "number",
      "default": 0,
      "note": "degrees; 180 = upside down"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror left-right"
    }
  ],
  "example": {
    "x": 540,
    "y": 960
  },
  "uses": [
    "flat-vector/reaction-face",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}