{
  "id": "flat-vector/clownfish",
  "type": "character",
  "style": "flat-vector",
  "name": "Clownfish",
  "summary": "Flat vector bright orange clownfish with three white bands edged dark and rounded fins.",
  "tags": [
    "clownfish",
    "fish",
    "reef",
    "sea",
    "orange",
    "tropical"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "body centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1000,
      "note": "body centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "swim",
      "values": [
        "swim",
        "idle",
        "dart",
        "puffed"
      ],
      "note": "swim = body wave and tail beat from p.f; idle = slow hover, fins flutter; dart = fast beat; puffed = inflated pufferfish, no wave"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF7A1F",
      "note": "body colour"
    },
    {
      "name": "patternColor",
      "type": "colour",
      "default": "#B07A3C",
      "note": "colour of stripes, spots, speckles and scales"
    },
    {
      "name": "spikes",
      "type": "boolean",
      "default": false,
      "note": "spines around the body (pufferfish)"
    },
    {
      "name": "bubbles",
      "type": "boolean",
      "default": false,
      "note": "bubbles rising from the mouth, from p.f"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1000,
    "pose": "swim"
  },
  "uses": [
    "flat-vector/fish",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
