{
  "id": "flat-vector/excavator",
  "type": "prop",
  "style": "flat-vector",
  "name": "Excavator",
  "summary": "Tracked excavator digger with boom, arm and bucket in side view; room-scale for building-site scenes.",
  "tags": [
    "excavator",
    "digger",
    "earthmover",
    "construction",
    "mini digger",
    "dig",
    "building site",
    "roadworks"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the tracks stand on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "room scale: about 750 px wide and 530 px tall at s = 1; use about 0.6 for a smaller scene"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "cab and boom colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#5D6578",
      "note": "arm and bucket colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "dig"
      ],
      "note": "dig = the arm and bucket swing back and forth"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (the bucket then faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "dig"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
