{
  "id": "flat-vector/screws",
  "type": "prop",
  "style": "flat-vector",
  "name": "Screws",
  "summary": "A few big slotted steel screws lying on the floor with threaded shafts; for fixing, hardware and DIY scenes.",
  "tags": [
    "screws",
    "screw",
    "wood screw",
    "hardware",
    "fixing",
    "diy",
    "threads"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 470 px across at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "shaft colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#5D6578",
      "note": "head colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "turn",
        "wobble",
        "pop"
      ],
      "note": "turn = threads run along the shaft as if turning; wobble = slight rock; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "turn"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
