{
  "id": "flat-vector/exclamation-mark",
  "type": "effect",
  "style": "flat-vector",
  "name": "Exclamation Mark",
  "summary": "Chunky red exclamation mark that bounces: use for alerts, important notes or surprise.",
  "tags": [
    "exclamation",
    "alert",
    "important",
    "attention",
    "surprise",
    "notice",
    "warning"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 240 px wide at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "glyph colour; a darker edge is added"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "bounce",
      "values": [
        "none",
        "bounce",
        "pulse"
      ],
      "note": "bounce = small hops, pulse = slight breathing"
    },
    {
      "name": "popIn",
      "type": "boolean",
      "default": true,
      "note": "springs in over the first 10 frames"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "anim": "bounce"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
