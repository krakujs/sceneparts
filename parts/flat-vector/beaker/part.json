{
  "id": "flat-vector/beaker",
  "type": "prop",
  "style": "flat-vector",
  "name": "Beaker",
  "summary": "Lab beaker with a pouring lip, measuring marks and coloured liquid; use for science or cooking-lab scenes.",
  "tags": [
    "beaker",
    "lab",
    "science",
    "chemistry",
    "liquid",
    "measuring",
    "experiment"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size: at s = 1 about 300 px wide and 400 px tall; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "liquid colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bubbles"
      ],
      "note": "bubbles = bubbles rise through the liquid"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#4BB46A",
    "anim": "bubbles"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
