{
  "id": "flat-vector/sunflower",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Sunflower",
  "summary": "Tall sunflower with a big yellow petal ring around a brown seed disc and large leaves; use for summer fields.",
  "tags": [
    "sunflower",
    "flower",
    "summer",
    "yellow",
    "tall plant",
    "field",
    "garden"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "bottom of the stem rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 1050 px tall, use about 0.5 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "petal colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "sway"
      ],
      "note": "sway = head and leaves move gently in the wind"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "color": "#FFC83D",
    "anim": "sway"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
