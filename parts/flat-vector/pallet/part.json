{
  "id": "flat-vector/pallet",
  "type": "prop",
  "style": "flat-vector",
  "name": "Wooden pallet",
  "summary": "Wooden shipping pallet in 3/4 view with deck boards and stringer blocks; for loading, warehouse and freight scenes.",
  "tags": ["pallet", "wooden pallet", "shipping", "freight", "warehouse", "loading", "cargo"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the pallet lies on y"},
    {"name": "s", "type": "number", "default": 1, "note": "room scale: at s = 1 about 720 px wide and 300 px tall; use about 0.5 next to a person"},
    {"name": "color", "type": "colour", "default": "#E9D3A9", "note": "board colour"},
    {"name": "color2", "type": "colour", "default": "#8A5A3C", "note": "stringer block colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole pallet"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
