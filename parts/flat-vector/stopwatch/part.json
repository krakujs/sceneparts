{
  "id": "flat-vector/stopwatch",
  "type": "prop",
  "style": "flat-vector",
  "name": "Stopwatch",
  "summary": "Round stopwatch with a crown button and second hand; anim tick steps the hand. Use for timing and races.",
  "tags": [
    "stopwatch",
    "timer",
    "clock",
    "race",
    "timing",
    "sport",
    "prop"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the stand rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size: at s = 1 about 520 px wide and 680 px tall"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "case colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "button and second hand colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "tick",
        "bob",
        "pop"
      ],
      "note": "tick = the second hand jumps forward once a second"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror the stopwatch"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#3D6FE0",
    "color2": "#FF8A3D",
    "anim": "tick"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
