{
  "id": "flat-vector/leaf",
  "type": "prop",
  "style": "flat-vector",
  "name": "Leaf",
  "summary": "Single green leaf with a midrib and veins; anim fall makes it drift down swinging. For trees and autumn scenes.",
  "tags": [
    "leaf",
    "green leaf",
    "veins",
    "midrib",
    "falling leaf",
    "tree",
    "nature"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "stalk rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 330 px tall, use about 0.5 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4BB46A",
      "note": "leaf colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "fall"
      ],
      "note": "fall = leaf drifts and swings from side to side"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#4BB46A",
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
