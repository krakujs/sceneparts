{
  "id": "flat-vector/laboratory-building",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Laboratory Building",
  "summary": "Modern laboratory building with a glass facade, rooftop vents and a flask sign. For science and research scenes.",
  "tags": [
    "laboratory",
    "lab",
    "science",
    "research",
    "flask",
    "chemistry",
    "modern building"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 680 px wide and 1020 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#DDE2EA",
      "note": "Facade colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#1FA39A",
      "note": "Sign and roof colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = the lab windows glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}