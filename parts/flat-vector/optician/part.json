{
  "id": "flat-vector/optician",
  "type": "character",
  "style": "flat-vector",
  "name": "Optician",
  "summary": "Flat vector optician in a white coat and glasses, holding an eye-chart card; for eyecare and vision explainers.",
  "tags": [
    "optician",
    "eye doctor",
    "eyecare",
    "glasses",
    "vision",
    "eye chart",
    "health",
    "profession",
    "person"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "fair",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "long",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "blonde",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "hat",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "cap",
        "beanie",
        "hardhat",
        "chef",
        "beret",
        "brim",
        "fedora",
        "peaked",
        "helmet",
        "headscarf",
        "turban",
        "mortarboard",
        "bandana",
        "tophat",
        "scrubcap",
        "skullcap",
        "sailor"
      ]
    },
    {
      "name": "hatColor",
      "type": "colour",
      "default": "#E8503F",
      "note": "also colours goggles and headphones"
    },
    {
      "name": "extra",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "tie",
        "bowtie",
        "apron",
        "hivis",
        "lanyard",
        "stethoscope",
        "scarf",
        "badge",
        "backpack",
        "toolbelt",
        "sash"
      ]
    },
    {
      "name": "extraColor",
      "type": "colour",
      "default": "#E8503F"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "hold",
    "skin": "fair",
    "hair": "long",
    "hairColor": "blonde"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
