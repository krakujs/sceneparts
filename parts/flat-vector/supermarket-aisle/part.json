{
  "id": "flat-vector/supermarket-aisle",
  "type": "background",
  "style": "flat-vector",
  "name": "Supermarket aisle",
  "summary": "Full-frame flat supermarket aisle background: shelves of colourful packages both sides, ceiling lights, trolley.",
  "tags": ["supermarket", "grocery", "aisle", "shopping", "store", "background", "trolley"],
  "params": [
    { "name": "time", "type": "enum", "default": "day", "values": ["day", "morning", "dusk", "night"], "note": "light of the store; night shows brighter ceiling lights" },
    { "name": "wall", "type": "colour", "default": "#EEF2F7", "note": "back wall colour" },
    { "name": "floor", "type": "colour", "default": "#D6DCE6", "note": "floor colour" },
    { "name": "seed", "type": "number", "default": 14, "note": "varies package heights and spacing" },
    { "name": "anim", "type": "enum", "default": "drift", "values": ["drift", "none"], "note": "drift = trolley rocks gently" }
  ],
  "example": { "time": "day" },
  "uses": ["flat-vector/style", "flat-vector/backdrop"],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
