{
  "id": "flat-vector/explorer",
  "type": "character",
  "style": "flat-vector",
  "name": "Explorer",
  "summary": "Flat vector explorer in a khaki hat and safari clothes with binoculars and map; for travel and discovery.",
  "tags": [
    "explorer",
    "safari",
    "adventure",
    "map",
    "binoculars",
    "travel",
    "jungle",
    "discovery"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "dark",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "none",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "black",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand",
    "expression": "smile",
    "skin": "dark",
    "hair": "none",
    "hairColor": "black"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
