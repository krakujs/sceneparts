{
  "id": "flat-vector/forest-path",
  "type": "background",
  "style": "flat-vector",
  "name": "Forest path",
  "summary": "Full-frame flat forest path background: dense trunks on both sides, a winding dirt path, ferns and light shafts.",
  "tags": ["forest", "woods", "path", "trees", "nature", "background", "outdoor"],
  "params": [
    { "name": "time", "type": "enum", "default": "day", "values": ["day", "morning", "dusk", "night"], "note": "light under the canopy" },
    { "name": "weather", "type": "enum", "default": "clear", "values": ["clear", "cloudy", "rain", "snow", "fog", "storm"], "note": "animated weather over the scene" },
    { "name": "leaf", "type": "colour", "default": "#3E8F5A", "note": "leaf colour of the canopy and ferns" },
    { "name": "shafts", "type": "boolean", "default": true, "note": "show soft light shafts through the trees" },
    { "name": "anim", "type": "enum", "default": "drift", "values": ["drift", "none"], "note": "drift = light shafts and weather move from p.f" }
  ],
  "example": { "time": "day", "weather": "clear", "leaf": "#3E8F5A", "shafts": true },
  "uses": ["flat-vector/style", "flat-vector/backdrop"],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
