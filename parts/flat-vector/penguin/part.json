{
  "id": "flat-vector/penguin",
  "type": "character",
  "style": "flat-vector",
  "name": "Penguin",
  "summary": "Flat vector upright penguin with a black back, white belly, orange beak and feet; flightless, waddles when walking.",
  "tags": [
    "penguin",
    "flightless bird",
    "waddle",
    "antarctic",
    "arctic",
    "bird"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet on the ground (perch line / water line for perch and swim)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "walk",
      "values": [
        "stand",
        "walk",
        "hop",
        "peck",
        "perch",
        "fly",
        "glide",
        "swim",
        "idle"
      ],
      "note": "perch = sitting, legs tucked; fly = wings flap, lifted by alt; swim = floating, no legs; idle = breathing + head turn"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1F2433",
      "note": "body and head colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame drift"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "walk"
  },
  "uses": [
    "flat-vector/bird",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
