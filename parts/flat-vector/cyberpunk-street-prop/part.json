    {"name": "anim", "type": "enum", "default": "pulse", "values": ["pulse", "none"], "note": "pulse = screen bars move, keys light up, neon breathes"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror"}
  ],
  "example": {"x": 540, "y": 1560, "accent": "#FF4FA3", "accent2": "#3DE0FF", "anim": "pulse"},
