{
  "id": "flat-vector/cyberpunk-street-prop",
  "type": "prop",
  "style": "flat-vector",
  "name": "Cyberpunk street prop",
  "summary": "Neon-lit futuristic vending kiosk with a screen, keypad, cables and glowing panels; no brand text.",
  "tags": ["cyberpunk", "neon", "kiosk", "vending machine", "street", "futuristic", "sci-fi", "night city"],
