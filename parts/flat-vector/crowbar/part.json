{
  "id": "flat-vector/crowbar",
  "type": "prop",
  "style": "flat-vector",
  "name": "Crowbar",
  "summary": "Bent steel pry bar lying on the floor with a flat tip and a hooked claw; for demolition and prying scenes.",
  "tags": [
    "crowbar",
    "pry bar",
    "jemmy",
    "wrecking bar",
    "tool",
    "demolition",
    "lever"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 460 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#5D6578",
      "note": "steel colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "wobble",
        "bob",
        "pop"
      ],
      "note": "wobble = slight rock; bob = gentle lift; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "wobble"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
