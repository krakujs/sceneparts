{
  "id": "flat-vector/stock-trader",
  "type": "character",
  "style": "flat-vector",
  "name": "Stock Trader",
  "summary": "Flat vector stock trader in a shirt and tie holding a tablet with a rising chart; for markets and investing explainers.",
  "tags": [
    "stock trader",
    "trader",
    "stocks",
    "investing",
    "market",
    "finance",
    "tablet",
    "chart"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "hold",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "open",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "tan",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "side",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "blonde",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "shirtColor",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "shirt under a blazer or coat"
    },
    {
      "name": "hatColor",
      "type": "colour",
      "default": "#E8503F",
      "note": "also colours goggles and headphones"
    },
    {
      "name": "propColor",
      "type": "colour",
      "default": "#FF8A3D"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "hold",
    "skin": "tan",
    "hair": "side",
    "hairColor": "blonde"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
