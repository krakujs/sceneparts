{
  "id": "flat-vector/alien-visitor",
  "type": "character",
  "style": "flat-vector",
  "name": "Alien visitor",
  "summary": "Original friendly flat vector alien with three eyes, a round mint body and a wave; for space and first-contact stories.",
  "tags": [
    "alien",
    "visitor",
    "space",
    "friendly",
    "cartoon",
    "extraterrestrial",
    "sci-fi",
    "creature"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
