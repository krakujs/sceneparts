{
  "id": "flat-vector/church",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Church",
  "summary": "Small generic church with a steeple, arched windows and a simple cross; anim lights glows the windows.",
  "tags": [
    "church",
    "chapel",
    "steeple",
    "cross",
    "religion",
    "building",
    "village",
    "arch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 680 px wide and 1290 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F7F1E3",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#7B5CD6",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim lights = the arched windows glow in turn"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
