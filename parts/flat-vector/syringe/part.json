{
  "id": "flat-vector/syringe",
  "type": "prop",
  "style": "flat-vector",
  "name": "Syringe",
  "summary": "Medical syringe with barrel, plunger, needle and liquid; use for injection, vaccine or medicine scenes.",
  "tags": [
    "syringe",
    "injection",
    "needle",
    "medical",
    "vaccine",
    "medicine",
    "doctor"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size: at s = 1 about 740 px wide; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "liquid colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "push"
      ],
      "note": "push = the plunger slides in and a drop forms at the needle"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#1FA39A",
    "anim": "push"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
