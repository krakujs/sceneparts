{
  "id": "flat-vector/gym",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Gym",
  "summary": "Gym building with a large glass front showing a dumbbell icon; anim lights makes the glass pulse.",
  "tags": [
    "gym",
    "fitness",
    "sport",
    "workout",
    "dumbbell",
    "exercise",
    "building",
    "training"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 840 px wide and 690 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E4F1EA",
      "note": "main wall / body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "roof and accent colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "anim lights = the glass front lights up and pulses"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
