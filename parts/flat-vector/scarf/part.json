{
  "id": "flat-vector/scarf",
  "type": "prop",
  "style": "flat-vector",
  "name": "Scarf",
  "summary": "Knitted scarf looped over the top with two striped, fringed ends; sways gently. For winter and cold-weather scenes.",
  "tags": [
    "scarf",
    "knitted scarf",
    "winter scarf",
    "muffler",
    "wool",
    "winter",
    "cold weather",
    "neck warmer"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom: the item rests on y (hem or tip)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 420 px wide and 615 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "wool colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "stripe colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sway"
      ],
      "note": "sway = the hanging ends swing gently"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E8503F",
    "color2": "#FFFFFF",
    "anim": "sway"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
