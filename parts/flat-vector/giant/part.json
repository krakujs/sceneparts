{
  "id": "flat-vector/giant",
  "type": "character",
  "style": "flat-vector",
  "name": "Giant",
  "summary": "Flat vector huge friendly giant, about 1300 px tall, in a patched tunic with rope belt, holding a club; for fairy tales.",
  "tags": [
    "giant",
    "huge",
    "fairy tale",
    "club",
    "friendly",
    "big",
    "tunic",
    "fantasy"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1300 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "laugh",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "medium",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "pose": "stand",
    "expression": "laugh"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
