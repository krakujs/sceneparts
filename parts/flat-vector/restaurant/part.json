{
  "id": "flat-vector/restaurant",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Restaurant",
  "summary": "Restaurant front with a striped awning, big windows, outdoor table and fork-and-knife sign; anim lights glows lamps.",
  "tags": [
    "restaurant",
    "diner",
    "eatery",
    "food",
    "dining",
    "shop front",
    "cafe"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the building stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 900 px wide and 780 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "wall colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#E8503F",
      "note": "awning and sign colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "lights"
      ],
      "note": "pop = scales in; lights = window lamps glow one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "lights"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}