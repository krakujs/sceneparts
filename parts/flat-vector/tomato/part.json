{
  "id": "flat-vector/tomato",
  "type": "prop",
  "style": "flat-vector",
  "name": "Tomato",
  "summary": "Round red tomato with a green star calyx; for salads, kitchen and vegetable scenes.",
  "tags": [
    "tomato",
    "red vegetable",
    "vegetable",
    "food",
    "salad"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (~350 px wide); use about 0.2-0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "skin colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "bounce",
        "roll",
        "pop"
      ],
      "note": "bob = gentle up and down, wobble = rock on its base, bounce = drop in, roll = roll in from the left, pop = scale in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E8503F"
  },
  "uses": [
    "flat-vector/fruit",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
