{
  "id": "flat-vector/lightbulb-moment",
  "type": "effect",
  "style": "flat-vector",
  "name": "Lightbulb Moment",
  "summary": "Flat glowing light bulb with flickering rays for an idea, eureka or insight moment.",
  "tags": ["idea", "eureka", "insight", "lightbulb", "bright", "think", "sticker"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; about 300 px wide at s = 1" },
    { "name": "color", "type": "colour", "default": "#FFC83D", "note": "bulb colour; one darker shade is added for depth" },
    { "name": "anim", "type": "enum", "default": "flicker", "values": ["none", "flicker", "bob", "pulse"], "note": "idle motion from p.f" },
    { "name": "popIn", "type": "boolean", "default": true, "note": "springs in over the first 10 frames" },
    { "name": "flip", "type": "boolean", "default": false, "note": "mirror left-right" }
  ],
  "example": { "x": 540, "y": 960, "anim": "flicker" },
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
