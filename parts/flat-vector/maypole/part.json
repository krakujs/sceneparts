{
  "id": "flat-vector/maypole",
  "type": "scenery",
  "style": "flat-vector",
  "name": "Maypole",
  "summary": "Tall maypole with a flower crown on top and six ribbons streaming down to the ground; for spring festival scenes.",
  "tags": [
    "maypole",
    "may pole",
    "ribbons",
    "spring festival",
    "village green",
    "dance",
    "may day"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "floor line: the base stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 720 px wide and 1080 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "pole colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#F27BA6",
      "note": "flower crown colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sway",
        "pop"
      ],
      "note": "sway = the ribbons flutter in the breeze; pop = settles in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "color": "#8A5A3C",
    "color2": "#F27BA6",
    "anim": "pop"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
