{
  "id": "flat-vector/designer",
  "type": "character",
  "style": "flat-vector",
  "name": "Designer",
  "summary": "Flat vector designer in a beret and t-shirt drawing on a tablet with a stylus; for graphic, UX and creative explainers.",
  "tags": ["designer", "design", "graphic design", "ux", "creative", "artist", "illustrator", "person"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1560, "note": "feet" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~1000 px tall at 1" },
    { "name": "pose", "type": "enum", "default": "hold", "values": ["stand", "walk", "run", "wave", "point", "think", "cheer", "talk", "sit", "hold"] },
    { "name": "expression", "type": "enum", "default": "smile", "values": ["smile", "neutral", "open", "surprised", "sad", "angry", "laugh"] },
    { "name": "skin", "type": "string", "default": "brown", "note": "light | fair | tan | medium | brown | dark, or a hex colour" },
    { "name": "hair", "type": "enum", "default": "bob", "values": ["short", "buzz", "side", "spiky", "curly", "afro", "long", "ponytail", "bun", "bob", "braid", "none"] },
    { "name": "hairColor", "type": "string", "default": "pink", "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex" },
    { "name": "seat", "type": "boolean", "default": true, "note": "draw a bench when pose is sit" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1560, "pose": "hold", "skin": "brown", "hair": "bob", "hairColor": "pink" },
  "uses": ["flat-vector/person", "flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
