{
  "id": "flat-vector/professor",
  "type": "character",
  "style": "flat-vector",
  "name": "Professor",
  "summary": "Flat vector professor in a tweed blazer and bow tie with a book; for university, academic and research explainers.",
  "tags": ["professor", "academic", "university", "college", "lecturer", "scholar", "research", "person"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1560, "note": "feet" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~1000 px tall at 1" },
    { "name": "pose", "type": "enum", "default": "talk", "values": ["stand", "walk", "run", "wave", "point", "think", "cheer", "talk", "sit", "hold"] },
    { "name": "expression", "type": "enum", "default": "open", "values": ["smile", "neutral", "open", "surprised", "sad", "angry", "laugh"] },
    { "name": "skin", "type": "string", "default": "light", "note": "light | fair | tan | medium | brown | dark, or a hex colour" },
    { "name": "hair", "type": "enum", "default": "none", "values": ["short", "buzz", "side", "spiky", "curly", "afro", "long", "ponytail", "bun", "bob", "braid", "none"] },
    { "name": "hairColor", "type": "string", "default": "grey", "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex" },
    { "name": "accessory", "type": "enum", "default": "beard", "values": ["none", "glasses", "sunglasses", "goggles", "mask", "beard", "moustache", "stubble", "headset", "headphones", "earrings"] },
    { "name": "seat", "type": "boolean", "default": true, "note": "draw a bench when pose is sit" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1560, "pose": "talk", "skin": "light", "hair": "none", "hairColor": "grey", "accessory": "beard" },
  "uses": ["flat-vector/person", "flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
