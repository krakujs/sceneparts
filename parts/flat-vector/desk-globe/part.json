{
  "id": "flat-vector/desk-globe",
  "type": "prop",
  "style": "flat-vector",
  "name": "Desk globe",
  "summary": "World globe on a round stand with a brass meridian arc; use for geography, travel or world-map scenes.",
  "tags": [
    "globe",
    "world",
    "earth",
    "geography",
    "desk globe",
    "map",
    "planet"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size: at s = 1 about 480 px wide and 760 px tall; use about 0.2\u20130.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "ocean colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#4BB46A",
      "note": "land colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "spin"
      ],
      "note": "spin = the globe turns on its axis"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#3D6FE0",
    "color2": "#4BB46A",
    "anim": "spin"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
