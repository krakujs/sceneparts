{
  "id": "flat-vector/notebook",
  "type": "prop",
  "style": "flat-vector",
  "name": "Spiral notebook",
  "summary": "Spiral-bound notebook with ruled pages and an optional clipped pen; for school, notes and planning.",
  "tags": [
    "notebook",
    "spiral notebook",
    "notepad",
    "notes",
    "school",
    "exercise book",
    "journal"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the base rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: at s = 1 about 360 px wide and 480 px tall; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "cover colour"
    },
    {
      "name": "pen",
      "type": "boolean",
      "default": false,
      "note": "clip a ballpoint pen to the cover"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "pop = scales in with a small overshoot"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#1FA39A",
    "pen": true,
    "anim": "bob"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
