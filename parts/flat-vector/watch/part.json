{
  "id": "flat-vector/watch",
  "type": "prop",
  "style": "flat-vector",
  "name": "Watch",
  "summary": "Analogue wristwatch with a strap and round face; anim tick moves the hands. For time and schedule scenes.",
  "tags": [
    "watch",
    "wristwatch",
    "wrist watch",
    "analogue watch",
    "time",
    "clock",
    "accessory"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the end of the strap sits on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (about 600 px tall); use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "strap colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "tick",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "tick"
      ],
      "note": "tick = hands move, the second hand jumps once a second; the others are gentle motions"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#8A5A3C",
    "anim": "tick"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
