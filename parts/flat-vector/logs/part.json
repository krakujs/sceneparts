{
  "id": "flat-vector/logs",
  "type": "prop",
  "style": "flat-vector",
  "name": "Logs",
  "summary": "A few cut logs with growth rings on the ends; for camping, woodcutting, cabin and forest scenes.",
  "tags": ["logs", "log", "timber", "wood", "lumber", "firewood", "forest"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 1560, "note": "bottom centre: the logs rest on y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 560 px wide and 300 px tall; use about 0.4 next to a person"},
    {"name": "color", "type": "colour", "default": "#E9D3A9", "note": "cut-end wood colour"},
    {"name": "color2", "type": "colour", "default": "#8A5A3C", "note": "bark colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "bob", "wobble", "pop"], "note": "motion of the whole pile"},
    {"name": "flip", "type": "boolean", "default": false, "note": "mirror (cut ends then face left)"}
  ],
  "example": {"x": 540, "y": 1560, "s": 1},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
