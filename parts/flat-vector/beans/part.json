{
  "id": "flat-vector/beans",
  "type": "prop",
  "style": "flat-vector",
  "name": "Flat beans",
  "summary": "Flat heap of kidney beans, red, brown or black, with a green bean pod, for pulse and cooking scenes.",
  "tags": [
    "food",
    "vegetable",
    "beans",
    "kidney",
    "pulses",
    "cooking"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (~350 px wide); use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "enum",
      "default": "red",
      "values": [
        "red",
        "brown",
        "black"
      ],
      "note": "bean colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "bob = gentle up and down, wobble = rock on its base, pop = scale in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "red",
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
