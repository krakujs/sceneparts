{
  "id": "flat-vector/kimono",
  "type": "prop",
  "style": "flat-vector",
  "name": "Kimono",
  "summary": "T-shaped kimono robe with wide sleeves, a crossed collar, a wide obi sash and floral pattern, on a hanger.",
  "tags": [
    "kimono",
    "japanese robe",
    "robe",
    "obi",
    "yukata",
    "japanese clothing",
    "traditional"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the hem rests on y (the hanger hangs above it)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 600-700 px tall at s = 1; hero size"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#253058",
      "note": "main colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FF5A4A",
      "note": "obi sash and collar lining colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sway",
        "pop"
      ],
      "note": "sway = swings gently from the hanger hook; pop = small settle bounce"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#253058",
    "color2": "#FF5A4A",
    "anim": "pop"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
