{
  "id": "flat-vector/pill-bottle",
  "type": "prop",
  "style": "flat-vector",
  "name": "Pill bottle",
  "summary": "Orange medicine bottle with a white cap and blank label, with pills beside it; use for pharmacy or health scenes.",
  "tags": [
    "pill bottle",
    "medicine",
    "prescription",
    "pharmacy",
    "bottle",
    "pills",
    "health"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; hero size: at s = 1 about 620 px wide and 480 px tall; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FF8A3D",
      "note": "bottle colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "cap colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "pop = scales in with a small overshoot"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#FF8A3D",
    "color2": "#FFFFFF",
    "anim": "bob"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
