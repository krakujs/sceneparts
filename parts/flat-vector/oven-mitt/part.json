{
  "id": "flat-vector/oven-mitt",
  "type": "prop",
  "style": "flat-vector",
  "name": "Oven Mitt",
  "summary": "Quilted oven mitt standing on its cuff, with a thumb and hanging loop; for baking and hot-dish scenes.",
  "tags": [
    "oven mitt",
    "oven glove",
    "pot holder",
    "kitchen",
    "baking",
    "heat-proof",
    "cooking"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size; use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8503F",
      "note": "mitt colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFC83D",
      "note": "cuff colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#E8503F",
    "color2": "#FFC83D"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
