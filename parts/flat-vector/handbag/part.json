{
  "id": "flat-vector/handbag",
  "type": "prop",
  "style": "flat-vector",
  "name": "Handbag",
  "summary": "Generic shoulder handbag with a front flap, gold clasp and arched strap; for shopping and street scenes.",
  "tags": [
    "handbag",
    "purse",
    "shoulder bag",
    "bag",
    "fashion",
    "tote",
    "accessory"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the bag rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (about 430 px wide); use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#7B5CD6",
      "note": "bag colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#7B5CD6"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
