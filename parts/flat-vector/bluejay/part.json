{
  "id": "flat-vector/bluejay",
  "type": "character",
  "style": "flat-vector",
  "name": "Blue jay",
  "summary": "Flat vector blue jay with a blue back, white belly, crest tuft and barred wings; for woodland scenes.",
  "tags": [
    "blue jay",
    "bluejay",
    "crest",
    "songbird",
    "woodland",
    "bird"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet on the ground (perch line / water line for perch and swim)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "hop",
        "peck",
        "perch",
        "fly",
        "glide",
        "swim",
        "idle"
      ],
      "note": "perch = sitting, legs tucked; fly = wings flap, lifted by alt; swim = floating, no legs; idle = breathing + head turn"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D7FE0",
      "note": "body and head colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame drift"
    },
    {
      "name": "alt",
      "type": "number",
      "default": 120,
      "note": "fly height px above y"
    },
    {
      "name": "wingspan",
      "type": "number",
      "default": 140,
      "note": "wing span px (fly and glide)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "stand"
  },
  "uses": [
    "flat-vector/bird",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
