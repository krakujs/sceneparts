{
  "id": "flat-vector/pineapple",
  "type": "prop",
  "style": "flat-vector",
  "name": "Flat pineapple",
  "summary": "Flat pineapple with a diamond-pattern golden body and spiky green crown, for tropical fruit scenes.",
  "tags": [
    "food",
    "fruit",
    "pineapple",
    "tropical",
    "yellow",
    "summer"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 the item is hero size (~350 px wide); use about 0.2–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F2B134",
      "note": "body colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "bob = gentle up and down, wobble = rock on its base, pop = scale in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#F2B134",
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
