{
  "id": "flat-vector/rabbi",
  "type": "character",
  "style": "flat-vector",
  "name": "Rabbi",
  "summary": "Flat vector rabbi in a dark suit with kippah and beard, holding a book; for faith and community explainers.",
  "tags": [
    "rabbi",
    "judaism",
    "jewish",
    "synagogue",
    "kippah",
    "religion",
    "faith",
    "person"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "smile",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "light",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "short",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "grey",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "shoes",
      "type": "enum",
      "default": "shoes",
      "values": [
        "shoes",
        "sneakers",
        "boots",
        "heels",
        "sandals"
      ]
    },
    {
      "name": "shoesColor",
      "type": "colour",
      "default": "#1F2433"
    },
    {
      "name": "prop",
      "type": "enum",
      "default": "book",
      "values": [
        "none",
        "phone",
        "tablet",
        "laptop",
        "clipboard",
        "book",
        "mug",
        "briefcase",
        "bag",
        "toolbox",
        "wrench",
        "hammer",
        "mic",
        "camera",
        "box",
        "paper",
        "pen",
        "broom",
        "umbrella",
        "tray",
        "pointer"
      ]
    },
    {
      "name": "propColor",
      "type": "colour",
      "default": "#8A5A3C"
    },
    {
      "name": "seat",
      "type": "boolean",
      "default": true,
      "note": "draw a bench when pose is sit"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "talk",
    "skin": "light",
    "hair": "short",
    "hairColor": "grey"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
