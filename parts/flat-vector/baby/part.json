{
  "id": "flat-vector/baby",
  "type": "character",
  "style": "flat-vector",
  "name": "Baby",
  "summary": "Flat vector baby in a onesie, sitting with a gentle bob; for parenting, family and nursery explainers.",
  "tags": [
    "baby",
    "infant",
    "newborn",
    "child",
    "family",
    "nursery",
    "seated"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~260 px tall at 1"
    },
    {
      "name": "skin",
      "type": "string",
      "default": "light",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "onesie",
      "type": "colour",
      "default": "#1FA39A",
      "note": "onesie colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "skin": "light",
    "onesie": "#FFC83D"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
