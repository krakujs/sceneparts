  "name": "Griffin",
  "summary": "Mythical griffin with an eagle head, feathered wings and talons on a lion body. For fantasy and legend scenes.",
  "tags": [
    "griffin",
    "gryphon",
    "eagle",
    "lion",
    "wings",
    "myth",
    "fantasy",
    "creature"
