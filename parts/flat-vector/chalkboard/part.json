{
  "id": "flat-vector/chalkboard",
  "type": "prop",
  "style": "flat-vector",
  "name": "Chalkboard",
  "summary": "Green chalkboard in a wooden frame with a chalk tray and simple doodles, no words; anim draw sketches them.",
  "tags": [
    "chalkboard",
    "blackboard",
    "classroom",
    "school board",
    "chalk",
    "maths lesson",
    "teacher"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 760,
      "note": "wall item: centred on (x, y); default y = 760 is about eye height"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "at s = 1 about 660 px wide and 440 px tall"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3E7360",
      "note": "board colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "frame colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "draw"
      ],
      "note": "draw = the doodles appear one after another"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 760,
    "s": 1,
    "color": "#3E7360",
    "color2": "#8A5A3C",
    "anim": "draw"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
