{
  "id": "flat-vector/phone-addict",
  "type": "character",
  "style": "flat-vector",
  "name": "Phone addict",
  "summary": "Flat vector phone addict, eyes glued to a phone held up close; for screen time and digital habit explainers.",
  "tags": [
    "phone",
    "smartphone",
    "screen time",
    "addiction",
    "scrolling",
    "mobile",
    "distracted",
    "social media"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~1000 px tall at 1"
    },
    {
      "name": "age",
      "type": "enum",
      "default": "adult",
      "values": [
        "adult",
        "teen",
        "child",
        "toddler",
        "elder"
      ],
      "note": "teen/child/toddler: smaller with a bigger head; elder: slight stoop"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "hold",
      "values": [
        "stand",
        "walk",
        "run",
        "wave",
        "point",
        "think",
        "cheer",
        "talk",
        "sit",
        "hold"
      ]
    },
    {
      "name": "expression",
      "type": "enum",
      "default": "neutral",
      "values": [
        "smile",
        "neutral",
        "open",
        "surprised",
        "sad",
        "angry",
        "laugh"
      ]
    },
    {
      "name": "skin",
      "type": "string",
      "default": "fair",
      "note": "light | fair | tan | medium | brown | dark, or a hex colour"
    },
    {
      "name": "hair",
      "type": "enum",
      "default": "short",
      "values": [
        "short",
        "buzz",
        "side",
        "spiky",
        "curly",
        "afro",
        "long",
        "ponytail",
        "bun",
        "bob",
        "braid",
        "none"
      ]
    },
    {
      "name": "hairColor",
      "type": "string",
      "default": "brown",
      "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex"
    },
    {
      "name": "accessory",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "glasses",
        "sunglasses",
        "goggles",
        "mask",
        "beard",
        "moustache",
        "stubble",
        "headset",
        "headphones",
        "earrings"
      ]
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "skin": "tan",
    "hair": "bob"
  },
  "uses": [
    "flat-vector/person",
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
