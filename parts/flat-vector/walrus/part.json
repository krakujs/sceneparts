{
  "id": "flat-vector/walrus",
  "type": "character",
  "style": "flat-vector",
  "name": "Walrus",
  "summary": "Flat vector big brown walrus lying on the ground with long white tusks and whiskers; rests and rocks.",
  "tags": [
    "walrus",
    "tusks",
    "arctic",
    "sea",
    "marine",
    "mammal",
    "whiskers"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1500,
      "note": "bottom centre (ground)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 600 px long at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "rest",
      "values": [
        "rest",
        "idle",
        "swim"
      ],
      "note": "rest = breathing only; idle = head bob; swim = body sway and flipper paddle"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1500,
    "pose": "rest"
  },
  "uses": [
    "flat-vector/style",
    "flat-vector/quadruped"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
