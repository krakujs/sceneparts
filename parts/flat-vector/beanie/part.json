{
  "id": "flat-vector/beanie",
  "type": "prop",
  "style": "flat-vector",
  "name": "Beanie",
  "summary": "Knitted beanie with a ribbed cuff and a pom-pom on top; the pom-pom sways. For winter, cold weather and casual looks.",
  "tags": [
    "beanie",
    "knit hat",
    "knitted hat",
    "winter hat",
    "toque",
    "pom pom",
    "bobble hat",
    "woolly hat"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom: the item rests on y (hem or tip)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 440 px wide and 420 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "hat colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFC83D",
      "note": "cuff and pom-pom colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "sway"
      ],
      "note": "sway = the pom-pom bounces gently on top"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#3D6FE0",
    "color2": "#FFC83D",
    "anim": "sway"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
