{
  "id": "flat-vector/power-generator",
  "type": "prop",
  "style": "flat-vector",
  "name": "Portable Generator",
  "summary": "Framed portable petrol generator on wheels with a fan, fuel tank, sockets and a dial; for power cuts, sites and camping.",
  "tags": ["generator", "power generator", "petrol generator", "portable generator", "power cut", "electricity", "site"],
  "params": [
