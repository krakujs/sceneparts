{
  "id": "flat-vector/judge",
  "type": "character",
  "style": "flat-vector",
  "name": "Judge",
  "summary": "Flat vector judge in a black robe with white collar and a wooden gavel; for courts, law and justice explainers.",
  "tags": ["judge", "court", "law", "justice", "gavel", "robe", "magistrate", "person"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1560, "note": "feet" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~1000 px tall at 1" },
    { "name": "pose", "type": "enum", "default": "hold", "values": ["stand", "walk", "run", "wave", "point", "think", "cheer", "talk", "sit", "hold"] },
    { "name": "expression", "type": "enum", "default": "neutral", "values": ["smile", "neutral", "open", "surprised", "sad", "angry", "laugh"] },
    { "name": "skin", "type": "string", "default": "light", "note": "light | fair | tan | medium | brown | dark, or a hex colour" },
    { "name": "hair", "type": "enum", "default": "bob", "values": ["short", "buzz", "side", "spiky", "curly", "afro", "long", "ponytail", "bun", "bob", "braid", "none"] },
    { "name": "hairColor", "type": "string", "default": "grey", "note": "black | brown | auburn | blonde | grey | white | red | blue | pink, or hex" },
    { "name": "seat", "type": "boolean", "default": true, "note": "draw a bench when pose is sit" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1560, "pose": "hold", "skin": "light", "hair": "bob", "hairColor": "grey" },
  "uses": ["flat-vector/person", "flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
