{
  "id": "flat-vector/acorn",
  "type": "prop",
  "style": "flat-vector",
  "name": "Acorn",
  "summary": "Brown acorn with a textured cap and stalk; use for autumn woodland, oak trees and forest-floor props.",
  "tags": [
    "acorn",
    "nut",
    "oak",
    "autumn",
    "forest",
    "brown",
    "seed"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "tip of the nut rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 about 240 px tall, hand-sized"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#D9A05B",
      "note": "nut colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop"
      ],
      "note": "pop = scales in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#D9A05B",
    "anim": "none"
  },
  "uses": [
    "flat-vector/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
