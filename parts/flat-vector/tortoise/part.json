    { "name": "color", "type": "colour", "default": "#9AA3B5", "note": "main colour" },
    { "name": "flip", "type": "boolean", "default": false, "note": "face left" },
    { "name": "vx", "type": "number", "default": 0, "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1560, "pose": "stand" },
  "uses": [
    "flat-vector/reptile",
    "flat-vector/style"
  ],
