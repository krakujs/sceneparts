{
  "id": "flat-vector/tortoise",
  "type": "character",
  "style": "flat-vector",
  "name": "Tortoise",
  "summary": "Flat vector tortoise with a tall domed brown shell, hex plates and stumpy grey legs; slow and friendly.",
  "tags": ["tortoise","turtle","shell","reptile","slow","brown","animal"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
