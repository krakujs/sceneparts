{
  "id": "flat-vector/moon",
  "type": "effect",
  "style": "flat-vector",
  "name": "Moon",
  "summary": "Full pale moon with soft craters and a warm glow for night-time scenes. Anim: float, glow, pop.",
  "tags": ["moon", "full moon", "night", "sky", "space", "lunar", "glow"],
  "params": [
    {"name": "x", "type": "number", "default": 540, "note": "centre x"},
    {"name": "y", "type": "number", "default": 500, "note": "centre y"},
    {"name": "s", "type": "number", "default": 1, "note": "scale; at s = 1 about 360 px across the disc, 520 px with the glow"},
    {"name": "color", "type": "colour", "default": "#EFE8C8", "note": "moon colour"},
    {"name": "anim", "type": "enum", "default": "none", "values": ["none", "float", "glow", "pop"], "note": "float = bobs gently; glow = halo breathes"}
  ],
  "example": {"x": 540, "y": 500, "s": 1, "color": "#EFE8C8", "anim": "glow"},
  "uses": ["flat-vector/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
