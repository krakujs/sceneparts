{
  "id": "egypt-tomb/jars",
  "type": "prop",
  "style": "egypt-tomb",
  "name": "Jars",
  "summary": "Grid of clay jars (rows x cols) for \"thousands of jars\" shots.",
  "tags": [
    "ancient egypt",
    "beer",
    "crowd",
    "egypt",
    "many",
    "storage",
    "thousands"
