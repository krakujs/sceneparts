{
  "id": "ink-sketch/pufferfish",
  "type": "character",
  "style": "ink-sketch",
  "name": "Pufferfish",
  "summary": "Ink sketch yellow-tan pufferfish, puffed round with spikes by default; y is body centre.",
  "tags": [
    "pufferfish",
    "fish",
    "sea",
    "reef",
    "spiky",
    "round",
    "marine",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "body centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1000,
      "note": "body centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "puffed",
      "values": [
        "swim",
        "idle",
        "dart",
        "puffed"
      ],
      "note": "swim = body wave and tail beat from p.f; idle = slow hover, fins flutter; dart = fast beat; puffed = inflated pufferfish, no wave"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E8C27A",
      "note": "body colour"
    },
    {
      "name": "bandColor",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "fill of vertical bands"
    },
    {
      "name": "bandEdge",
      "type": "colour",
      "default": "#1F2433",
      "note": "dark edge on each side of a band"
    },
    {
      "name": "bubbles",
      "type": "boolean",
      "default": false,
      "note": "bubbles rising from the mouth, from p.f"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1000,
    "pose": "puffed"
  },
  "uses": [
    "ink-sketch/fish",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}