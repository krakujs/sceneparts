{
  "id": "ink-sketch/rock",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Rock",
  "summary": "Ink sketch medium grey faceted rock, a single stone for rocky ground and garden scenes.",
  "tags": [
    "rock",
    "stone",
    "grey rock",
    "facets",
    "rocky ground",
    "landscape",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the part stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 300 px wide and 215 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "rock colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#787F8D",
      "note": "shade of the shaded facets"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop"
      ],
      "note": "pop = grows into place"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1
  },
  "uses": [
    "flat-vector/rock",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}