{
  "id": "ink-sketch/cactus",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Cactus",
  "summary": "Ink sketch tall saguaro-style desert cactus with two arms, ribs and spines, growing in the ground; use for deserts.",
  "tags": [
    "cactus",
    "saguaro",
    "desert",
    "spines",
    "plant",
