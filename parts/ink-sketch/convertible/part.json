{
  "id": "ink-sketch/convertible",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Convertible",
  "summary": "Ink sketch open-top convertible with the roof folded behind a windscreen, side view facing right.",
  "tags": [
    "convertible",
    "cabriolet",
    "open top",
    "roadster",
    "summer car",
    "vehicle",
    "road",
    "drive",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x at frame 0"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the tyres stand on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "room scale: about 740 px wide and 280 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#1FA39A",
      "note": "body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#DDE2EA",
      "note": "wheel rim colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "drive",
        "bob",
        "pop"
      ],
      "note": "drive = wheels spin and the body bounces (also on when vx is not 0)"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "horizontal speed in px per frame (negative = left; set flip too)"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror so the car faces left"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "drive"
  },
  "uses": [
    "flat-vector/convertible",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}