{
  "id": "ink-sketch/park",
  "type": "background",
  "style": "ink-sketch",
  "name": "Park",
  "summary": "Ink sketch park background: lawn, path, bench, lamp post, round trees, bushes and a pond with a fountain.",
  "tags": [
    "park",
    "garden",
    "lawn",
    "bench",
    "lamp post",
    "fountain",
    "city",
    "background",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "day",
      "values": [
        "day",
        "morning",
        "dusk",
        "night"
      ],
      "note": "lamp post glows at dusk and night"
    },
    {
      "name": "weather",
      "type": "enum",
      "default": "clear",
      "values": [
        "clear",
        "cloudy",
        "rain",
        "snow",
        "fog",
        "storm"
      ],
      "note": "sky tint and animated weather"
    },
    {
      "name": "fountain",
      "type": "boolean",
      "default": true,
      "note": "animated fountain spray in the pond"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "drift",
      "values": [
        "drift",
        "none"
      ],
      "note": "drift = fountain spray and trees move from p.f"
    }
  ],
  "example": {
    "time": "day",
    "weather": "clear",
    "fountain": true
  },
  "uses": [
    "flat-vector/park",
    "ink-sketch/style"
  ],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}