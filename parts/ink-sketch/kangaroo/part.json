{
  "id": "ink-sketch/kangaroo",
  "type": "character",
  "style": "ink-sketch",
  "name": "Kangaroo",
  "summary": "Ink sketch tan-red kangaroo standing tall on big hind feet with a thick tail, long ears and small arms; can hop.",
  "tags": [
    "kangaroo",
    "australia",
    "marsupial",
