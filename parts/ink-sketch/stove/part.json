{
  "id": "ink-sketch/stove",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Stove",
  "summary": "Ink sketch freestanding kitchen cooker with four burners, knobs and an oven window; anim flame lights the burners.",
  "tags": [
    "stove",
    "cooker",
    "range",
    "hob",
    "kitchen",
    "oven",
    "gas",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the cooker stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a ink-sketch person at s = 1 (about 520 px tall)"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#DDE2EA",
      "note": "cabinet colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop",
        "flame"
      ],
      "note": "flame = blue flames flicker on the burners"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#DDE2EA",
    "anim": "flame"
  },
  "uses": [
    "flat-vector/stove",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}