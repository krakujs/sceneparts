{
  "id": "ink-sketch/seagull",
  "type": "character",
  "style": "ink-sketch",
  "name": "Seagull",
  "summary": "Ink sketch white seagull with grey wings, black wing tips and a yellow red-spotted beak; flies by default, for coasts.",
  "tags": [
    "seagull",
    "gull",
    "seabird",
    "coast",
    "beach",
    "flying bird",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet on the ground (perch line / water line for perch and swim)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "fly",
      "values": [
        "stand",
        "walk",
        "hop",
        "peck",
        "perch",
        "fly",
        "glide",
        "swim",
        "idle"
      ],
      "note": "perch = sitting, legs tucked; fly = wings flap, lifted by alt; swim = floating, no legs; idle = breathing + head turn"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "body and head colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame drift"
    },
    {
      "name": "alt",
      "type": "number",
      "default": 180,
      "note": "fly height px above y"
    },
    {
      "name": "wingspan",
      "type": "number",
      "default": 240,
      "note": "wing span px (fly and glide)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "fly"
  },
  "uses": [
    "ink-sketch/bird",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}