{
  "id": "ink-sketch/palm-tree",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Palm tree",
  "summary": "Ink sketch slim curved palm with a ringed trunk, drooping fronds and coconuts; for beaches, tropical and holiday scenes.",
  "tags": [
    "palm tree",
    "palm",
    "coconut tree",
    "tropical",
    "beach",
    "fronds",
    "island",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x of the trunk base"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the trunk stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 640 px wide and 1300 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4BB46A",
      "note": "frond colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#D9B98C",
      "note": "trunk colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "sway"
      ],
      "note": "sway = fronds rustle in the breeze"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "sway"
  },
  "uses": [
    "flat-vector/palm-tree",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}