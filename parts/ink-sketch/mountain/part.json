{
  "id": "ink-sketch/mountain",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Mountain",
  "summary": "Ink sketch tall rocky mountain peak with a snow cap and a smaller peak beside it. For far and high landscapes.",
  "tags": [
    "mountain",
    "peak",
    "snow cap",
    "rocky",
    "alpine",
    "summit",
    "landscape",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the part stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 1000 px wide and 1060 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "rock colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "snow colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop"
      ],
      "note": "pop = grows into place"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1
  },
  "uses": [
    "flat-vector/mountain",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}