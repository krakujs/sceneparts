{
  "id": "ink-sketch/skull",
  "type": "effect",
  "style": "ink-sketch",
  "name": "Skull",
  "summary": "Ink sketch friendly cartoon skull with big round eye sockets and little teeth, for dead, so funny or spooky moments.",
  "tags": [
    "skull",
    "dead",
    "funny",
    "spooky",
    "halloween",
    "cute",
    "sticker",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 400 px wide at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F4F1EA",
      "note": "bone colour; one darker shade is added for depth"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "wobble",
      "values": [
        "none",
        "wobble",
        "bob"
      ],
      "note": "idle motion from p.f; wobble also blinks"
    },
    {
      "name": "popIn",
      "type": "boolean",
      "default": true,
      "note": "springs in over the first 10 frames"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror left-right"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "anim": "wobble"
  },
  "uses": [
    "flat-vector/skull",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}