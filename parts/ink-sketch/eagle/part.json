{
  "id": "ink-sketch/eagle",
  "type": "character",
  "style": "ink-sketch",
  "name": "Eagle",
  "summary": "Ink sketch dark brown eagle with a white head and tail, big yellow hook beak and yellow feet; for majestic sky scenes.",
  "tags": [
    "eagle",
    "bird of prey",
    "raptor",
    "sea eagle",
    "bald eagle",
    "bird",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet on the ground (perch line / water line for perch and swim)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "fly",
      "values": [
        "stand",
        "walk",
        "hop",
        "peck",
        "perch",
        "fly",
        "glide",
        "swim",
        "idle"
      ],
      "note": "perch = sitting, legs tucked; fly = wings flap, lifted by alt; swim = floating, no legs; idle = breathing + head turn"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4A2E1E",
      "note": "body and head colour"
    },
    {
      "name": "wingspan",
      "type": "number",
      "default": 300,
      "note": "wing span px (fly and glide)"
    },
    {
      "name": "alt",
      "type": "number",
      "default": 200,
      "note": "fly height px above y"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame drift"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "fly"
  },
  "uses": [
    "ink-sketch/bird",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}