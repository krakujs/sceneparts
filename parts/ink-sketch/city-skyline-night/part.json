{
  "id": "ink-sketch/city-skyline-night",
  "type": "background",
  "style": "ink-sketch",
  "name": "City skyline (night)",
  "summary": "Ink sketch city skyline background at night: lit windows, moon and stars, glowing river and lamp posts.",
  "tags": [
    "city",
    "skyline",
    "night",
    "buildings",
    "lit windows",
    "river",
    "urban",
    "background",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "night",
      "values": [
        "day",
        "morning",
        "dusk",
        "night"
      ],
      "note": "light of the day; lamps and windows glow at dusk and night"
    },
    {
      "name": "weather",
      "type": "enum",
      "default": "clear",
      "values": [
        "clear",
        "cloudy",
        "rain",
        "snow",
        "fog",
        "storm"
      ],
      "note": "sky and weather drawn over the scene"
    },
    {
      "name": "buildings",
      "type": "colour",
      "default": "#5B6E96",
      "note": "main building colour"
    },
    {
      "name": "river",
      "type": "boolean",
      "default": true,
      "note": "dark water with light reflections"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "drift",
      "values": [
        "drift",
        "none"
      ],
      "note": "drift = clouds, leaves, smoke and lights move from p.f"
    }
  ],
  "example": {
    "time": "night",
    "weather": "clear"
  },
  "uses": [
    "flat-vector/city-skyline-night",
    "ink-sketch/style"
  ],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}