{
  "id": "ink-sketch/bush",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Bush",
  "summary": "Ink sketch round leafy garden shrub about 400 px tall; use along paths, walls and gardens, or in front of trees.",
  "tags": [
    "bush",
    "shrub",
    "bushes",
    "garden",
    "leafy",
    "hedge plant",
    "greenery",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the bush sits on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 560 px wide and 400 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#4BB46A",
      "note": "leaf colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop",
        "sway"
      ],
      "note": "sway = leaves rustle gently"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1,
    "anim": "sway"
  },
  "uses": [
    "flat-vector/bush",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}