{
  "id": "ink-sketch/wallaby",
  "type": "character",
  "style": "ink-sketch",
  "name": "Wallaby",
  "summary": "Ink sketch grey-brown wallaby, a smaller kangaroo relative with darker paws; stands upright or hops.",
  "tags": [
    "wallaby",
    "kangaroo",
    "marsupial",
    "australia",
