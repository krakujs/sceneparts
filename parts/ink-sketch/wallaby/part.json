    "hop",
    "mammal",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet (bottom centre)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about 450 px tall at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "hop"
