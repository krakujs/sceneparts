{
  "id": "ink-sketch/wardrobe",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Wardrobe",
  "summary": "Ink sketch tall two-door wardrobe, closed or open to show hanging clothes. For bedrooms and dressing scenes.",
  "tags": [
    "wardrobe",
    "closet",
    "armoire",
    "bedroom",
    "clothes",
    "furniture",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a ink-sketch person at s = 1"
    },
    {
      "name": "variant",
      "type": "enum",
      "default": "closed",
      "values": [
        "closed",
        "open"
      ],
      "note": "closed = two doors; open = doors swung back, clothes on a rail"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#E9D3A9",
      "note": "wardrobe colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "variant": "closed",
    "color": "#E9D3A9"
  },
  "uses": [
    "flat-vector/wardrobe",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}