{
  "id": "ink-sketch/cave",
  "type": "scenery",
  "style": "ink-sketch",
  "name": "Cave",
  "summary": "Ink sketch rocky mound with a dark arched cave mouth. For hideouts, hillsides and adventure scenes.",
  "tags": [
    "cave",
    "cavern",
    "cave mouth",
    "rock",
    "mound",
    "hideout",
    "adventure",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "ground line: the part stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "about 960 px wide and 430 px tall at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "rock colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#5D6578",
      "note": "arch and rubble colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "pop"
      ],
      "note": "pop = grows into place"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1
  },
  "uses": [
    "flat-vector/cave",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}