{
  "id": "ink-sketch/hand-saw",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Hand saw",
  "summary": "Ink sketch wood hand saw lying on the floor with a wooden handle and toothed steel blade.",
  "tags": [
    "hand saw",
    "handsaw",
    "wood saw",
    "saw",
    "carpentry",
    "woodwork",
    "tool",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 480 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "handle colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#9AA3B5",
      "note": "blade colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "saw",
        "bob",
        "pop"
      ],
      "note": "saw = blade slides back and forth; pop = pops in; bob = gentle lift"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "saw"
  },
  "uses": [
    "flat-vector/hand-saw",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}