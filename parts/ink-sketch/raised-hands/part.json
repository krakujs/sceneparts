{
  "id": "ink-sketch/raised-hands",
  "type": "effect",
  "style": "ink-sketch",
  "name": "Raised Hands",
  "summary": "Ink sketch die-cut two hands raised in celebration with sparkles, for hooray, win, party, we did it.",
  "tags": [
    "celebration",
    "hooray",
    "raised hands",
    "party",
    "win",
    "sparkle",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; about about 420 px wide at s = 1"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#FFC83D",
      "note": "hand colour; a SKIN name from the style (light, fair, tan, medium, brown, dark) or any hex"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "sleeve colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "sparkle",
      "values": [
        "none",
        "bob",
        "sparkle"
      ],
      "note": "idle motion from p.f"
    },
    {
      "name": "popIn",
      "type": "boolean",
      "default": true,
      "note": "springs in over the first 10 frames"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "anim": "sparkle"
  },
  "uses": [
    "flat-vector/raised-hands",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}