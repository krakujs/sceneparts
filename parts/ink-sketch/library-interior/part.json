{
  "id": "ink-sketch/library-interior",
  "type": "background",
  "style": "ink-sketch",
  "name": "Library interior",
  "summary": "Ink sketch library interior background: tall bookshelves of coloured books, reading table with lamp, step ladder.",
  "tags": [
    "library",
    "bookshelf",
    "books",
    "reading",
    "study",
    "interior",
    "background",
    "school",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "day",
      "values": [
        "day",
        "morning",
        "dusk",
        "night"
      ],
      "note": "room tint; the reading lamp and pendant lamp glow at dusk and night"
    },
    {
      "name": "wall",
      "type": "colour",
      "default": "#E9DDC7",
      "note": "wall colour"
    },
    {
      "name": "wood",
      "type": "colour",
      "default": "#8A5A3C",
      "note": "shelf and table wood colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "drift",
      "values": [
        "drift",
        "none"
      ],
      "note": "drift = dust motes float in the lamp light"
    }
  ],
  "example": {
    "time": "day",
    "wood": "#8A5A3C"
  },
  "uses": [
    "flat-vector/library-interior",
    "ink-sketch/style"
  ],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}