{
  "id": "ink-sketch/desert",
  "type": "background",
  "style": "ink-sketch",
  "name": "Desert",
  "summary": "Ink sketch desert background: layered dunes, a far mesa, heat haze, saguaro cacti and rocks under a bright sun.",
  "tags": [
    "desert",
    "dunes",
    "cactus",
    "sand",
    "heat",
    "hot",
    "background",
    "outdoor",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "day",
      "values": [
        "day",
        "morning",
        "dusk",
        "night"
      ],
      "note": "sun and sand light"
    },
    {
      "name": "weather",
      "type": "enum",
      "default": "clear",
      "values": [
        "clear",
        "cloudy",
        "rain",
        "snow",
        "fog",
        "storm"
      ],
      "note": "sky tint and animated weather (storm = dust storm feel)"
    },
    {
      "name": "sand",
      "type": "colour",
      "default": "#E9CB94",
      "note": "sand colour of the ground"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "drift",
      "values": [
        "drift",
        "none"
      ],
      "note": "drift = clouds and heat haze move from p.f"
    }
  ],
  "example": {
    "time": "day",
    "weather": "clear",
    "sand": "#E9CB94"
  },
  "uses": [
    "flat-vector/desert",
    "ink-sketch/style"
  ],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}