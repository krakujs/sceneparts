{
  "id": "ink-sketch/hammerhead-shark",
  "type": "character",
  "style": "ink-sketch",
  "name": "Hammerhead shark",
  "summary": "Ink sketch grey hammerhead shark with a wide T-shaped hammer head and tall dorsal fin; y is body centre.",
  "tags": [
    "hammerhead",
    "shark",
    "sea",
    "ocean",
    "predator",
    "marine",
    "fish",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "body centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1000,
      "note": "body centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; sizes below are px at s = 1"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "swim",
      "values": [
        "swim",
        "idle",
        "dart",
        "puffed"
      ],
      "note": "swim = body wave and tail beat from p.f; idle = slow hover, fins flutter; dart = fast beat; puffed = inflated pufferfish, no wave"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#7F8C9B",
      "note": "body colour"
    },
    {
      "name": "patternColor",
      "type": "colour",
      "default": "#B07A3C",
      "note": "colour of stripes, spots, speckles and scales"
    },
    {
      "name": "bandColor",
      "type": "colour",
      "default": "#FFFFFF",
      "note": "fill of vertical bands"
    },
    {
      "name": "bandEdge",
      "type": "colour",
      "default": "#1F2433",
      "note": "dark edge on each side of a band"
    },
    {
      "name": "spikes",
      "type": "boolean",
      "default": false,
      "note": "spines around the body (pufferfish)"
    },
    {
      "name": "bubbles",
      "type": "boolean",
      "default": false,
      "note": "bubbles rising from the mouth, from p.f"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1000,
    "pose": "swim"
  },
  "uses": [
    "ink-sketch/fish",
    "ink-sketch/style"
