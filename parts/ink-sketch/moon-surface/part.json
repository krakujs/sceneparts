{
  "id": "ink-sketch/moon-surface",
  "type": "background",
  "style": "ink-sketch",
  "name": "Moon surface",
  "summary": "Ink sketch moon surface background: grey cratered ground, black starry sky and a blue planet on the horizon.",
  "tags": [
    "moon",
    "space",
    "lunar",
    "craters",
    "night sky",
    "background",
    "astronaut",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
