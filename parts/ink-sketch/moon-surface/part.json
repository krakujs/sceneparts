      "values": [
        "day",
        "morning",
        "dusk",
        "night"
      ],
      "note": "the sky stays black; day and morning only make the ground a little brighter"
    },
    {
      "name": "ground",
      "type": "colour",
      "default": "#A7AEBB",
      "note": "grey regolith colour"
