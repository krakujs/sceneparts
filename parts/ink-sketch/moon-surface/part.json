    {
      "name": "anim",
      "type": "enum",
      "default": "drift",
      "values": [
        "drift",
        "none"
      ],
      "note": "drift = stars twinkle and the blue planet gently bobs"
    }
  ],
  "example": {
    "time": "night"
  },
  "uses": [
    "flat-vector/moon-surface",
    "ink-sketch/style"
