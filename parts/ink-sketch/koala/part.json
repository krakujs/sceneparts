{
  "id": "ink-sketch/koala",
  "type": "character",
  "style": "ink-sketch",
  "name": "Koala",
  "summary": "Ink sketch grey koala with big fluffy round ears and large dark nose, sitting; for Australian scenes.",
  "tags": [
    "koala",
    "australia",
    "marsupial",
    "animal",
    "zoo",
    "eucalyptus",
    "cute",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "pose",
      "type": "enum",
      "default": "stand",
      "values": [
        "stand",
        "walk",
        "run",
        "idle",
        "sit",
        "lie",
        "graze"
      ],
      "note": "idle = breathing + tail wag; graze = head down"
    },
    {
      "name": "mouth",
      "type": "enum",
      "default": "smile",
      "values": [
        "none",
        "smile",
        "open",
        "tongue"
      ]
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#A7ADB9",
      "note": "coat colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "pose": "sit"
  },
  "uses": [
    "ink-sketch/quadruped",
    "ink-sketch/style"
  ],
