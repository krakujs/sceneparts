{
  "id": "ink-sketch/wrench",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Wrench",
  "summary": "Ink sketch open-end spanner lying on the floor with a long handle and open jaw head; for mechanic.",
  "tags": [
    "wrench",
    "spanner",
    "open end wrench",
    "mechanic",
    "tool",
    "plumbing",
    "repair",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 460 px long at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#5D6578",
      "note": "steel colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "pop = pops in; bob = gentle lift; wobble = slight rock"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#5D6578",
    "anim": "none"
  },
  "uses": [
    "flat-vector/wrench",
