{
  "id": "ink-sketch/beach-day",
  "type": "background",
  "style": "ink-sketch",
  "name": "Beach (day)",
  "summary": "Ink sketch sunny beach background: sea horizon with gentle waves, sand, striped umbrella, towel and a palm.",
  "tags": [
    "beach",
