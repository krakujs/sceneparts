        "morning",
        "dusk",
        "night"
      ],
      "note": "daylight tint of sea and sand"
    },
    {
      "name": "weather",
      "type": "enum",
      "default": "clear",
      "values": [
        "clear",
        "cloudy",
        "rain",
        "snow",
