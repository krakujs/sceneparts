{
  "id": "ink-sketch/power-drill",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Power drill",
  "summary": "Ink sketch cordless power drill standing on its battery pack with a bit in the chuck; unbranded.",
  "tags": [
    "power drill",
    "cordless drill",
    "drill",
    "battery drill",
    "diy",
    "building",
    "tool",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "floor line: the item stands on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "hero size: about 480 px wide at s = 1; use about 0.25–0.3 next to a person"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#FFC83D",
      "note": "body colour"
    },
    {
      "name": "color2",
      "type": "colour",
      "default": "#3A4157",
      "note": "grip colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "spin",
        "bob",
        "pop"
      ],
      "note": "spin = the bit flutes turn; bob = gentle lift; pop = pops in"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror (faces left)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "anim": "spin"
  },
  "uses": [
    "flat-vector/power-drill",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}