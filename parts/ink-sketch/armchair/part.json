{
  "id": "ink-sketch/armchair",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Armchair",
  "summary": "Ink sketch single cosy armchair with rounded arms and a seat cushion; colour sets the upholstery. For living rooms.",
  "tags": [
    "armchair",
    "chair",
    "cosy",
    "living room",
    "reading chair",
    "furniture",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a ink-sketch person at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#F27BA6",
      "note": "upholstery colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#F27BA6"
  },
  "uses": [
    "flat-vector/armchair",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}