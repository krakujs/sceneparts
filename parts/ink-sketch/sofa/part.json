{
  "id": "ink-sketch/sofa",
  "type": "prop",
  "style": "ink-sketch",
  "name": "Sofa",
  "summary": "Ink sketch three-seat sofa with rounded arms, two seat cushions and short legs; colour sets the upholstery.",
  "tags": [
    "sofa",
    "couch",
    "living room",
    "furniture",
    "settee",
    "lounge",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1560,
      "note": "bottom centre: the item rests on y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; at s = 1 matches a ink-sketch person at s = 1"
    },
    {
      "name": "color",
      "type": "colour",
      "default": "#3D6FE0",
      "note": "upholstery colour"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "wobble",
        "pop"
      ],
      "note": "motion only; driven by the frame"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror"
    }
  ],
  "example": {
    "x": 540,
    "y": 1560,
    "s": 1,
    "color": "#3D6FE0"
  },
  "uses": [
    "flat-vector/sofa",
    "ink-sketch/style"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}