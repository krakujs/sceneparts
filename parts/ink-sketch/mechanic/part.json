{
  "id": "ink-sketch/mechanic",
  "type": "character",
  "style": "ink-sketch",
  "name": "Mechanic",
  "summary": "Ink-sketch mechanic in blue overalls and a cap, holding a wrench; for garage and car repair scenes.",
  "tags": [
    "mechanic",
    "garage",
    "car",
    "repair",
    "wrench",
    "workshop",
    "ink",
    "sketch"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; adult ≈ 980 px tall at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "anim",
      "type": "enum",
      "values": [
        "idle",
        "walk",
        "run",
        "wave",
        "cheer",
        "jump",
        "talk",
        "none"
      ],
      "default": "idle",
      "note": "idle breathes and blinks; walk/run swing; wave raises the front hand"
    },
    {
      "name": "arms",
      "type": "enum",
      "values": [
        "down",
        "up",
        "one-up"
      ],
      "default": "down",
      "note": "arm pose when anim does not set one"
    },
    {
      "name": "pose",
      "type": "enum",
      "values": [
        "stand",
        "sit"
      ],
      "default": "stand",
      "note": "sit bends the legs forward (a seat also sets it)"
    },
    {
      "name": "seat",
      "type": "enum",
      "values": [
        "none",
        "chair",
        "wheelchair"
      ],
      "default": "none",
      "note": "draw a seat under a sitting person"
    },
    {
      "name": "glasses",
      "type": "enum",
      "values": [
        "none",
        "glasses",
        "shades",
        "goggles",
        "eyepatch"
      ],
      "default": "none",
      "note": "eyewear"
    },
    {
      "name": "eyes",
      "type": "enum",
      "values": [
        "open",
        "happy",
        "closed"
      ],
      "default": "open",
      "note": "eye shape"
    },
    {
      "name": "mouth",
      "type": "enum",
      "values": [
        "smile",
        "flat",
        "open",
        "frown",
        "mask"
      ],
      "default": "smile",
      "note": "mouth; mask = face mask; anim talk opens it"
    },
    {
      "name": "blush",
      "type": "boolean",
      "default": false,
      "note": "pink cheeks"
    },
    {
      "name": "inner",
      "type": "colour",
      "default": "#f7f2e7",
      "note": "shirt under a jacket, collar, overall shirt"
    },
    {
      "name": "legs",
      "type": "enum",
      "values": [
        "trousers",
        "shorts",
        "skirt",
        "none"
      ],
      "default": "trousers",
      "note": "lower garment; ignored under dress/gown/robe"
    },
    {
      "name": "legsColour",
      "type": "colour",
      "default": "navy",
      "note": "trousers / shorts / skirt / overall colour"
    },
    {
      "name": "shoeStyle",
      "type": "enum",
      "values": [
        "shoes",
        "boots",
        "sneakers",
        "bare"
      ],
      "default": "shoes",
      "note": "footwear"
    },
    {
      "name": "shoes",
      "type": "colour",
      "default": "#3a2a22",
      "note": "shoe colour"
    },
    {
      "name": "over",
      "type": "enum",
      "values": [
        "none",
        "apron",
        "hivis",
        "vest",
        "sash",
        "lifejacket"
      ],
      "default": "none",
      "note": "garment over the top"
    },
    {
      "name": "overColour",
      "type": "colour",
      "default": "yellow",
      "note": "overlay colour"
    },
    {
      "name": "neck",
      "type": "enum",
      "values": [
        "none",
        "tie",
        "bowtie",
        "stethoscope",
        "lanyard",
        "scarf",
        "medal",
        "necklace",
        "whistle",
        "cameraneck",
        "pearls"
      ],
      "default": "none",
      "note": "neckwear"
    },
    {
      "name": "neckColour",
      "type": "colour",
      "default": "red",
      "note": "tie, bow tie, scarf, lanyard colour"
    },
    {
      "name": "belt",
      "type": "boolean",
      "default": false,
      "note": "belt with a buckle"
    },
    {
      "name": "back",
      "type": "enum",
      "values": [
        "none",
        "backpack",
        "cape",
        "wings",
        "tank",
        "guitar",
        "quiver"
      ],
      "default": "none",
      "note": "gear behind the body"
    },
    {
      "name": "backColour",
      "type": "colour",
      "default": "red",
      "note": "backpack / cape / wings colour (uses itemColour if not set)"
    },
    {
      "name": "belly",
      "type": "boolean",
      "default": false,
      "note": "rounded belly"
    },
    {
      "name": "wash",
      "type": "enum",
      "values": [
        "colour",
        "accent",
        "none"
      ],
      "default": "colour",
      "note": "colour: garments washed in their colours; accent: only the top gets the accent; none: pure line art"
    },
    {
      "name": "extra",
      "type": "object",
      "note": "array of overlays {d (SVG path), fill?, at: head|body|hand, back?}; see ANCHOR"
    },
    {
      "name": "vx",
      "type": "number",
      "default": 0,
      "note": "px per frame drift (pair with walk)"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "anim": "idle"
  },
  "uses": [
    "ink-sketch/person"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
