{
  "id": "pixel-art/lettuce",
  "type": "prop",
  "style": "pixel-art",
  "name": "Lettuce",
  "summary": "Pixel-art head of lettuce with frilly layered leaves and pale veins; for food, salad, garden and healthy-eating scenes.",
  "tags": [
    "lettuce",
    "salad",
    "vegetable",
    "greens",
    "food",
    "healthy",
    "garden",
    "pixel art"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "bottom of the item (centre when centre = true)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror horizontally"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "whole-sprite motion; float/bob suit pickups"
    },
    {
      "name": "centre",
      "type": "boolean",
      "default": false,
      "note": "anchor on the centre instead of the bottom"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift"
    },
    {
      "name": "colour",
      "type": "colour",
      "default": "#6cc04a",
      "note": "leaf colour (char a)"
    },
    {
      "name": "colour2",
      "type": "colour",
      "default": "#3f8a35",
      "note": "shade colour (char A)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#f7d154\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1300,
    "s": 2
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}