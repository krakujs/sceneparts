{
  "id": "pixel-art/owl",
  "type": "character",
  "style": "pixel-art",
  "name": "Owl",
  "summary": "Pixel-art brown owl, upright with a round face disc, big eyes and ear tufts; for night and forest scenes.",
  "tags": [
    "owl",
    "bird",
    "night bird",
    "forest",
    "pixel",
    "pixel art",
    "retro"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 2.0,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "walk",
      "values": [
        "walk",
        "run",
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "walk/run swap leg cels; others move the whole sprite"
    },
    {
      "name": "fps",
      "type": "number",
      "default": 8,
      "note": "video frames per cel"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift (pair with walk or fly)"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#8a5a33",
      "note": "main coat colour (char a)"
    },
    {
      "name": "coat2",
      "type": "colour",
      "default": "#4f3420",
      "note": "shade colour (char A): wings, ears, legs, tail"
    },
    {
      "name": "accent",
      "type": "colour",
      "default": "#e6c78a",
      "note": "accent colour (char z): patches, crest, head or chest"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"k\": \"#000000\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 2.0,
    "anim": "walk"
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
