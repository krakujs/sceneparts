{
  "id": "pixel-art/stool",
  "type": "prop",
  "style": "pixel-art",
  "name": "Stool",
  "summary": "Pixel-art round bar stool with a seat, legs and a footrest ring; for cafe, bar and kitchen scenes.",
  "tags": [
    "stool",
    "bar stool",
    "chair",
    "furniture",
    "cafe",
    "pixel",
    "pixel art"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "bottom of the item (centre when centre = true)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror horizontally"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "whole-sprite motion; float/bob suit pickups"
    },
    {
      "name": "centre",
      "type": "boolean",
      "default": false,
      "note": "anchor on the centre instead of the bottom"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift"
    },
    {
      "name": "colour",
      "type": "colour",
      "default": "#d9a35f",
      "note": "main colour (char a), e.g. #d9a35f"
    },
    {
      "name": "colour2",
      "type": "colour",
      "default": "#8a5a36",
      "note": "shade colour (char A)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#5a6170\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1.5
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
