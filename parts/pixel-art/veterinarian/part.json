{
  "id": "pixel-art/veterinarian",
  "type": "character",
  "style": "pixel-art",
  "name": "Veterinarian",
  "summary": "Pixel-art veterinarian in teal scrubs with a stethoscope and a small dog at the feet; for animal clinic scenes.",
  "tags": [
    "veterinarian",
    "vet",
    "animal",
    "pet",
    "clinic",
    "dog",
    "medical",
    "pixel",
    "people"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; adult ≈ 980 px tall at s = 1 (24 px cells)"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "build",
      "type": "enum",
      "values": [
        "adult",
        "teen",
        "child",
        "toddler"
      ],
      "default": "adult",
      "note": "body proportions"
    },
    {
      "name": "anim",
      "type": "enum",
      "values": [
        "idle",
        "walk",
        "run",
        "wave",
        "cheer",
        "jump",
        "talk",
        "none"
      ],
      "default": "idle",
      "note": "idle blinks; walk/run swing legs and arms; wave raises the front hand"
    },
    {
      "name": "arms",
      "type": "enum",
      "values": [
        "down",
        "up",
        "one-up"
      ],
      "default": "down",
      "note": "arm pose when anim does not set one"
    },
    {
      "name": "pose",
      "type": "enum",
      "values": [
        "stand",
        "sit"
      ],
      "default": "stand",
      "note": "sit bends the legs forward (seat sets it too)"
    },
    {
      "name": "seat",
      "type": "enum",
      "values": [
        "none",
        "chair",
        "wheelchair"
      ],
      "default": "none",
      "note": "draw a seat under a sitting person"
    },
    {
      "name": "beard",
      "type": "enum",
      "values": [
        "none",
        "beard",
        "moustache",
        "goatee",
        "stubble"
      ],
      "default": "none",
      "note": "facial hair"
    },
    {
      "name": "glasses",
      "type": "enum",
      "values": [
        "none",
        "glasses",
        "shades",
        "goggles",
        "eyepatch"
      ],
      "default": "none",
      "note": "eyewear"
    },
    {
      "name": "eyes",
      "type": "enum",
      "values": [
        "open",
        "happy",
        "closed"
      ],
      "default": "open",
      "note": "eyes look right"
    },
    {
      "name": "mouth",
      "type": "enum",
      "values": [
        "smile",
        "flat",
        "open",
        "frown",
        "mask"
      ],
      "default": "smile",
      "note": "mouth; mask = face mask"
    },
    {
      "name": "blush",
      "type": "boolean",
      "default": false,
      "note": "pink cheeks"
    },
    {
      "name": "hat",
      "type": "enum",
      "values": [
        "none",
        "cap",
        "hardhat",
        "minerhat",
        "beanie",
        "chef",
        "peaked",
