        "wings",
        "tank",
        "guitar",
        "quiver"
      ],
      "default": "none",
      "note": "gear behind the body"
    },
    {
      "name": "backColour",
      "type": "colour",
      "default": "#d2403f",
      "note": "backpack / cape colour (uses itemColour if not set)"
    },
    {
      "name": "belly",
      "type": "boolean",
      "default": false,
      "note": "rounded pregnant belly"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"q\": \"#ffffff\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
