{
  "id": "pixel-art/racetrack",
  "type": "background",
  "style": "pixel-art",
  "name": "Racetrack",
  "summary": "Pixel-art race circuit: track with red and white kerbs, checkered finish line, grandstand and flags.",
  "tags": [
    "racetrack",
    "race",
    "circuit",
    "racing",
    "finish line",
    "background",
    "pixel",
    "pixel art"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "day",
      "values": [
        "day",
        "dusk",
        "night"
      ],
      "note": "sky colours and light"
    },
    {
      "name": "groundY",
      "type": "number",
      "default": 1600,
      "note": "ground line; stand characters on it"
    },
    {
      "name": "seed",
      "type": "number",
      "default": 16,
      "note": "varies clouds, skyline and details"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "flags",
      "values": [
        "flags",
        "none"
      ],
      "note": "flags flutter and the crowd waves from p.f"
    }
  ],
  "example": {
    "time": "day"
  },
  "uses": [
    "pixel-art/backdrop"
  ],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
