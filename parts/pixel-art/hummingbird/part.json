{
  "id": "pixel-art/hummingbird",
  "type": "character",
  "style": "pixel-art",
  "name": "Hummingbird",
  "summary": "Pixel-art hummingbird: green body, small red throat patch, long thin beak and blurred fast wings; hovers by default.",
  "tags": [
    "hummingbird",
    "bird",
    "tiny bird",
    "flowers",
    "garden",
    "nectar",
    "pixel",
    "pixel art"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "perch / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "fly",
      "values": [
        "walk",
        "run",
        "fly",
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "walk/run swap foot cels; fly flaps the wings; others move the whole sprite"
    },
    {
      "name": "fps",
      "type": "number",
      "default": 8,
      "note": "video frames per cel"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift (pair with walk or fly)"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#3f9a5a",
      "note": "body colour (char a)"
    },
    {
      "name": "coat2",
      "type": "colour",
      "default": "#2e6b45",
      "note": "tail colour (char A)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#4a443c\"} for the wing"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1000,
    "s": 1.8,
    "anim": "fly",
    "fps": 3
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
