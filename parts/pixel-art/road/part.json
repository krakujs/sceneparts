{
  "id": "pixel-art/road",
  "type": "background",
  "style": "pixel-art",
  "name": "Road",
  "summary": "Pixel-art country road in perspective: dashed lane markings, grass verges, signs, trees and hills.",
  "tags": [
    "road",
    "street",
    "highway",
    "driving",
    "countryside",
    "background",
    "pixel",
    "pixel art"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "day",
      "values": [
        "day",
        "dusk",
        "night"
      ],
      "note": "sky colours and light"
    },
    {
      "name": "groundY",
      "type": "number",
      "default": 1600,
      "note": "ground line; stand characters on it"
    },
    {
      "name": "seed",
      "type": "number",
      "default": 15,
      "note": "varies clouds, skyline and details"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "scroll",
      "values": [
        "scroll",
        "none"
      ],
      "note": "lane markings and trees scroll towards the viewer from p.f"
    }
  ],
  "example": {
    "time": "day"
  },
  "uses": [
    "pixel-art/backdrop"
  ],
  "layer": "bg",
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
