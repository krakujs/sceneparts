{
  "id": "pixel-art/sd-card",
  "type": "prop",
  "style": "pixel-art",
  "name": "SD card",
  "summary": "Pixel-art SD memory card with a notched corner and gold contacts; for camera and photo scenes.",
  "tags": ["sd card","memory card","storage","camera","tech","pixel","pixel art","8-bit"],
  "params": [
    {"name":"x","type":"number","default":540,"note":"centre x; [from,to] to move"},
    {"name":"y","type":"number","default":1600,"note":"bottom of the item (centre when centre = true)"},
    {"name":"s","type":"number","default":1,"note":"scale; one cell = 24 px at s = 1"},
    {"name":"flip","type":"boolean","default":false,"note":"mirror horizontally"},
    {"name":"anim","type":"enum","default":"none","values":["none","bob","bounce","float","shake","pulse"],"note":"whole-sprite motion; float/bob suit pickups"},
    {"name":"centre","type":"boolean","default":false,"note":"anchor on the centre instead of the bottom"},
    {"name":"vx","type":"number","note":"px per frame drift"},
    {"name":"colour","type":"colour","default":"#4a5366","note":"main colour (char a), e.g. #d2403f for a red memory card"},
    {"name":"colour2","type":"colour","default":"#2b3140","note":"shade colour (char A)"},
    {"name":"pal","type":"object","note":"replace colours by char, e.g. {\"z\": \"#2e6b45\"}"},
    {"name":"px","type":"number","default":24,"note":"cell size"},
    {"name":"outline","type":"boolean","default":true,"note":"dark one-cell outline"}
  ],
  "example": {"x":540,"y":1000,"s":2,"anim":"float","centre":true},
  "uses": ["pixel-art/sprite"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
