{
  "id": "pixel-art/robot-arm",
  "type": "prop",
  "style": "pixel-art",
  "name": "Robot arm",
  "summary": "Pixel-art industrial robot arm: thick orange segments, round joints and an open gripper on a base; for factories.",
  "tags": [
    "robot arm",
    "robotic arm",
    "industrial robot",
    "factory",
    "automation",
    "machine",
    "manufacturing",
    "pixel art"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "bottom of the item (centre when centre = true)"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "mirror horizontally"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "whole-sprite motion; float/bob suit pickups"
    },
    {
      "name": "centre",
      "type": "boolean",
      "default": false,
      "note": "anchor on the centre instead of the bottom"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift"
    },
    {
      "name": "colour",
      "type": "colour",
      "default": "#f08a3c",
      "note": "arm colour (char a), e.g. #f7d154"
    },
    {
      "name": "colour2",
      "type": "colour",
      "default": "#c0662a",
      "note": "shade colour (char A)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#f7d154\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1300,
    "s": 2
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}