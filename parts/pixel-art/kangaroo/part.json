{
  "id": "pixel-art/kangaroo",
  "type": "character",
  "style": "pixel-art",
  "name": "Kangaroo",
  "summary": "Pixel-art kangaroo standing upright in side view: tan-brown with big hind feet; hops; for outback scenes.",
  "tags": [
    "kangaroo",
    "roo",
    "australian animal",
    "marsupial",
    "wild animal",
    "pixel",
    "pixel art"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "hop",
      "values": [
        "hop",
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "hop swaps two crouch/leap cels and bounces; others move the whole sprite"
    },
    {
      "name": "fps",
      "type": "number",
      "default": 6,
      "note": "video frames per cel"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift (pair with walk)"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#b07a48",
      "note": "tan-brown fur (char a)"
    },
    {
      "name": "coat2",
      "type": "colour",
      "default": "#6b4628",
      "note": "legs, feet and tail (char A)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#f5f1e8\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1.5,
    "anim": "hop"
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
