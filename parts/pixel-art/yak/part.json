{
  "id": "pixel-art/yak",
  "type": "character",
  "style": "pixel-art",
  "name": "Yak",
  "summary": "Pixel-art yak with shaggy skirt-like fur, curved horns and a low head; for highland and farm scenes.",
  "tags": [
    "yak",
    "bovine",
    "cow",
    "farm animal",
    "mountain animal",
    "pixel",
    "pixel art",
    "retro"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "walk",
      "values": [
        "walk",
        "run",
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "walk/run swap leg cels; others move the whole sprite"
    },
    {
      "name": "fps",
      "type": "number",
      "default": 8,
      "note": "video frames per walk cel"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift (pair with walk)"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#4a3426",
      "note": "main fur colour (char a)"
    },
    {
      "name": "coat2",
      "type": "colour",
      "default": "#2a1c14",
      "note": "fringe and ear colour (char A)"
    },
    {
      "name": "horn",
      "type": "colour",
      "default": "#e8dcc0",
      "note": "horn colour (char h)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#2f5fb8\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 1.2,
    "anim": "walk"
  },
  "uses": [
    "pixel-art/sprite"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
