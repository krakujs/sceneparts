{
  "id": "pixel-art/koala",
  "type": "character",
  "style": "pixel-art",
  "name": "Koala",
  "summary": "Pixel-art koala sitting upright in side view: grey, big fluffy round ears and a big dark nose.",
  "tags": [
    "koala",
    "australian animal",
    "marsupial",
    "wild animal",
    "pixel",
    "pixel art",
    "retro"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x; [from,to] to move"
    },
    {
      "name": "y",
      "type": "number",
      "default": 1600,
      "note": "feet / ground line"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; one cell = 24 px at s = 1"
    },
    {
      "name": "flip",
      "type": "boolean",
      "default": false,
      "note": "face left"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "none",
      "values": [
        "none",
        "bob",
        "bounce",
        "float",
        "shake",
        "pulse"
      ],
      "note": "others move the whole sprite"
    },
    {
      "name": "fps",
      "type": "number",
      "default": 8,
      "note": "video frames per cel"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame drift (pair with walk)"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#9aa0a8",
      "note": "grey fur (char a)"
    },
    {
      "name": "coat2",
      "type": "colour",
      "default": "#d5d8dc",
      "note": "inner ears and chest (char A)"
    },
    {
      "name": "pal",
      "type": "object",
      "note": "replace colours by char, e.g. {\"z\": \"#f5f1e8\"}"
    },
    {
      "name": "px",
      "type": "number",
      "default": 24,
      "note": "cell size"
    },
    {
      "name": "outline",
      "type": "boolean",
      "default": true,
      "note": "dark one-cell outline"
    }
  ],
  "example": {
    "x": 540,
    "y": 1600,
    "s": 2,
    "anim": "none"
  },
  "uses": [
    "pixel-art/sprite"
  ],
