{
  "id": "pixel-art/ship-deck",
  "type": "background",
  "style": "pixel-art",
  "name": "Ship deck",
  "summary": "Pixel-art sailing ship deck: wooden planks, mast, sails and rails with the sea beyond. For sea adventures.",
  "tags": [
    "ship",
    "deck",
    "sailing",
    "pirate",
    "sea",
    "background",
    "pixel",
    "pixel art"
  ],
  "params": [
    {
      "name": "time",
      "type": "enum",
      "default": "day",
      "values": [
        "day",
        "dusk",
        "night"
