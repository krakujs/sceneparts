      "note": "ground line; stand characters on it"
    },
    {
      "name": "seed",
      "type": "number",
      "default": 14,
      "note": "varies clouds, skyline and details"
    },
    {
      "name": "anim",
      "type": "enum",
      "default": "sail",
      "values": [
        "sail",
        "none"
      ],
      "note": "sails flutter and the sea waves from p.f"
    }
  ],
  "example": {
