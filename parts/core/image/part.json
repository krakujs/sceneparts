{
  "id": "core/image",
  "type": "prop",
  "style": "core",
  "name": "Image",
  "summary": "A raster image from the project (data URI or file path) placed in the scene.",
  "tags": [
    "photo",
    "picture",
    "raster"
  ],
  "params": [
    {
      "name": "src",
      "type": "string"
    },
    {
      "name": "x",
      "type": "number",
      "default": 140
    },
    {
      "name": "y",
      "type": "number",
      "default": 500
    },
    {
      "name": "w",
      "type": "number",
      "default": 800
    },
    {
      "name": "h",
      "type": "number",
      "default": 800
    },
    {
      "name": "r",
      "type": "number",
      "default": 0
    },
    {
      "name": "o",
      "type": "number",
      "default": 1
    },
    {
      "name": "fit",
      "type": "enum",
      "values": [
        "meet",
        "cover"
      ],
      "default": "meet"
    }
  ],
  "example": {
    "src": "",
    "x": 140,
    "y": 500
  },
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
