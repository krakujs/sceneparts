{
  "id": "core/level-up-badge",
  "type": "text",
  "style": "core",
  "name": "Level up badge",
  "summary": "Game-style LEVEL UP shield showing the new level, with rays behind it and twinkling sparkles.",
  "tags": ["level up", "game", "achievement", "shield", "rank up", "milestone", "sparkle"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; the shield is about 460 px wide at s = 1" },
    { "name": "title", "type": "string", "default": "LEVEL UP!", "note": "text above the shield" },
    { "name": "level", "type": "string", "default": "8", "note": "the new level number" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" }
  ],
  "example": { "title": "LEVEL UP!", "level": "8" },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
