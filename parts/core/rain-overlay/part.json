{
  "id": "core/rain-overlay",
  "type": "effect",
  "style": "core",
  "name": "Rain overlay",
  "summary": "Full-frame slanted rain in three depth layers with small splash ticks at the bottom, looping; for moody weather.",
  "tags": ["rain", "rainfall", "weather", "storm", "moody", "drizzle"],
  "params": [
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame inside the shot; overrides at" },
    { "name": "density", "type": "number", "default": 1, "note": "streak multiplier, 0 to 2" },
    { "name": "speed", "type": "number", "default": 1, "note": "fall speed multiplier" },
    { "name": "color", "type": "colour", "default": "#5F7FA0", "note": "rain colour" },
    { "name": "seed", "type": "string", "default": "rain", "note": "change for a different pattern" }
  ],
  "example": { "density": 1, "speed": 1 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
