{
  "id": "core/progress-bar",
  "type": "text",
  "style": "core",
  "name": "Progress bar",
  "summary": "Rounded pill progress bar that fills to a percentage, with a label above and the percentage at its right.",
  "tags": ["progress bar", "progress", "percentage", "loading", "completion", "bar", "goal", "statistic"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; card is 960×360 at s = 1" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "color", "type": "colour", "note": "fill colour; default the style's accent" },
    { "name": "value", "type": "number", "default": 68, "note": "0..100" },
    { "name": "label", "type": "string", "default": "Onboarding complete" }
  ],
  "example": { "value": 68, "label": "Onboarding complete" },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
