{
  "id": "core/number-counter",
  "type": "text",
  "style": "core",
  "name": "Number counter",
  "summary": "Big number that counts from a start value up to a final value, with thousands separators, prefix, suffix and caption.",
  "tags": ["counter", "number", "count up", "statistic", "kpi", "big number", "total", "infographic"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; card is 880×460 at s = 1" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "color", "type": "colour", "note": "accent bar colour; default the style's accent" },
    { "name": "value", "type": "number", "default": 12480, "note": "final number" },
    { "name": "from", "type": "number", "default": 0, "note": "number the count starts from" },
    { "name": "prefix", "type": "string", "default": "", "note": "e.g. $" },
    { "name": "suffix", "type": "string", "default": "", "note": "e.g. +" },
    { "name": "decimals", "type": "number", "default": 0 },
    { "name": "caption", "type": "string", "default": "visitors this week" }
  ],
  "example": { "value": 12480, "from": 0, "caption": "visitors this week" },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
