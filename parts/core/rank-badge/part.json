{
  "id": "core/rank-badge",
  "type": "text",
  "style": "core",
  "name": "Rank badge",
  "summary": "Gold, silver or bronze medal with a rank number such as #1 and simple laurel leaves; pops in.",
  "tags": ["rank", "medal", "award", "badge", "place", "winner", "laurel"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "rank", "type": "number", "default": 1, "min": 0, "max": 999, "note": "shown as #1, #2 ..." },
    { "name": "tier", "type": "enum", "values": ["gold", "silver", "bronze"], "default": "gold", "note": "medal metal" },
    { "name": "label", "type": "string", "default": "TOP", "note": "small line above the number" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" }
  ],
  "example": { "rank": 1, "tier": "gold", "label": "TOP" },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
