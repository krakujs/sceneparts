{
  "id": "core/timeline-horizontal",
  "type": "text",
  "style": "core",
  "name": "Timeline horizontal",
  "summary": "Horizontal timeline: a line draws left to right with dots, year labels above and short captions below.",
  "tags": ["timeline", "history", "years", "milestones", "horizontal", "chronology", "infographic"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "color", "type": "colour", "note": "accent override; dots use the style's series colours" },
    { "name": "years", "type": "string[]", "default": ["2019", "2021", "2023", "2025"], "note": "2 to 5 labels above the dots" },
    { "name": "captions", "type": "string[]", "default": ["Idea", "First launch", "Growth", "Global"], "note": "short captions below, one per year" }
  ],
  "example": {
    "years": ["2019", "2021", "2023", "2025"],
    "captions": ["Idea", "First launch", "Growth", "Global"]
  },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
