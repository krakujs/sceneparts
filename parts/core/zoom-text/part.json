{
  "id": "core/zoom-text",
  "type": "text",
  "style": "core",
  "name": "Zoom text",
  "summary": "Text that punches in from huge and transparent, slams to size and settles, for emphasis and reveal beats.",
  "tags": ["zoom", "punch in", "impact", "emphasis", "slam", "headline", "text"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame; overrides at when set" },
    { "name": "text", "type": "string", "default": "BOOM", "note": "the word that punches in" },
    { "name": "size", "type": "number", "default": 150, "note": "final font size; shrinks to fit 980 px" },
    { "name": "len", "type": "number", "default": 18, "note": "frames for the punch-in" },
    { "name": "color", "type": "colour", "note": "text colour; default style accent" }
  ],
  "example": { "text": "BOOM", "size": 170 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
