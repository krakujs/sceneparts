{
  "id": "core/step-process",
  "type": "text",
  "style": "core",
  "name": "Step process",
  "summary": "3-5 rounded step boxes joined by arrows that pop in order, each with its step number and label.",
  "tags": ["process", "steps", "flow", "stages", "arrows", "workflow", "infographic"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "color", "type": "colour", "note": "accent override for the arrows; step circles use the series colours" },
    { "name": "steps", "type": "string[]", "default": ["Plan", "Build", "Test", "Launch"], "note": "3 to 5 steps" }
  ],
  "example": {
    "steps": ["Plan", "Build", "Test", "Launch"]
  },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
