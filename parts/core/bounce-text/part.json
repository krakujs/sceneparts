{
  "id": "core/bounce-text",
  "type": "text",
  "style": "core",
  "name": "Bounce text",
  "summary": "Letters that drop in from above and bounce to rest one after another, for playful titles and kid-friendly captions.",
  "tags": ["bounce", "letters", "drop in", "playful", "title", "kids", "text"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame; overrides at when set" },
    { "name": "text", "type": "string", "default": "BOING!", "note": "the word to bounce" },
    { "name": "size", "type": "number", "default": 130, "note": "font size; shrinks to fit 980 px" },
    { "name": "stagger", "type": "number", "default": 3, "note": "frames between letters" },
    { "name": "color", "type": "colour", "note": "letter colour; default style accent" }
  ],
  "example": { "text": "BOING!", "size": 150 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
