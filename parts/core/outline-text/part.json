{
  "id": "core/outline-text",
  "type": "text",
  "style": "core",
  "name": "Outline text",
  "summary": "Hollow stroked letters that draw their outline on, then fill solid, for title cards and reveals.",
  "tags": ["outline", "stroke", "draw on", "hollow", "title", "reveal", "text"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame; overrides at when set" },
    { "name": "text", "type": "string", "default": "CHAPTER ONE", "note": "the words to outline" },
    { "name": "size", "type": "number", "default": 170, "note": "font size; shrinks to fit 980 px" },
    { "name": "draw", "type": "number", "default": 40, "note": "frames spent drawing the outline" },
    { "name": "color", "type": "colour", "note": "outline colour; default style accent" }
  ],
  "example": { "text": "CHAPTER ONE", "size": 180, "draw": 45 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
