{
  "id": "core/snow-globe-shake",
  "type": "effect",
  "style": "core",
  "name": "Snow globe shake",
  "summary": "Glass snow globe with a house and tree that wobbles while snow whirls, then settles; for cosy and festive beats.",
  "tags": ["snow", "globe", "shake", "winter", "settle", "glass"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 900, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "count", "type": "number", "default": 55, "note": "snowflakes, 10 to 120" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame inside the shot; overrides at" },
    { "name": "seed", "type": "string", "default": "globe", "note": "change for a different snowfall" }
  ],
  "example": { "x": 540, "y": 900, "count": 55 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
