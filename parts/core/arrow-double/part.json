{
  "id": "core/arrow-double",
  "type": "effect",
  "style": "core",
  "name": "Arrow double",
  "summary": "Two-headed arrow between two points for exchange or distance, with an optional label in the middle.",
  "tags": [
    "arrow",
    "double",
    "two-way",
    "exchange",
    "distance",
    "between",
    "label"
  ],
  "params": [
    {
      "name": "ax",
      "type": "number",
      "default": 240,
      "note": "start x"
    },
    {
      "name": "ay",
      "type": "number",
      "default": 960,
      "note": "start y"
    },
    {
      "name": "bx",
      "type": "number",
      "default": 840,
      "note": "end x"
    },
    {
      "name": "by",
      "type": "number",
      "default": 960,
      "note": "end y"
    },
    {
      "name": "at",
      "type": "number",
      "default": 0,
      "note": "start as a fraction of the shot (0..1)"
    },
    {
      "name": "color",
      "type": "colour",
      "note": "override the style accent"
    },
    {
      "name": "label",
      "type": "string",
      "default": "",
      "note": "optional text in a pill at the middle"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    }
  ],
  "example": {
    "ax": 240,
    "ay": 960,
    "bx": 840,
    "by": 960,
    "label": "10 km"
  },
  "layer": "screen",
  "uses": [
    "core/stat-card"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
