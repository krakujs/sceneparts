{
  "id": "core/like-counter",
  "type": "text",
  "style": "core",
  "name": "Like counter",
  "summary": "Heart icon with a number that counts up (1.2K style); the heart pops and small hearts burst out on start.",
  "tags": ["like", "likes", "heart", "counter", "reaction", "favourite", "count"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "value", "type": "number", "default": 1200, "note": "final count" },
    { "name": "from", "type": "number", "default": 0, "note": "count starts from" },
    { "name": "short", "type": "boolean", "default": true, "note": "1.2K / 3.4M" },
    { "name": "color", "type": "colour", "note": "heart colour; default the style's accent" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "len", "type": "number", "default": 34, "note": "count-up length in frames" }
  ],
  "example": { "value": 1200, "short": true },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
