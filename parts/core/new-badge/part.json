{
  "id": "core/new-badge",
  "type": "text",
  "style": "core",
  "name": "New badge",
  "summary": "Small pill NEW badge with a shine sweep that pops in; use it to flag new items, features or episodes.",
  "tags": ["new", "new badge", "tag", "pill", "label", "shine", "ribbon"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "text", "type": "string", "default": "NEW", "note": "short word in the pill" },
    { "name": "color", "type": "colour", "note": "pill colour; default the style's accent" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" }
  ],
  "example": { "text": "NEW" },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
