{
  "id": "core/countdown-timer",
  "type": "text",
  "style": "core",
  "name": "Countdown timer",
  "summary": "Big countdown in a ring that empties over the shot; the last 3 seconds turn red and pulse.",
  "tags": [
    "countdown",
    "timer",
    "clock",
    "seconds",
    "count down",
    "deadline",
    "ring"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "from",
      "type": "number",
      "default": 10,
      "note": "seconds to count down from"
    },
    {
      "name": "len",
      "type": "number",
      "note": "frames the countdown takes; default the whole shot"
    },
    {
      "name": "label",
      "type": "string",
      "default": "seconds",
      "note": "text under the number"
    },
    {
      "name": "at",
      "type": "number",
      "default": 0,
      "note": "start as a fraction of the shot (0..1)"
    },
    {
      "name": "color",
      "type": "colour",
      "note": "override the style accent"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "from": 10,
    "label": "seconds"
  },
  "layer": "screen",
  "uses": [
    "core/stat-card"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
