{
  "id": "core/clock-timer",
  "type": "text",
  "style": "core",
  "name": "Clock timer",
  "summary": "Round analogue clock or stopwatch face with ticks; the hand sweeps the given number of turns over the shot.",
  "tags": [
    "clock",
    "timer",
    "stopwatch",
    "time",
    "analogue",
    "hand",
    "countdown"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "r",
      "type": "number",
      "default": 230,
      "note": "face radius"
    },
    {
      "name": "turns",
      "type": "number",
      "default": 1,
      "note": "full sweeps of the hand over the shot"
    },
    {
      "name": "at",
      "type": "number",
      "default": 0,
      "note": "start as a fraction of the shot (0..1)"
    },
    {
      "name": "color",
      "type": "colour",
      "note": "override the style accent"
    }
  ],
  "example": {
    "x": 540,
    "y": 960,
    "r": 230,
    "turns": 1
  },
  "layer": "screen",
  "uses": [
    "core/stat-card"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
