{
  "id": "core/smoke-puff",
  "type": "effect",
  "style": "core",
  "name": "Smoke puff",
  "summary": "Cartoon cloud of grey puffs that swells out, drifts up and dissipates; for dust-ups, poofs and vanishing acts.",
  "tags": ["smoke", "puff", "cloud", "poof", "vanish", "cartoon"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "cloud centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "cloud centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "size", "type": "number", "default": 180, "note": "approximate cloud radius in px" },
    { "name": "count", "type": "number", "default": 9, "note": "puffs, 3 to 16" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame inside the shot; overrides at" },
    { "name": "seed", "type": "string", "default": "smoke", "note": "change for a different cloud" }
  ],
  "example": { "x": 540, "y": 900, "size": 200, "count": 9 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
