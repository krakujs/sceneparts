{
  "id": "core/flag-rectangle",
  "type": "text",
  "style": "core",
  "name": "Flag rectangle",
  "summary": "Generic waving flag on a pole with a choice of layouts and colours; never a real national flag by default.",
  "tags": [
    "flag",
    "waving",
    "stripes",
    "colours",
    "nation",
    "banner",
    "pole"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540,
      "note": "centre x"
    },
    {
      "name": "y",
      "type": "number",
      "default": 960,
      "note": "centre y"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale"
    },
    {
      "name": "layout",
      "type": "enum",
      "default": "h3",
      "values": [
        "h2",
        "h3",
        "v3",
        "cross",
        "circle",
        "plain"
      ],
      "note": "stripe layout"
    },
    {
      "name": "colors",
      "type": "string[]",
      "note": "hex colours; default accent, white, series 1"
    },
    {
      "name": "w",
      "type": "number",
      "default": 520,
      "note": "flag width"
    },
    {
      "name": "h",
      "type": "number",
      "default": 340,
      "note": "flag height"
    },
    {
      "name": "at",
      "type": "number",
      "default": 0,
      "note": "start as a fraction of the shot (0..1)"
    },
    {
      "name": "color",
      "type": "colour",
      "note": "override the style accent"
    }
  ],
  "example": {
    "layout": "h3",
    "colors": [
      "#2EAD6B",
      "#F2A93B",
      "#8A5AD0"
    ]
  },
  "layer": "screen",
  "uses": [
    "core/stat-card"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
