{
  "id": "core/bar-chart",
  "type": "text",
  "style": "core",
  "name": "Bar chart",
  "summary": "Vertical bar chart: bars grow up one after another with value labels and category names; for comparing a few values.",
  "tags": ["bar chart", "chart", "graph", "data", "comparison", "statistics", "infographic", "column chart"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; card is 940×1040 at s = 1" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "color", "type": "colour", "note": "bar colour; default the style's accent" },
    { "name": "title", "type": "string", "default": "Revenue by quarter" },
    { "name": "values", "type": "object", "default": [42, 68, 55, 91], "note": "array of numbers, one per bar" },
    { "name": "labels", "type": "string[]", "default": ["Q1", "Q2", "Q3", "Q4"], "note": "category name per bar" },
    { "name": "unit", "type": "string", "default": "k", "note": "suffix on the value labels, e.g. k or %" }
  ],
  "example": {
    "title": "Revenue by quarter",
    "values": [42, 68, 55, 91],
    "labels": ["Q1", "Q2", "Q3", "Q4"],
    "unit": "k"
  },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
