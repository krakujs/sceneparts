{
  "id": "core/area-chart",
  "type": "text",
  "style": "core",
  "name": "Area chart",
  "summary": "Line chart with a translucent filled area under the line that wipes in from the left; for trends and volume over time.",
  "tags": ["area chart", "trend", "graph", "chart", "volume", "time series", "statistics", "infographic"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; card is 940×1040 at s = 1" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "color", "type": "colour", "note": "line and fill colour; default the style's accent" },
    { "name": "title", "type": "string", "default": "Weekly active users" },
    { "name": "values", "type": "object", "default": [40, 55, 48, 70, 66, 88], "note": "array of numbers, one per point" },
    { "name": "labels", "type": "string[]", "default": ["W1", "W2", "W3", "W4", "W5", "W6"], "note": "x-axis name per point" },
    { "name": "unit", "type": "string", "default": "k", "note": "suffix on the last value label" }
  ],
  "example": {
    "title": "Weekly active users",
    "values": [40, 55, 48, 70, 66, 88],
    "labels": ["W1", "W2", "W3", "W4", "W5", "W6"],
    "unit": "k"
  },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
