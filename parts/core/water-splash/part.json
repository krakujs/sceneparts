{
  "id": "core/water-splash",
  "type": "effect",
  "style": "core",
  "name": "Water splash",
  "summary": "Crown splash of blue droplets arcing out under gravity with ripple rings; for falls, dives and splashes.",
  "tags": ["water", "splash", "droplets", "ripple", "splat", "liquid"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "splash point x" },
    { "name": "y", "type": "number", "default": 960, "note": "splash point y (water surface)" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "size", "type": "number", "default": 260, "note": "ripple radius in px" },
    { "name": "count", "type": "number", "default": 18, "note": "droplets, 4 to 40" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" },
    { "name": "atFrame", "type": "number", "note": "start frame inside the shot; overrides at" },
    { "name": "seed", "type": "string", "default": "splash", "note": "change for a different spray" },
    { "name": "color", "type": "colour", "note": "accent colour, not used by the water itself" }
  ],
  "example": { "x": 540, "y": 1000, "size": 280, "count": 18 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
