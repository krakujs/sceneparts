{
  "id": "core/xp-bar",
  "type": "text",
  "style": "core",
  "name": "XP bar",
  "summary": "Game experience bar with an LV chip at the left, a segmented fill to a 0..1 value and an XP count.",
  "tags": ["xp", "xp bar", "experience", "level", "progress", "game", "hud"],
  "params": [
    { "name": "x", "type": "number", "default": 540, "note": "centre x" },
    { "name": "y", "type": "number", "default": 960, "note": "centre y" },
    { "name": "s", "type": "number", "default": 1, "note": "scale" },
    { "name": "level", "type": "number", "default": 7, "note": "shown in the chip as LV 7" },
    { "name": "value", "type": "number", "default": 0.62, "min": 0, "max": 1, "note": "fill 0..1; animate with [from, to]" },
    { "name": "max", "type": "number", "default": 2000, "note": "XP needed for the next level" },
    { "name": "segments", "type": "number", "default": 10, "min": 1, "max": 30, "note": "visible divisions of the bar" },
    { "name": "color", "type": "colour", "note": "fill colour; default the style's accent" },
    { "name": "at", "type": "number", "default": 0, "note": "start as a fraction of the shot (0..1)" }
  ],
  "example": { "level": 7, "value": 0.62, "max": 2000 },
  "layer": "screen",
  "uses": ["core/stat-card"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
