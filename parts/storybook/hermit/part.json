{
  "id": "storybook/hermit",
  "type": "character",
  "style": "storybook",
  "name": "Hermit",
  "summary": "Very old hermit with a long white beard, ragged hooded robe, gnarled staff and small lantern, for wilderness scenes.",
  "tags": [
    "hermit",
    "old man",
    "beard",
    "robe",
    "staff",
    "lantern",
    "hermitage",
    "storybook",
    "character"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#6E5B45"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the staff"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
