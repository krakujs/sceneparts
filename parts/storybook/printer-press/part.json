{
  "id": "storybook/printer-press",
  "type": "character",
  "style": "storybook",
  "name": "Printer",
  "summary": "Printer in a newspaper hat and leather apron, ink-smudged, holding two leather ink balls for a letterpress.",
  "tags": [
    "printer",
    "letterpress",
    "ink",
    "print shop",
    "press",
    "job",
    "history",
    "newspaper"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "inking",
      "type": "boolean",
      "default": true,
      "note": "dabbing the ink balls"
    },
    {
      "name": "apron",
      "type": "colour",
      "default": "#6B4B2E",
      "note": "leather apron colour"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#F1CDAA"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
