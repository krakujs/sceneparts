{
  "id": "storybook/hatter",
  "type": "character",
  "style": "storybook",
  "name": "Hatter",
  "summary": "Hat maker in waistcoat and apron, holding a nearly finished top hat on a wooden hat block.",
  "tags": [
    "hatter",
    "hat maker",
    "milliner",
    "victorian",
    "waistcoat",
    "craft",
    "worker",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#6B4A2E",
      "note": "waistcoat colour"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#B5452F",
      "note": "colour of the hat being made"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#5C3A26"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
