{
  "id": "storybook/shoe-shiner",
  "type": "character",
  "style": "storybook",
  "name": "Shoe shiner",
  "summary": "Shoe shiner boy in a flat cap with a brush and a wooden shoe-shine box with foot rest; for street or old town scenes.",
  "tags": [
    "shoe shiner",
    "shoeshine",
    "boy",
    "street",
    "brush",
    "victorian",
    "job",
    "child"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "working",
      "type": "boolean",
      "default": true,
      "note": "brushing the shoe"
    },
    {
      "name": "jacket",
      "type": "colour",
      "default": "#4A4E5E",
      "note": "jacket colour"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#8D5A3B"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#2B2420"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
