{
  "id": "storybook/gladiator",
  "type": "character",
  "style": "storybook",
  "name": "Gladiator",
  "summary": "Roman gladiator in bronze crested helmet, arm guard, short sword, round shield, tunic and sandals.",
  "tags": [
    "gladiator",
    "roman",
    "rome",
    "arena",
    "helmet",
    "shield",
    "ancient",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#B5452F",
      "note": "tunic colour"
    },
    {
      "name": "metal",
      "type": "colour",
      "default": "#C08A3E",
      "note": "helmet and shield bronze"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
