{
  "id": "storybook/resurrection-man",
  "type": "character",
  "style": "storybook",
  "name": "Resurrection man",
  "summary": "1820s body snatcher in dark coat and flat cap with shovel, lantern and empty sack, for grave-robbing or night scenes.",
  "tags": [
    "resurrection man",
    "body snatcher",
    "victorian",
    "night",
    "history",
    "lantern",
    "storybook",
    "character"
  ],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1580, "note": "feet" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~640 px tall at 1" },
    { "name": "walk", "type": "boolean", "default": false, "note": "walk with the lantern carried" },
    { "name": "coat", "type": "colour", "default": "#2B2A33" },
    { "name": "hatColour", "type": "colour", "default": "#2B2420" },
    { "name": "skin", "type": "colour", "default": "#E8B990" },
    { "name": "hairColour", "type": "colour", "default": "#4A3324" },
    { "name": "flip", "type": "boolean", "note": "face left" },
    { "name": "vx", "type": "number", "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1580, "s": 1 },
  "uses": ["storybook/style", "storybook/townsfolk"],
