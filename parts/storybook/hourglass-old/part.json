{
  "id": "storybook/hourglass-old",
  "type": "prop",
  "style": "storybook",
  "name": "Old hourglass",
  "summary": "Wooden-framed glass hourglass with sand trickling from top to bottom. For time, waiting or patience scenes.",
  "tags": ["hourglass", "sand timer", "time", "wood", "patience", "waiting", "old", "storybook"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1500, "note": "bottom centre" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~520 px tall at 1" },
    { "name": "sand", "type": "colour", "default": "#F2B544", "note": "sand colour" },
    { "name": "wood", "type": "colour", "default": "#8A6A45", "note": "frame colour" },
    { "name": "flow", "type": "boolean", "default": true, "note": "sand stream falls" },
    { "name": "flip", "type": "boolean", "note": "mirror" }
  ],
  "example": { "x": 540, "y": 1500, "s": 1.1 },
  "uses": ["storybook/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
