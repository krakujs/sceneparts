{
  "id": "storybook/factory-girl",
  "type": "character",
  "style": "storybook",
  "name": "Factory girl",
  "summary": "Factory girl in mob cap, apron and long skirt carrying a basket of cotton bobbins, for mill or industrial scenes.",
  "tags": [
    "factory girl",
    "mill",
    "cotton",
    "bobbins",
    "mob cap",
    "industrial revolution",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#D9C49C"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#F0C9A0"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#6B4A2E"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the basket"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
