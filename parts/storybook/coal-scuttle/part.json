    { "name": "sparkle", "type": "boolean", "default": true, "note": "coal glints" },
    { "name": "metal", "type": "colour", "default": "#2C2F3B" },
    { "name": "flip", "type": "boolean", "note": "shovel to the left" }
  ],
  "example": { "x": 540, "y": 1500, "s": 1.1 },
