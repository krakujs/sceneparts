  "type": "prop",
  "style": "storybook",
  "name": "Coal scuttle",
  "summary": "Black metal coal scuttle full of coal with a shovel leaning on it; a hearth or cellar prop for cosy winter scenes.",
  "tags": ["coal", "coal scuttle", "scuttle", "fireplace", "winter", "victorian", "storybook"],
