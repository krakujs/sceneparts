{
  "id": "storybook/ice-cream-seller",
  "type": "character",
  "style": "storybook",
  "name": "Ice cream seller",
  "summary": "Ice cream seller in a striped apron and boater, pushing a small cart with a striped canopy; for seaside or fair scenes.",
  "tags": [
    "ice cream",
    "seller",
    "cart",
    "seaside",
    "summer",
    "vendor",
    "boater",
    "stall"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "stripe",
      "type": "colour",
      "default": "#B5452F",
      "note": "apron and canopy stripe colour"
    },
    {
      "name": "cart",
      "type": "boolean",
      "default": true,
      "note": "show the cart in front"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk while pushing"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
