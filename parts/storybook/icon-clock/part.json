{
  "id": "storybook/icon-clock",
  "type": "prop",
  "style": "storybook",
  "name": "Clock icon",
  "summary": "Flat storybook clock icon; same params as storybook/icon.",
  "tags": [
    "storybook",
    "vintage",
    "icon",
    "clock"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 900
    },
    {
      "name": "size",
      "type": "number",
      "default": 420
    },
    {
      "name": "r",
      "type": "number",
      "default": 0
    },
    {
      "name": "bob",
      "type": "boolean",
      "default": false
    }
  ],
  "example": {
    "size": 500
  },
  "uses": [
    "storybook/icon"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
