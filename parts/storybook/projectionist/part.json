    { "name": "walk", "type": "boolean", "default": false, "note": "walk with the reel carried" },
    { "name": "waistcoat", "type": "colour", "default": "#7E2E22" },
    { "name": "hatColour", "type": "colour", "default": "#2C2F3B" },
    { "name": "skin", "type": "colour", "default": "#E8B990" },
    { "name": "hairColour", "type": "colour", "default": "#2C2F3B" },
    { "name": "flip", "type": "boolean", "note": "face left" },
    { "name": "vx", "type": "number", "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1580, "s": 1 },
  "uses": ["storybook/style", "storybook/townsfolk"],
