  "name": "Projectionist",
  "summary": "Cinema projectionist in waistcoat and rolled sleeves, threading a film reel with the strip unspooling.",
  "tags": ["projectionist", "cinema", "film", "reel", "movie", "history", "1920s", "storybook"],
  "params": [
