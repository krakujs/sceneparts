{
  "id": "storybook/postman-bicycle",
  "type": "character",
  "style": "storybook",
  "name": "Postman with bicycle",
  "summary": "Postman in a peaked cap walking beside his upright bicycle with a basket of letters; for postal or delivery scenes.",
  "tags": [
    "postman",
    "postal",
    "bicycle",
    "letters",
    "mail",
    "delivery",
    "uniform",
    "bike"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "uniform",
      "type": "colour",
      "default": "#1E2A47",
      "note": "uniform colour"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": true,
      "note": "walk beside the bicycle, legs moving"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
