{
  "id": "storybook/newspaper-seller",
  "type": "character",
  "style": "storybook",
  "name": "Newspaper seller",
  "summary": "Newsboy in cap waving a folded paper overhead with a bundle under his arm, for street or city scenes.",
  "tags": [
    "newspaper",
    "newsboy",
    "newsie",
    "street seller",
    "1900s",
    "city",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#8A3A2A"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#8A6A45"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#2B2420"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk instead of waving"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
