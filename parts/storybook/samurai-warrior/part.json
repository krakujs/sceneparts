{
  "id": "storybook/samurai-warrior",
  "type": "character",
  "style": "storybook",
  "name": "Samurai warrior",
  "summary": "Samurai in generic lacquered plate armour and helmet with a crescent crest, sword sheathed at the hip.",
  "tags": [
    "samurai",
    "japan",
    "warrior",
    "armour",
    "feudal",
    "sword",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#1E2A47",
      "note": "lacquer colour"
    },
    {
      "name": "lacing",
      "type": "colour",
      "default": "#B5452F",
      "note": "lacing colour"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
