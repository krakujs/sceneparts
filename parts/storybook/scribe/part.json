{
  "id": "storybook/scribe",
  "type": "character",
  "style": "storybook",
  "name": "Scribe",
  "summary": "Ancient scribe in white kilt and headcloth with a reed pen and papyrus scroll, for Egyptian or record-keeping scenes.",
  "tags": [
    "scribe",
    "ancient egypt",
    "papyrus",
    "writing",
    "reed pen",
    "scroll",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the scroll"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
