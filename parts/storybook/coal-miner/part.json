{
  "id": "storybook/coal-miner",
  "type": "character",
  "style": "storybook",
  "name": "Coal miner",
  "summary": "Sooty coal miner in helmet with a small lamp, carrying a pick on the shoulder, for mining or industrial history scenes.",
  "tags": [
    "coal miner",
    "miner",
    "mining",
    "helmet lamp",
    "pick",
    "industrial",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#5A4536"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#3D3A44"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the pick on the shoulder"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
