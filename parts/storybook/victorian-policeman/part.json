{
  "id": "storybook/victorian-policeman",
  "type": "character",
  "style": "storybook",
  "name": "Victorian policeman",
  "summary": "Victorian policeman in custodian helmet and navy tunic with wooden truncheon and bullseye lantern on the belt.",
  "tags": [
    "policeman",
    "constable",
    "victorian",
    "custodian helmet",
    "uniform",
    "law",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#1E2A47"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#1E2A47"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the truncheon"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
