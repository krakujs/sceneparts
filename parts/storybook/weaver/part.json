{
  "id": "storybook/weaver",
  "type": "character",
  "style": "storybook",
  "name": "Weaver",
  "summary": "Weaver with a wooden shuttle in hand and a bolt of woven cloth under the other arm, for loom or textile scenes.",
  "tags": [
    "weaver",
    "weaving",
    "shuttle",
    "cloth",
    "textile",
    "loom",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#F2E6D0"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#F2B544"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#8D5A3B"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#2B2420"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk instead of working"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
