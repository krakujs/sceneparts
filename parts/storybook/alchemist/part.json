{
  "id": "storybook/alchemist",
  "type": "character",
  "style": "storybook",
  "name": "Alchemist",
  "summary": "Robed scholar in a pointed cap holding a bubbling flask with coloured fumes; for lab, potion or old-science scenes.",
  "tags": [
    "alchemist",
    "scientist",
    "wizard",
    "lab",
    "potion",
    "flask",
    "history",
    "fumes"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "fumes",
      "type": "boolean",
      "default": true,
      "note": "coloured vapour rising from the flask"
    },
    {
      "name": "robe",
      "type": "colour",
      "default": "#3B3F6E",
      "note": "robe colour"
    },
    {
      "name": "liquid",
      "type": "colour",
      "default": "#2E7D7A",
      "note": "liquid in the flask"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#C9C5BC"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
