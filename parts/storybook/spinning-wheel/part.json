{
  "id": "storybook/spinning-wheel",
  "type": "prop",
  "style": "storybook",
  "name": "Spinning wheel",
  "summary": "Wooden treadle spinning wheel with turning spokes and a distaff of wool; for cottage, weaving or village scenes.",
