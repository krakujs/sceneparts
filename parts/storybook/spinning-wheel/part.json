    { "name": "spinning", "type": "boolean", "default": true, "note": "wheel turns" },
    { "name": "wood", "type": "colour", "default": "#8A6A45" },
    { "name": "wool", "type": "colour", "default": "#F4EAD5" },
    { "name": "flip", "type": "boolean", "note": "mirror" }
  ],
  "example": { "x": 540, "y": 1500, "s": 1.1 },
