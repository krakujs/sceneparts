    { "name": "rolling", "type": "boolean", "default": true, "note": "wheels spin" },
    { "name": "frame", "type": "colour", "default": "#2E3F5C" },
    { "name": "flip", "type": "boolean", "note": "face left" }
  ],
  "example": { "x": 540, "y": 1450, "s": 1.2 },
