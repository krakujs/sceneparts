{
  "id": "storybook/embalmer",
  "type": "character",
  "style": "storybook",
  "name": "Embalmer",
  "summary": "Ancient Egyptian embalmer in white kilt and jackal mask, holding a clay jar.",
  "tags": [
    "embalmer",
    "ancient egypt",
    "egyptian",
    "jackal mask",
    "clay jar",
    "mummy",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#B07A4E"
    },
    {
      "name": "kilt",
      "type": "colour",
      "default": "#F4EAD5",
      "note": "kilt colour"
    },
    {
      "name": "jar",
      "type": "colour",
      "default": "#B5703E",
      "note": "clay jar colour"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
