{
  "id": "storybook/bathing-machine",
  "type": "prop",
  "style": "storybook",
  "name": "Bathing machine",
  "summary": "Striped Victorian bathing machine: a wooden beach hut on big wheels with steps to the sand. For seaside scenes.",
  "tags": ["bathing machine", "beach hut", "seaside", "victorian", "sea", "sand", "wheels", "storybook"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1500, "note": "bottom centre, on the sand" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~560 px tall at 1" },
    { "name": "stripe", "type": "colour", "default": "#F4EAD5", "note": "light stripe colour" },
    { "name": "accent", "type": "colour", "default": "#B5452F", "note": "dark stripe colour" },
    { "name": "roof", "type": "colour", "default": "#7E2E22", "note": "roof colour" },
    { "name": "wave", "type": "boolean", "default": true, "note": "animate the wave crests" },
    { "name": "flip", "type": "boolean", "note": "face left" }
  ],
  "example": { "x": 540, "y": 1500, "s": 1 },
  "uses": ["storybook/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
