{
  "id": "storybook/town-guard",
  "type": "character",
  "style": "storybook",
  "name": "Town guard",
  "summary": "Medieval watchman in a steel kettle helmet and tabard over mail, holding a halberd upright; for castle or town scenes.",
  "tags": [
    "guard",
    "watchman",
    "medieval",
    "soldier",
    "halberd",
    "castle",
    "knight",
    "town"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "tabard",
      "type": "colour",
      "default": "#B5452F",
      "note": "tabard colour over the mail"
    },
    {
      "name": "mail",
      "type": "colour",
      "default": "#8E98A2",
      "note": "mail colour"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
