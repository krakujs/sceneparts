  "style": "storybook",
  "name": "Switchboard operator",
  "summary": "Telephone switchboard operator in a headset and long skirt, plugging a cord into an exchange board.",
  "tags": ["switchboard", "operator", "telephone", "history", "1900s", "office", "woman", "storybook"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
