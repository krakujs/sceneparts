    { "name": "walk", "type": "boolean", "default": false, "note": "walk with the cord held out" },
    { "name": "blouse", "type": "colour", "default": "#F4EAD5" },
    { "name": "skirt", "type": "colour", "default": "#7E2E22" },
    { "name": "skin", "type": "colour", "default": "#E8B990" },
    { "name": "hairColour", "type": "colour", "default": "#7A4A2E" },
    { "name": "flip", "type": "boolean", "note": "face left" },
    { "name": "vx", "type": "number", "note": "px per frame" }
  ],
  "example": { "x": 540, "y": 1580, "s": 1 },
  "uses": ["storybook/style", "storybook/townsfolk"],
