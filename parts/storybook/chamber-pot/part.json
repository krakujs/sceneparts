    { "name": "rim", "type": "colour", "default": "#2E7D7A", "note": "rim and dot colour" },
    { "name": "flip", "type": "boolean", "note": "mirror" }
  ],
  "example": { "x": 540, "y": 1500, "s": 1.4 },
