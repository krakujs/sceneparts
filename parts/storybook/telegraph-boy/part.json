  "style": "storybook",
  "name": "Telegraph boy",
  "summary": "Young telegraph messenger in a pillbox cap and buttoned uniform, delivering a telegram with a satchel.",
  "tags": ["telegraph", "messenger", "telegram", "boy", "history", "victorian", "post", "storybook"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
