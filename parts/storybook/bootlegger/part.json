{
  "id": "storybook/bootlegger",
  "type": "character",
  "style": "storybook",
  "name": "Bootlegger",
  "summary": "1920s bootlegger in fedora and pinstripe suit carrying a wooden crate of unlabelled bottles.",
  "tags": [
    "bootlegger",
    "prohibition",
    "1920s",
    "gangster",
    "crate",
    "history",
    "storybook",
    "character"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#3B3F4E"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the crate carried"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
