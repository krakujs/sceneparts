{
  "id": "storybook/loom",
  "type": "prop",
  "style": "storybook",
  "name": "Loom",
  "summary": "Wooden hand loom with warp threads and striped cloth half woven, shuttle moving across; for weaving or mill scenes.",
  "tags": ["loom", "weaving", "cloth", "textile", "wooden", "craft", "storybook"],
  "params": [
    { "name": "x", "type": "number", "default": 540 },
    { "name": "y", "type": "number", "default": 1500, "note": "floor, bottom centre" },
    { "name": "s", "type": "number", "default": 1, "note": "scale; ~700 px wide, ~680 px tall at 1" },
    { "name": "weaving", "type": "boolean", "default": true, "note": "shuttle moves across" },
    { "name": "wood", "type": "colour", "default": "#8A6A45" },
    { "name": "flip", "type": "boolean", "note": "mirror" }
  ],
  "example": { "x": 540, "y": 1500, "s": 1 },
  "uses": ["storybook/style"],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
