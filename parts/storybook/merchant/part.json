{
  "id": "storybook/merchant",
  "type": "character",
  "style": "storybook",
  "name": "Merchant",
  "summary": "Fur-trimmed merchant in a top hat holding a small balance scale, with a coin purse; for trade, market or money scenes.",
  "tags": [
    "merchant",
    "trader",
    "market",
    "shopkeeper",
    "coins",
    "scales",
    "money",
    "history"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#7E2E22",
      "note": "rich coat colour"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#8D5A3B"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
