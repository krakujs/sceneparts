{
  "id": "storybook/privateer",
  "type": "character",
  "style": "storybook",
  "name": "Privateer",
  "summary": "Privateer in tricorn and gold-trimmed coat, cutlass raised, for seafaring or swashbuckling history scenes.",
  "tags": [
    "privateer",
    "tricorn",
    "cutlass",
    "sailor",
    "history",
    "swashbuckler",
    "storybook",
    "character"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#2E7D7A"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#2B2420"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#C98E64"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#2B2420"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "advance with the cutlass low"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
