{
  "id": "storybook/spinner",
  "type": "character",
  "style": "storybook",
  "name": "Spinner",
  "summary": "Woman spinning thread with a distaff under one arm and a drop spindle turning below, for weaving or village scenes.",
  "tags": [
    "spinner",
    "spinning",
    "distaff",
    "spindle",
    "thread",
    "textile",
    "history",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#8A6A45"
    },
    {
      "name": "hatColour",
      "type": "colour",
      "default": "#B5452F"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk while spinning"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
