{
  "id": "storybook/lamplighter",
  "type": "character",
  "style": "storybook",
  "name": "Lamplighter",
  "summary": "Victorian lamplighter in cap, coat and scarf raising a long pole with a small flame to light street lamps.",
  "tags": [
    "lamplighter",
    "victorian",
    "street lamp",
    "history",
    "job",
    "night",
    "worker",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the pole carried forward"
    },
    {
      "name": "lit",
      "type": "boolean",
      "default": true,
      "note": "flame on the pole tip"
    },
    {
      "name": "coat",
      "type": "colour",
      "default": "#2E3F5C"
    },
    {
      "name": "scarf",
      "type": "colour",
      "default": "#F2B544"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 480,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}