{
  "id": "storybook/fuller",
  "type": "character",
  "style": "storybook",
  "name": "Fuller",
  "summary": "Medieval cloth worker standing knee-deep in a wooden tub, treading cloth in place.",
  "tags": [
    "fuller",
    "medieval",
    "cloth",
    "wool",
    "tub",
    "worker",
    "trade",
    "storybook"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
