{
  "id": "storybook/paper-boy",
  "type": "character",
  "style": "storybook",
  "name": "Paper boy",
  "summary": "Newspaper boy in a flat cap and canvas satchel who throws a rolled paper; loops a throw for street scenes.",
  "tags": [
    "paper boy",
    "newsboy",
    "newspaper",
    "street",
    "throw",
    "child",
    "satchel",
    "history"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "throw",
      "type": "boolean",
      "default": true,
      "note": "throws a rolled paper in a loop"
    },
    {
      "name": "jacket",
      "type": "colour",
      "default": "#4A4E5E",
      "note": "jacket colour"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
