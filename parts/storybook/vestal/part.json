{
  "id": "storybook/vestal",
  "type": "character",
  "style": "storybook",
  "name": "Vestal priestess",
  "summary": "Roman vestal priestess in white robe and veil carrying a shallow bowl with a sacred flame.",
  "tags": [
    "vestal",
    "priestess",
    "roman",
    "temple",
    "flame",
    "ancient rome",
    "history",
    "storybook",
    "character"
  ],
  "params": [
    {
      "name": "x",
      "type": "number",
      "default": 540
    },
    {
      "name": "y",
      "type": "number",
      "default": 1580,
      "note": "feet"
    },
    {
      "name": "s",
      "type": "number",
      "default": 1,
      "note": "scale; ~640 px tall at 1"
    },
    {
      "name": "skin",
      "type": "colour",
      "default": "#E8B990"
    },
    {
      "name": "hairColour",
      "type": "colour",
      "default": "#4A3324"
    },
    {
      "name": "walk",
      "type": "boolean",
      "default": false,
      "note": "walk with the bowl"
    },
    {
      "name": "flip",
      "type": "boolean",
      "note": "face left"
    },
    {
      "name": "vx",
      "type": "number",
      "note": "px per frame"
    }
  ],
  "example": {
    "x": 540,
    "y": 1580,
    "s": 1
  },
  "uses": [
    "storybook/style",
    "storybook/townsfolk"
  ],
  "author": "krakujs",
  "license": "MIT",
  "origin": "original",
  "version": "1.0.0"
}
